@article{Quintella2019,
   abstract = {Foi realizado um estudo de prospecção tecnológica do uso da tecnologia de aprendizagem de máquina aplicada a negociação e investimento financeiro. Foi identificado um pico de registros em 2016 que se mantêm até o presente. As principais aplicações foram orientadas a identificação de outliers e a realização de feature selection e clustering. Nenhuma empresa foi identificada que tenha como atividade-fim atuar no mercado financeiro, indicando a existência de estratégias de manutenção de segredo de negócio. A China e os EUA se mostraram como maiores produtores e consumidores da tecnologia. Foi verificado o rápido crescimento do mercado e a possibilidade de amadurecimento da tecnologia diante do cenário de rápido desenvolvimento de ferramentas de alto processamento e de manutenção de extensas bases de dados.},
   author = {Vitor M Quintella and Cristina M Quintella and Antônio Francisco A Silva Junior and Cristiano de Oliveira Hora Fontes},
   doi = {10.9771/cp.v12i1.27260},
   issn = {2317-0026},
   issue = {1},
   journal = {Cadernos de Prospecção},
   keywords = {Aprendizagem de máquina,Investimento,Mercado financeiro,Negociação.},
   month = {5},
   pages = {113},
   title = {ESTUDO PROSPECTIVO EXPLORATÓRIO DAS PATENTES DE MÉTODOS DE APRENDIZAGEM DE MÁQUINA APLICADOS AO MERCADO FINANCEIRO},
   volume = {12},
   url = {https://portalseer.ufba.br/index.php/nit/article/view/27260 https://portalseer.ufba.br/index.php/nit/article/download/27260/16966},
   year = {2019}
}
