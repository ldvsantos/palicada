@article{Bleil1998,
   abstract = {The object of this paper is to verify if Brazil, like industrialized countries, shows the trend of adopting new food habits, introduced by the food industry, with an increase of artificial products to the detriment of the regional traditional ones. The research shows that beans, cassava flour, rice and maiz flour, the most traditional foods in the Brazilian diet, have had its consumption reduced. The new foods brought by the industry have conquered more and more people, mostly in large cities where fast-food is always a reality for millions of Brazilians. This is due to the modern mentality which gives preference to unlimited consumption and to the idea of supremacy of technical and scientific knowledge. We can conclude that cultural identity in Brazil has facilitated the entrance of these new products.},
   author = {Susana Inez Bleil},
   pages = {25},
   title = {O Padrão Alimentar Ocidental: Considerações sobre a mudança de hábitos no Brasil1},
   url = {https://d1wqtxts1xzle7.cloudfront.net/30924476/AVIdiscednu090804095840.pdf?1363086544=&response-content-disposition=inline%3B+filename%3DO_padrao_alimentar_ocidental_consideraco.pdf&Expires=1602802586&Signature=F7fQeV4HhcJqMoSIRqY7phf4mXEiFI7nBwoapter1geF},
   year = {1998}
}
