   year = {2011}
}
@misc{Zheng2020,
   abstract = {The utility model discloses a novel double-protection device for an outdoor fire hydrant. The fire hydrant comprises a fire hydrant body, the upper end of the fire hydrant body is connected with an upper cover through fixing bolts, a partition strip is fixedly installed on the inner side face of the upper cover, a warning lamp is fixedly installed on the outer side face of the partition strip, a groove and a convex groove are sequentially formed in the outer side face of the fire hydrant body from top to bottom, and a first supporting plate is fixedly installed at the upper end of the inner side face of the convex groove. A first clamping groove is formed in the middle of the inner side face of the first supporting plate, a second clamping groove is formed in the upper end face of the first supporting plate, a second supporting plate is inserted into the middle of the first supporting plate, a sliding block is fixedly installed in the middle of the outer side face of the second supporting plate, and a fixing rod is fixedly inserted into the middle of the second supporting plate. The novel outdoor fire hydrant double-protection device not only can prompt the position of a pedestrianfire hydrant, but also can reduce the waste of water resources after the fire hydrant is broken under special conditions.},
   author = {Chanchan Zheng},
   isbn = {CN208899580 (U)},
   month = {3},
   note = {<b>Classifications<br/></b><br/><br/><b>IPC<br/></b><br/>E03B9/02<br/><b>CPC<br/></b><br/><br/><br/>Library Catalog: ESpacenet},
   publisher = {Beijing Yta Equipment Installation Co Ltd},
   title = {The invention discloses a novel outdoor fire hydrant double-protection device},
   url = {https://worldwide.espacenet.com/publicationDetails/biblio?FT=D&date=20190524&DB=EPODOC&locale=en_EP&CC=CN&NR=208899580U&KC=U&ND=4 https://worldwide.espacenet.com/publicationDetails/biblio?DB=EPODOC&II=0&ND=3&adjacent=true&locale=en_EP&FT=D&date=20190524&C},
