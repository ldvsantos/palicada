@article{Wenczenovicz2017,
   abstract = {<p>La Constitución de la República Federal del Brasil de 1988 y el Decreto 505 de 2004, que ratifica la Convención 169 de la Organización Internacional del Trabajo en Brasil, garantía de los pueblos indígenas la posición exclusiva de sus territorios y el respeto de su organización social, costumbres, lenguaje, creencias y tradiciones, consolidando el Estado Democrático y Pluriétnico de Derecho. El estudio analiza a las comunidades indígenas en Brasil y la trayectoria histórica de la legislación territorial y las demarcaciones de las tierras de los pueblos originarios.</p>},
