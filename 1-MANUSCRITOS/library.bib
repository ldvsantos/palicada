@article{Desilva2011,
   abstract = {The Equus Beds Aquifer is the lifeline for hundreds of thousands of south central Kansas residents. Wichita's access to such a high-quality water source puts the city in a favorable position when compared with many other municipalities. However, with such opportunity comes an enormous responsibility. When it became obvious that the aquifer was being depleted and threatened, the city took action. The city's forward thinking, its commitment to a long-range water supply plan, and its willingness to take advantage of the latest engineering innovations have resulted in a program that will ensure the health and safety of the aquifer for generations to come. Wichita's ASR project is very close to becoming a fully operational reality. After surmounting a variety of challenges ranging from financial to political to logistical, it will soon flip the switch on a project that will rejuvenate and improve the sustainability of the aquifer. Wichita is committed to retaining and protecting its enviable water resource. © 2011 American Water Works Association.},
   author = {V Desilva and D Ary},
   issn = {0003150X (ISSN)},
   issue = {5},
   journal = {Journal - American Water Works Association},
   keywords = {Aquifer storage and recovery,Aquifers,Engineering innovations,Equus,Fully operational,Groundwater resources,Health and safety,High quality water,Innovation,Switch-on,Water supply},
   note = {CODEN: JAWWA<br/><br/><br/><br/>Correspondence Address: Desilva, V.; Professional Engineering Consultants, 303 S. Topeka St., Wichita, KS 67202, United States; email: viraj.desilva@pec1.com<br/><br/><br/><br/>Export Date: 19 March 2020<br/><br/><br/><br/>References: Boese, T., (2010) Personal Communication; <br/>Burns, McDonnell, (2000) Aquifer Storage and Recovery Concept Design Study, , City of Wichita, Kan;<br/>Burns, McDonnell, (1993) Integrated Local Water Supply Plan, , City of Wichita, Kan;<br/>(2010) Aquifer Storage &amp; Recovery Program Review, 138765, , HDR Engineering City of Wichita, Kan;<br/>(2010) Equus Beds Groundwater Recharge Project, , USGS (US Geological Survey) ks.water.usgs.gov/studies/equus/(accessed Oct., 29, 2010)},
   pages = {94-99},
   title = {Aquifer storage and recovery program remedies Wichita's groundwater problems},
   volume = {103},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84865609019&partnerID=40&md5=46ac24d57170906b7a43d80c9d149316},
   year = {2011}
}
@article{Xing2020,
   abstract = {Alfalfa is a perennial legume with high forage yield and quality that plays an important role in eco-environment improvement and cropping rotations. However, land salinization seriously inhibits the normal growth and development of alfalfa. Arbuscular mycorrhizal fungi (AMF) and rhizobia (R) are common symbiotic soil microorganisms. They can coexist with legumes such as alfalfa, and form a symbiotic system comprising AMF-alfalfa-R. In this study, we inoculated alfalfa with Glomus mosseae and Sinorhizobium meliloti, and compared the alkali resistance of plants with inoculum combinations. It was found that without alkali stress, the growth of G. mosseae-inoculated plants or R-inoculated plants was higher than that of non-inoculated (NI) ones. Important differences included higher chlorophyll content, relatively longer root length, higher plant height, and increased branch number. With alkali stress treatment, the growth of each group was inhibited in different ways, but the inoculated groups again showed higher alkali tolerance than NI. Compared with NI, the malondialdehyde content and relative conductivity remained at a low level in the NI group. The relative water content of the cells was higher, as were the activities of superoxide dismutase, peroxidase and catalase. Based on these results, single inoculation and mixed inoculation can both improve the osmotic adjustment ability and antioxidant capacity of alfalfa, and reduce damage to the cell membrane, but the results of mixed inoculation is even better. © 2020, Editorial Office of Acta Prataculturae Sinica. All rights reserved.},
   author = {Y.-M. Xing and L Dong and L.-F. Zhan and H Cai and S.-Q. Yang and N Sun},
   doi = {10.11686/cyxb2019509},
   issn = {10045759 (ISSN)},
   issue = {9},
   journal = {Acta Prataculturae Sinica},
