@article{Farani2019,
   abstract = {The main purpose of this research was to investigate those factors influencing the entrepreneurial behaviour of agriculture students who were members of entrepreneurship learning and training groups in virtual left-to-right markcommunication networks. In doing this, a conceptual model was developed to examine the effects of characteristics of entrepreneurship virtual social networks and the degree of participation in these networks through entrepreneurial thinking and decision on entrepreneurial behaviour. The study population of left-to-right markthis descriptive-correlational research was made up of 180 members of virtual social groups exchanging knowledge of entrepreneurship in left-to-right markWhatsApp and Viber networks. A total of 126 usable questionnaires were collected. Results indicated that participation in virtual social networks left-to-right markhad both direct and indirect effects - through left-to-right markentrepreneurial thinking and decisions - on entrepreneurial behaviour. left-to-right markHowever, characteristics of left-to-right markleft-to-right markentrepreneurship left-to-right markvirtual networks had only indirect effect on entrepreneurial left-to-right markbehaviour left-to-right markvia entrepreneurial thinking. The study highlights certain implications for policymakers, (potential) entrepreneurs, entrepreneurship support organizations, researchers and underlines the potential of virtual social networking for promoting entrepreneurship. NR - 68 PU - ROUTLEDGE JOURNALS, TAYLOR & FRANCIS LTD PI - ABINGDON PA - 2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
   author = {A Y Farani and S Karimi and N Izadi and P Ataei},
   doi = {10.1080/00036846.2018.1543940},
   issn = {0003-6846},
   issue = {21},
   journal = {Applied economics},
   keywords = {BUSINESS PERFORMANCE,Entrepreneurship,TIES,USERS,agriculture students,entrepreneurial behavior,entrepreneurial thinking,virtual social networks},
   pages = {2326-2335},
   title = {Effect of virtual social networks on entrepreneurial behaviour of agriculture students in Iran},
   volume = {51},
   year = {2019}
}
