@book{Hsiao2014,
   abstract = {This book provides a comprehensive, coherent, and intuitive review of panel data methodologies that are useful for empirical analysis. Substantially revised from the second edition, it includes two new chapters on modeling cross-sectionally dependent data and dynamic systems of equations. Some of the more complicated concepts have been further streamlined. Other new material includes correlated random coefficient models, pseudo-panels, duration and count data models, quantile analysis, and alternative approaches for controlling the impact of unobserved heterogeneity in nonlinear panel data models.},
   author = {Cheng Hsiao},
   isbn = {978-1-107-03869-1},
   keywords = {Business & Economics / Econometrics,Business & Economics / Economics / General,Business & Economics / Statistics,Computers / Computer Science},
   pages = {563},
   publisher = {Cambridge University Press},
   title = {Analysis of Panel Data},
   url = {https://books.google.com.br/books?id=7LIkBQAAQBAJ},
   year = {2014}
}
@article{,
   abstract = {Eskom has indicated its commitment to improving the way in which South Africa's water resources are managed. Eskom Holdings SOC Limited is a large consumer of fresh water, accounting for approximately 2-3% of the country's total water consumption annually. Eskom power stations run constantly, supplying in excess of 95% of South Africa's electrical energy and more than half of the electricity used on the African continent. Eskom has achieved significant water saving objectives through the implementation of various projects over the past two decades. One major innovation has been dry cooling. Eskom also sets water-use targets in terms of liters of water used per unit of electricity produced for each power station every year. The water targets are linked to the Eskom Sustainability Index. All power stations have water use performance targets that are set and monitored on a monthly basis and reviewed each year.},
   issn = {02582244 (ISSN)},
   issue = {1},
   journal = {Water Wheel},
   keywords = {Electrical energy,Large consumers,Performance targets,Power plants,Power station,South Africa,Sustainability index,Water - savings,Water conservation,Water consumption,Water resources,Water supply,electricity generation,electricity industry,electricity supply,energy policy,implementation process,public sector,utility sector,water industry,water resource,water supply,water use},
