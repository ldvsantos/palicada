@article{Ried2014,
   abstract = {Symbiosis Receptor-like Kinase (SYMRK) is indispensable for the development of phosphate-acquiring arbuscular mycorrhiza (AM) as well as nitrogen-fixing root nodule symbiosis, but the mechanisms that discriminate between the two distinct symbiotic developmental fates have been enigmatic. In this study, we show that upon ectopic expression, the receptor-like kinase genes Nod Factor Receptor 1 (NFR1), NFR5, and SYMRK initiate spontaneous nodule organogenesis and nodulation-related gene expression in the absence of rhizobia. Furthermore, overexpressed NFR1 or NFR5 associated with endogenous SYMRK in roots of the legume Lotus japonicus. Epistasis tests revealed that the dominant active SYMRK allele initiates signalling independently of either the NFR1 or NFR5 gene and upstream of a set of genes required for the generation or decoding of calciumspiking in both symbioses. Only SYMRK but not NFR overexpression triggered the expression of AM-related genes, indicating that the receptors play a key role in the decision between AM- or root nodule symbiosis-development. © Copyright Ried et al.},
   author = {M K Ried and M Antolín-Llovera and M Parniske},
   doi = {10.7554/eLife.03891},
   issn = {2050084X (ISSN)},
   issue = {November},
   journal = {eLife},
   keywords = {Agrobacterium tumefaciens,Article,Epistasis, Genetic,Gene Expression Regulation, Plant,Genes, Plant,Lotus,Lotus corniculatus var. japonicus,Lotus japonicus,Mycorrhizae,Nicotiana benthamiana,Phosphotransferases,Plant Proteins,Plant Root Nodulation,Plant Roots,RNA extraction,Receptors, Cell Surface,Root Nodules, Plant,Signal Transduction,Symbiosis,Western blotting,cell surface receptor,controlled study,enzymology,epistasis,gene construct,gene expression,gene expression regulation,genetic transformation,genetics,hairy root transformation,immunoprecipitation,metabolism,microbiology,mycorrhiza,nod factor receptor 1,nod factor receptor 5,nodulation,nonhuman,organogenesis,phosphotransferase,physiology,plant gene,plant growth,plant leaf,plant protein,plant root,protein expression,protein kinase,receptor like kinase,reverse transcription polymerase chain reaction,signal transduction,symbiosis,symbiosis receptor like kinase,unclassified drug},
