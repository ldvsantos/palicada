@article{Zhou2016,
   abstract = {As relações inters organizacionais, vistas como uma forma de laços sociais, têm sido examinadas como uma fonte fundamental de inovação firme. Enquanto os estudiosos destacam a importância dos laços sociais, muito menos se sabe sobre as relações entre diferentes tipos de vínculos. Neste estudo, examinamos primeiro os efeitos individuais de três tipos de laços sociais sobre o desempenho firme da inovação: os laços políticos, empresariais e universitários. Em seguida, analisamos os efeitos conjuntos desses laços. Argumentamos que, enquanto os laços políticos fortalecem os efeitos positivos dos laços empresariais e universitários sobre a inovação, os dois últimos tipos de laços substituem-se um ao outro na promoção da inovação. Encontramos evidências empíricas para esses argumentos em uma amostra recente de empresas chinesas.},
   author = {Jianghua Zhou and Rui Wu},
   doi = {10.5465/ambpp.2016.16704abstract},
   issn = {0065-0668},
   issue = {1},
   journal = {Academy of Management Proceedings},
   month = {12},
   pages = {16704},
   title = {More Ties the Merrier? Different Types of Social Ties and Firm Innovation Performance in China},
   volume = {2016},
   url = {https://journals.aom.org/doi/abs/10.5465/ambpp.2016.16704abstract},
   year = {2016}
}
