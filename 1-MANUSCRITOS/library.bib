   journal = {Handbook of Sustainable Luxury Textiles and Fashion},
   keywords = {Bespoke tailoring,Competition,Competitiveness,Network resource,Slow fashion movement,Sustainable development,Sustainable luxury},
   note = {cited By 2},
   pages = {137-161},
   publisher = {Springer Singapore},
   title = {The sustainable luxury craft of bespoke tailoring and its' enduring competitive advantage},
   volume = {2},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84956491716&doi=10.1007%2F978-981-287-742-0_8&partnerID=40&md5=b32bac060292f313815e205dc50d1cc3 https://www.scopus.com/inward/record.uri?eid=2-s2.0-85075860297&doi=10.1007%2F978-981-287-742-0_8&partnerID},
