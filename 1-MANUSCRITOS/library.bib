   keywords = {Pakistan,banking; corporate social responsibility; marketin},
   note = {cited By 3},
   publisher = {MDPI AG},
   title = {Sustainable businesses speak to the heart of consumers: Looking at sustainability with a marketing lens to reap banking consumers’ loyalty},
   volume = {13},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85104016897&doi=10.3390%2Fsu13073828&partnerID=40&md5=47ce2ef45e747c2273705b7848ac86cf},
   year = {2021}
}
@article{Shao20172592,
   abstract = {Technology brings a significant power in buildng development. While it is true that we often place more emphasis on technology in design but ignore the negative environmental problems it produces, innovative design can reduce th~sad verse impact. Therefore, th~sst udy studies the innovative application of eco-technology in archtectural design. This study utilized qualitative methods and dfferent cases were represented as models classifying ecological technology. Referring to Brand pointed out the 6S's of archtectural elements as a criterion, we attempted to identify elements affected by technological innovation and their relationship with geographcal region through comparative analysis. Results indcated that the elements of service equipment structure and skin are more likely to affect technological innovation and that technological innovation is limited by regional development. Essentially, developed countries actively employ ecological hgh technology and passive technology while developing countries prefer the latter. Finally, we administered questionnaires to verify the results obtained in the theoretical analysis. In future studes, we aim to concentrate on contextual innovation. © Medwell Journals, 2017.},
