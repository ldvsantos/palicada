@article{Opata2018,
   abstract = {This paper identified socioeconomic factors affecting their revenue from
crop production. It is based on farm level data collected in South East
Nigeria from 400 randomly selected farm units with women farmers.
Results of the analysis show that household socioeconomic factors that
increased their revenue were occupation, farm experience and household
size. Participation in planting and harvesting also increased their
revenue. Also, the societal constraint militating against women's
revenue were lack of finance, lack of improved inputs, lack of storage
facilities, lack of credit access, land tenure problem, poor road
network. These observations underscored the need for special programmes
that empower and recognize women especially through education, finance
and information.},
   author = {Patience Opata I and Adaku B Ezeibe and P I Opata and Adaku B Ezeibe},
   city = {AGRICULTURAL \& RURAL MANAGEMENT TRAINING INST, PMB 1343 ILORIN, KWARA STATE, 00000, NIGERIA},
   doi = {10.4314/jae.v22i3.15},
   issn = {1119-944X},
   issue = {3},
   journal = {JOURNAL OF AGRICULTURAL EXTENSION},
   keywords = {AGRICULTURE,South East Nigeria,Women,crop-production,resources,revenue,socio-economic},
   pages = {149-160},
   publisher = {AGRICULTURAL EXTENSION SOC NIGERIA},
   title = {Revenue Drivers of Women Labour in Crop Production in South East Nigeria},
   volume = {22},
   year = {2018}
}
@inbook{Sorgavi2015,
   abstract = {The pomegranate is one of the important fruit crops in India and Karnataka is one of the major producers of pomegranate. India's contribution to the export of pomegranate is less than 5% in the international market although its position is first in production. This is mainly due to the weak linkages between farmers and various sectors in technical, supply and market chains. In order to harness the existing scope and potential, the elite pomegranate growers in Bagalkot region of the state were organized into the "Sufal Pomegranate Growers Association" in 2009 with the guidance and support of Agri Business and Export Knowledge Centre of University of Agricultural Sciences, Dharwad (Karnataka, India). The association aims at facilitating timely procurement and supply of quality inputs, technical guidance to the farmers, and field level advice during the crop period and linking the farmers with various local and export market sectors with the help of the centre. Technical seminars and workshops are organized for building the capacities of the member farmers and skill enhancement for the new enterprising farmers and the upcoming entrepreneurs. The association along with the center organizes farmers-buyers dialogues by inviting exporters and establishing healthy competition among the market sectors. The competition among the export firms coupled with good quality fruits meeting the export standards has led to increase in the price level initially from 95 per kg of fruits to 175 per kg and thus has helped the farmers to realize better income. With the technical support and guidance of the university the association has taken initiation in establishing a pomegranate aril extraction and juice manufacturing unit along with cold chain facilities under the Government of Karnataka funding to the tune of 115 million. The Agri Business & Export Knowledge Centre and the University of Horticultural Sciences, Bagalkot are making all efforts to enhance skills of farmers of the association by extending thematic and technical backstopping support apart from linking farmers with latest technologies and extension approaches for the production of high quality produce. Marketing and export opportunities are facilitated through information sharing and linkage support initiatives. NR  - 7 PU  - INT SOC HORTICULTURAL SCIENCE PI  - LEUVEN 1 PA  - PO BOX 500, 3001 LEUVEN 1, BELGIUM},
   author = {C R Sorgavi and S B Hosamani and A S Alur},
   city = {Sufal Pomegranate Growers Association, Bagalkot, Karnataka, India},
   doi = {10.17660/ActaHortic.2015.1089.29},
   editor = {Wang D. and Yuan Z. and Wilkins E.},
   isbn = {05677572 (ISSN); 9789462610835 (ISBN)},
   booktitle = {Acta Horticulturae},
   keywords = {Bargaining power,Lythraceae,Market,Pomegranate,Sufal Growers Association,bargaining power,market,pomegranate},
   note = {<b>From Duplicate 1 (<i>An innovative institutional approach for technological and market interventions for the welfare of farmers - A case of sufal pomegranate growers association in India</i> - Sorgavi, C R; Hosamani, S B; Alur, A S)<br/></b><br/>Cited By :1<br/><br/>Export Date: 10 July 2021<br/><br/>References: (2001) Enabling the Rural Poor to Overcome Their Poverty. Strategic Framework for IFAD 2002-2006, , Rome: IFAD; <br/>(2001) Rural Poverty Report, , http://www.ifad.org/SF/strategy.htm, Oxford: Oxford University Press, 2002. Regional strategy papers [five papers-one for each regional division]. Rome: IFAD;<br/>(2002) Market Access for Developing Country Exports: Selected Issues, , http://www.worldbank.org/annualmeetings/mktaccess.pdf, Washington, D.C.: IMF/World Bank;<br/>Lankes, H.P., Market access for developing countries (2002) Finance and Development, 39 (3);<br/>Mazoyer, M., (2001) Protecting Small Farmers and the Rural Poor in the Context of Globalization, , Rome: Food and Agriculture Organization of the United Nations (FAO);<br/>Stiglitz, J., (2002) Globalization and Its Discontents, , London: Allen Lane and the Penguin Press;<br/>(2002) Global Economic Prospects and the Developing Countries, , World Bank Washington, D.C.: World Bank},
   pages = {237-242},
