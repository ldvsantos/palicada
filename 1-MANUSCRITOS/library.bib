@article{,
   abstract = {Water harvesting and conservation has gained increasing priority in rural development and agricultural initiatives over the last ten years in South Africa. The Water Research Commission (WRC) is developing an active role in developing the science of WH&C by targeting research grants to modernize, localize and quantify methods and their benefits. The value of water harvesting approaches is that they offer relatively low-cost interventions that can be implemented in stages as resources allow. The Facilitation Manual is based on contemporary participative research and extension thinking, consolidated in the 'Participatory Technology and Innovative Development' approach. The black-and-white line drawings can readily be photocopied and left with farmers and villagers as reference materials to aid their implementation and experimentation with whatever methods are suitable to their context.},
   issn = {02582244 (ISSN)},
   issue = {2},
   journal = {Water Wheel},
   keywords = {Capacity building,Harvesting,Innovation,Photocopying,Reference material,Regional planning,Research,Research grants,Runoff,Rural areas,Rural development,Short course,South Africa,Water conservation,Water harvesting,Water research commissions,Water resources,Water supply,White lines,agricultural application,capacity building,farmers knowledge,irrigation,participatory approach,rural area,technology adoption,water management,water resource},
   note = {Export Date: 19 March 2020},
   pages = {38-39},
   title = {Capacity building: WRC water harvesting short course materials get the nod},
   volume = {10},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-79952692127&partnerID=40&md5=a56f9e57faa09f03237c0f606f0fd86a},
   year = {2011}
}
