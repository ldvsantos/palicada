   author = {Lucas F Balcao and Cibele Longo and Joao H C Costa and Cintia Uller-Gomez and Luiz C P Machado Filho and Maria J Hoetzel and L F Balcão and Cibele Longo and Joao H C Costa and C Uller-Gómez and L.C.P.M. Filho and M J Hötzel and Lucas F Balcao and Cibele Longo and Joao H C Costa and Cintia Uller-Gomez and L C P Machado and M J Hotzel},
   city = {LETA - Laboratório de Etologia Aplicada e Bem-Estar Animal, Departamento de Zootecnia e Desenvolvimento Rural, Universidade Federal de Santa Catarina, Rod. Admar Gonzaga 1346 - Itacorubi, Florianópolis, Santa Catarina, 88034-001, Brazil},
   doi = {10.1071/AN15133},
   issn = {18360939 (ISSN)},
