   title = {Perfil socioeconômico dos agricultores familiares do distrito pantaneiro de mimoso- município de Santo Antônio de Leverger-MT},
   volume = {1},
   url = {https://desafioonline.ufms.br/index.php/RevAGB/article/view/12552},
