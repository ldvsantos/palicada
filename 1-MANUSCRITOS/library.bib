@article{Mahdhi2019,
   abstract = {We studied the effects of Prosopis juliflora on seed germination and growth of Sorghum bicolor, on Arbuscular Mycorrhizal Fungi (AMF) colonization and soil microbial properties. Aqueous extracts of this plant significantly inhibited the germination of Sorghum bicolor. Its litter also inhibited the plant growth and their AMF colonization roots. Results showed that P. juliflora stimulated the soil microbial biomass carbon, soil metabolic quotient and soil enzymes activities. © 2019, International Allelopathy Foundation. All rights reserved.},
   author = {M Mahdhi and T Tounekti and H Khemira},
   doi = {10.26651/allelo.j/2019-46-2-1214},
   issn = {09714693 (ISSN)},
   issue = {2},
   journal = {Allelopathy Journal},
   keywords = {Allelopathy,Arbuscular mycorrhizal fungi,Invasive legumes,Prosopis juliflora},
