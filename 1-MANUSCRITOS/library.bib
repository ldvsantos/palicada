@article{Brouwer1999,
   abstract = {We analyse a firm's propensity to patent, using a new indicator of innovative output. We find that a firm's propensity to patent is significantly higher among R&D collaborators, and it varies across sectors and by firm size. With a given innovation output, smaller innovators have a lower probability of applying for a patent. Smaller innovators that do apply for patents, however, tend to have higher numbers of patent applications than larger firms. The results have obvious consequences for the interpretation of patenting figures as an indicator of innovation.},
   author = {Erik Brouwer and Alfred Kleinknecht},
   doi = {10.1016/S0048-7333(99)00003-7},
   issn = {0048-7333},
   issue = {6},
   journal = {Research Policy},
   keywords = {Output,Patent,Propensity},
   month = {5},
   pages = {615-624},
   title = {Innovative output, and a firm's propensity to patent.: An exploration of CIS micro data},
   volume = {28},
   url = {http://www.sciencedirect.com/science/article/pii/S0048733399000037 https://www.sciencedirect.com/science/article/abs/pii/S0048733399000037},
   year = {1999}
}
