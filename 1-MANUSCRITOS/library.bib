   note = {cited By 2; Conference of International Conference on Information Technology and Systems, ICITS 2019 ; Conference Date: 6 February 2019 Through 8 February 2019; Conference Code:223499},
   pages = {113-121},
   publisher = {Springer Verlag},
   title = {Data Management Infrastructure from Initiatives on Photovoltaic Solar Energy},
   volume = {918},
