@article{Al-Farsi2020,
   abstract = {Lucerne (alfalfa, Medicago sativa L.) is a forage legume that is widely cultivated in arid and semi-arid regions of the world. The main aim of this review was to highlight the effects of salt stress on the performance of lucerne and to suggest different tolerance mechanisms and management strategies for improving its yield under salt stress. Salt stress significantly affects seed germination, carbon fixation, light harvesting, biological N2 fixation, mineral uptake and assimilation and dry-matter accumulation in lucerne. Accumulation of osmolytes or compatible solutes such as proline, polyamines, trehalose and soluble sugars confers salt tolerance in lucerne. Maintenance of low Na+: K+ ratios, antioxidant enzyme activation, and hormonal regulation also help lucerne to withstand salt stress. The screening of diverse genotypes on the basis of germination indices, gas exchange, biomass production, lipid peroxidation and antioxidant enzymes might be useful for breeding salt-tolerant lucerne genotypes. Novel biotechnological tools and functional genomics used to identify salt-conferring genes and quantitative trait loci will help to improve salt tolerance. Use of rhizobial and non-rhizobial plant growth-promoting bacteria, arbuscular mycorrhizal fungi, exogenous application of osmoprotectants, and seed priming with brassinolide, gibberellic acid and salicylic acid may help to improve lucerne performance in saline environments. © 2020 CSIRO.},
   author = {S M Al-Farsi and A Nawaz and Anees-Ur-Rehman and S K Nadaf and A M Al-Sadi and K H M Siddique and M Farooq},
   doi = {10.1071/CP20033},
   issn = {18360947 (ISSN)},
   issue = {5},
   journal = {Crop and Pasture Science},
   keywords = {Fungi,Medicago sativa,alfalfa,amino acid,antioxidant,antioxidants,arbuscular mycorrhizal fungi,enzyme activity,forage,genomics,germination,ion toxicity,nitrogen fixation,osmoprotectants,salinity tolerance,seed priming,yield response},
   note = {Cited By :5<br/><br/><br/><br/>Correspondence Address: Farooq, M.; Department of Plant Sciences, College of Agricultural and Marine Sciences, Sultan Qaboos UniversityOman; email: farooqcp@squ.edu.om<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding details: Sultan Qaboos University, SQU, IG/AGR/CROP/19/01<br/><br/><br/><br/>Funding text 1: Financial support received from Sultan Qaboos University, Oman, through an internal grant (IG/AGR/CROP/19/01) is acknowledged.<br/><br/><br/><br/>References: Agarwal, S., Singh, B., Kumar, P., Salinity tolerance of some cultivars of berseem (Trifolium alexandrinum L.) during germination and early seedling growth (2010) Vegetos - An International Journal of Plant Research, 23, pp. 63-82; <br/>Aike, B., Zhenggang, G., Hongfei, Z., Suomin, W., A procedure for assessing the salt tolerance of lucerne (Medicago sativa L.) cultivar seedlings by combining agronomic and physiological indicators (2009) New Zealand Journal of Agricultural Research, 52, pp. 435-442;<br/>Al Khanjari, S., Al Khathiri, A., Esechie, H.A., Variation in chlorophyll meter readings, nodulation and dry matter yield of alfalfa (Medicago sativa L.) cultivars differing in salt tolerance (2002) Crop Research, 24, pp. 350-356;<br/>Al-Khateeb, S.A., Effect of calcium/sodium ratio on growth and ion relations of alfalfa (Medicago sativa L.) seedling grown under saline condition (2006) Journal of Agronomy, 5, pp. 175-181;<br/>Al-Khatib, M.M., (1991) An assessment of the potential for improving salt tolerance in alfalfa (Medicago sativa L.), , PhD Thesis, University of Liverpool, Liverpool, UK;<br/>Al-Khatib, M., Mcneilly, T., Collins, J.C., The potential of selection and breeding for improved salt tolerance in lucerne (Medicago sativa L.) (1992) Euphytica, 65, pp. 43-51;<br/>Al-Khatib, M.M., Mcneilly, T., Collins, J.C., Between and within cultivar variability in salt tolerance in lucerne (Medicago sativa L.) (1994) Genetic Resources and Crop