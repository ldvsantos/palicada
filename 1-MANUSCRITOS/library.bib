@article{Lucas2016,
   abstract = {J.G. Beacham Water Treatment Plant was built and went on-line in 1936. For 80 years now, the plant has supplied high-quality drinking water, meeting community needs through growth, severe drought, and economic changes in Athens-Clarke County(ACC). The county's water supply is withdrawn from the North Oconee River, the Middle Oconee River and, during periods of low flow, from the Bear Creek Reservoir. Major improve?ments to the J.G. Beacham Plant were completed in 2009. For safety and security, a new ultraviolet (UV) disinfection system was added. The chlorine gas system was replaced with sodium hypochlorite generators, brine, and hypochlorite storage tanks. A new chemical feed system was installed. Filter underdrains were upgraded, allowing filters to operate at a higher rate, thus increasing plant treatment capacity from 28 mgd to 36 mgd. The addition of a two-story wing, housing the new UV system, restored the building's original orientation toward the rive. Along with the significant improve?ments to plant processes, the county took an innovative step and built the Bob M. Snipes Water Resources Center (WRC). The WRC earned a silver LEED (Leadership in Energy and Environmental Design) certification for conscientious construction, efficient energy and water use, and a healthy indoor environment.},
   author = {R Lucas and M Hall},
   doi = {10.5942/jawwa.2016.108.0159},
   issn = {0003150X (ISSN)},
   issue = {10},
   journal = {Journal - American Water Works Association},
   keywords = {Chemical feed,Healthy indoor environments,Leadership in energy and environmental designs,Plant process,Potable water,Safety and securities,Sodium hypochlorites,Treatment capacity,Ultraviolet disinfections,Water,Water resources,Water supply,Water treatment,Water treatment plants},
   note = {CODEN: JAWWA<br/><br/><br/><br/>Correspondence Address: Hall, M.; Athens-Clarke County Public Utilities Department, 124 E. Hancock Ave., United States; email: marilyn.hall@athensclarkecounty.com<br/><br/><br/><br/>Export Date: 19 March 2020<br/><br/><br/><br/>References: UR  - https://www.scopus.com/inward/record.uri?eid=2-s2.0-84992199722&amp;doi=10.5942%2fjawwa.2016.108.0159&amp;partnerID=40&amp;md5=39702b71bd83618e102443c692e18f94},
   pages = {54-59},
   title = {J.G. Beacham water treatment plant: 80 years of heritage and innovation},
   volume = {108},
   year = {2016}
}
