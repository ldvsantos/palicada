   isbn = {9783037859926},
   issn = {16609336},
   journal = {Applied Mechanics and Materials},
   note = {cited By 2; Conference of 4th International Conference on Frontiers of Manufacturing and Design Science, ICFMD 2013 ; Conference Date: 10 September 2013 Through 12 September 2013; Conference Code:102765},
   pages = {2692-2696},
   title = {Spreading the culture of a sustainable manufacturing of eco-fashion products. Focus on international brands that make the synergy between fashion design and sustainability their success},
   volume = {496-500},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84893932111&doi=10.4028%2Fwww.scientific.net%2FAMM.496-500.2692&partnerID=40&md5=ff169c6ebdcf13b60c5b55c96871f59c},
