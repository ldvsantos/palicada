@article{Gibelin-Viala2019,
   abstract = {Plant -specific lysin-motif receptor-like kinases (LysM-RLKs) are implicated in the perception of N-acetyl glucosamine-containing compounds, some of which are important signal molecules in plant−microbe interactions. Among these, both lipo-chitooligosaccharides (LCOs) and chitooligosaccharides (COs) are proposed as arbuscular mycorrhizal (AM) fungal symbiotic signals. COs can also activate plant defence, although there are scarce data about CO production by pathogens, especially nonfungal pathogens. We tested Medicago truncatula mutants in the LysM-RLK MtLYK9 for their abilities to interact with the AM fungus Rhizophagus irregularis and the oomycete pathogen Aphanomyces euteiches. This prompted us to analyse whether A. euteiches can produce COs. Compared with wild-type plants, Mtlyk9 mutants had fewer infection events and were less colonised by the AM fungus. By contrast, Mtlyk9 mutants were more heavily infected by A. euteiches and showed more disease symptoms. Aphanomyces euteiches was also shown to produce short COs, mainly CO II, but also CO III and CO IV, and traces of CO V, both ex planta and in planta. MtLYK9 thus has a dual role in plant immunity and the AM symbiosis, which raises questions about the functioning and the ancestral origins of such a receptor protein. © 2019 The Authors. New Phytologist © 2019 New Phytologist Trust},
   author = {C Gibelin-Viala and E Amblard and V Puech-Pages and M Bonhomme and M Garcia and A Bascaules-Bedin and J Fliegmann and J Wen and K S Mysore and C le Signor and C Jacquet and C Gough},
   doi = {10.1111/nph.15891},
   issn = {0028646X (ISSN)},
   issue = {3},
   journal = {New Phytologist},
   keywords = {Amino Acid Sequence,Aphanomyces,Aphanomyces euteiches,Chitin,Fungi,Gene Expression Regulation, Plant,Glomeromycota,LysM receptor-like kinase,Medicago truncatula,Mutation,Mycorrhizae,Plant Immunity,Plant Proteins,Rhizophagus,Symbiosis,amino acid sequence,arbuscular mycorrhiza,barrel medic,biosynthesis,chemical compound,chemistry,chitin,chitooligosaccharide,enzyme,enzyme activity,gene,gene expression,gene expression regulation,genetics,immunity,legume,metabolism,microbiology,mutation,mycorrhiza,oligochitosan,physiology,plant defence,plant defense,plant immunity,plant protein,polysaccharide,symbiosis},
   note = {Chemicals/CAS: chitin, 1398-61-4; Chitin; oligochitosan; Plant Proteins<br/><br/><br/><br/>Cited By :12<br/><br/><br/><br/>CODEN: NEPHA<br/><br/><br/><br/>Correspondence Address: Gough, C.; LIPM, INRA, CNRS, Université de ToulouseFrance; email: Eclare.gough@inra.fr<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding details: Agence Nationale de la Recherche, ANR, ANR-10-LABX-41, LABEX, ANR-14-CE18-0008-02<br/><br/><br/><br/>Funding details: Centre National de la Recherche Scientifique, CNRS<br/><br/><br/><br/>Funding details: Centre National de la Recherche Scientifique, CNRS<br/><br/><br/><br/>Funding details: Institut National de la Recherche Agronomique, INRA<br/><br/><br/><br/>Funding details: MetaboHUB-ANR-11-INBS-0010<br/><br/><br/><br/>Funding details: National Science Foundation, NSF, DBI-0703285, IOS-1127155<br/><br/><br/><br/>Funding details: Noble Research Institute<br/><br/><br/><br/>Funding text 1: We are grateful to Mathilda Walch, Luis Buendia and Laurent Kamel for technical help and advice. We thank Guillaume Bécard, Julie Cullimore and Jean-Jacques Bono for discussions and comments on the work, and Delphine Pitorre for preliminary work. We gratefully acknowledge RevGenUK and the John Innes Centre Genome Laboratory, as well as INRA and the 6th PCRDT Program GRAIN LEGUMES, for carrying out the TILLING and as the source of the material for the Mtlyk9-3 EMS mutant. The Mtlyk9-2 plants utilised in this research project, which are jointly owned by the Centre National De La Recherche Scientifique, were obtained from Noble Research Institute, LLC. and were created through research funded, in part, by a grant from the National Science Foundation, DBI-0703285 and IOS-1127155. This work was funded by INRA, the CNRS, the UniversitéPaul Sabatier and the French Agence Nationale de la Recherche ‘NICE CROPS’ project (ANR-14-CE18-0008-02) and the ‘Laboratoire d’Excellence’ (LABEX) entitled TULIP (ANR-10-LABX-41). Part of the work was supported by ICT-Mass spectrometry facilities (http://ict.ups-tlse.f r), MetaToul (Metabolomics &amp; Fluxomics Facitilies in Toulouse, www.metatoul.fr) and the French National infrastructure for metabolomics and fluxomics (www.metabohub.fr), MetaboHUB-ANR-11-INBS-0010.<br/><br/><br/><br/>References: Arrighi, J.-F., Barre, A., Ben Amor, B., Bersoult, A., Soriano, L.C., Mirabella, R., de Carvalho-Niebel, F., Huguet, T., The Medicago truncatula lysin motif-receptor-like kinase gene family includes NFP and new nodule-expressed genes (2006) Plant Physiology, 142, pp. 265-279; <br/>Badis, Y., Bonhomme, M., Lafitte, C., Huguet, S., Balzergue, S., Dumas, B., Jacquet, C., Transcriptome analysis highlights preformed defences and signalling pathways controlled by the prAe1 quantitative trait locus (QTL), conferring partial resistance to Aphanomyces euteiches in Medicago truncatula (2015) Molecular Plant Pathology, 16, pp. 973-986;<br/>Badreddine, I., Lafitte, C., Heux, L., Skandalis, N., Spanou, Z., Martinez, Y., Esquerre-Tugaye, M.T., Bottin, A., Cell wall chitosaccharides are essential components and exposed patterns of the phytopathogenic oomycete Aphanomyces euteiches (2008) Eukaryotic Cell, 7, pp. 1980-1993;<br/>Ben Amor, B., Shaw, S.L., Oldroyd, G.E.D., Maillet, F., Penmetsa, R.V., Cook, D., Long, S.R., Gough, C., The NFP locus of Medicago truncatula controls an early step of Nod factor signal transduction upstream of a rapid calcium flux and root hair deformation (2003) The Plant Journal, 34, pp. 495-506;<br/>Bonfante, P., Genre, A., Arbuscular mycorrhizal dialogues: do you speak ‘plantish’ or ‘fungish’? (2015) Trends Plant Sciences, 20, pp. 150-154;<br/>Bonhomme, M., André, O., Badis, Y., Ronfort, J., Burgarella, C., Chantret, N., Prosperi, J., Debellé, F., High-density genome-wide association mapping implicates an F-box encoding gene in Medicago truncatula resistance to Aphanomyces euteiches (2014) New Phytologist, 201, pp. 1328-1342;<br/>Bonneau, L., Huguet, S., W