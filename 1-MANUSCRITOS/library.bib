@article{Nazeri2014,
   abstract = {Pastures often experience a pulse of phosphorus (P) when fertilized. We examined the role of arbuscular mycorrhizal fungi (AMF) in the uptake of P from a pulse. Five legumes (Kennedia prostrata, Cullen australasicum, Bituminaria bituminosa, Medicago sativa and Trifolium subterraneum) were grown in a moderate P, sterilized field soil, either with (+AMF) or without (-AMF) addition of unsterilized field soil. After 9-10 weeks, half the pots received 15mg P kg-1 of soil. One week later, we measured: shoot and root dry weights; percentage of root length colonized by AMF; plant P, nitrogen and manganese (Mn) concentrations; and rhizosphere carboxylates, pH and plant-available P. The P pulse raised root P concentration by a similar amount in uncolonized and colonized plants, but shoot P concentration increased by 143% in uncolonized plants and 53% in colonized plants. Inoculation with AMF decreased the amount of rhizosphere carboxylates by 52%, raised rhizosphere pH by ~0.2-0.7 pH units and lowered shoot Mn concentration by 38%. We conclude that AMF are not simply a means for plants to enhance P uptake when P is limiting, but also act to maintain shoot P within narrow boundaries and can affect nutrient uptake through their influence on rhizosphere chemistry. © 2013 John Wiley &amp; Sons Ltd.},
   author = {N K Nazeri and H Lambers and M Tibbett and M H Ryan},
   doi = {10.1111/pce.12207},
   issn = {01407791 (ISSN)},
   issue = {4},
   journal = {Plant, Cell and Environment},
   keywords = {Analysis of Variance,Arbuscular,Bituminaria bituminosa,Carboxylic Acids,Colony Count, Microbial,Cullen australasicum,Fungi,Hydrogen-Ion Concentration,Kennedia prostrata,Linear Models,Manganese,Medicago sativa,Mycorrhiza-mediated resource partitioning,Mycorrhizae,Nitrogen,Phosphorus,Phosphorus pulse,Plant Leaves,Plant Shoots,Plants,Rhizosphere,Rhizosphere carboxylates,Rhizosphere pH,Root exudates,Seedling,Species Specificity,Trifolium,Trifolium subterraneum,analysis of variance,article,bacterial count,carboxylic acid,exudation,fungus,growth, development and aging,histology,legume,manganese,metabolism,microbiology,mycorrhiza,mycorrhiza-mediated resource partitioning,niche partitioning,nitrogen,nutrient limitation,nutrient uptake,nutritional status,pH,phosphorus,phosphorus pulse,physiology,plant,plant leaf,rhizosphere,rhizosphere carboxylates,rhizosphere pH,root exudates,seedling,species difference,statistical model},
   note = {Chemicals/CAS: manganese, 16397-91-4, 7439-96-5; nitrogen, 7727-37-9; phosphorus, 7723-14-0<br/><br/><br/><br/>Cited By :30<br/><br/><br/><br/>CODEN: PLCED<br/><br/><br/><br/>Correspondence Address: Nazeri, N.K.; School of Plant Biology and Institute of Agriculture, The University of Western Australia, 35 Stirling Highway, Perth, WA, 6009, Australia; email: nazern01@student.uwa.edu.au<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>References: Asghari, H.R., Cavagnaro, T.R., Arbuscular mycorrhizas enhance plant interception of leached nutrients (2011) Functional Plant Biology, 38, pp. 219-226; <br/>Bago, B., Vierheilig, H., Piché, Y., Azcón-Aguilar, C., Nitrate depletion and pH changes induced by the extraradical mycelium of the arbuscular mycorrhizal fungus Glomus intraradices grown in monoxenic culture (1996) New Phytologist, 133, pp. 273-280;<br/>Bethlenfalvay, G.J., Brown, M.S., Pacovsky, R.S., Parasitic and mutualistic associations between a mycorrhizal fungus and soybean: development of the host plant (1982) Phytopathology, 72, pp. 894-897;<br/>Binkley, D., Ion exchange resin bags: factors affecting estimates of nitrogen availability (1984) Soil Science Society of America Journal, 48, pp. 1181-1184;<br/>Blackwell, M.S.A., Brookes, P.C., de la Fuente-Martinez, N., Gordon, H., Murray, P.J., Snars, K.E., Haygarth, P.M., Phosphorus solubilization and potential transfer to surface waters from the soil microbial biomass following drying-rewetting and freezing-thawing (2010) Advances in Agronomy, 106, pp. 1-35;<br/>Blair, G.J., Chinoim, N., Lefroy, R.D.B., Anderson, G., Crocker, G., A soil sulfur test for pastures and crops (1991) Australian Journal of Soil Research, 29, pp. 619-626;<br/>Cawthray, G.R., An improved reversed-phase liquid chromatographic method for the analysis of low-molecular mass organic acids in plant root exudates (2003) Journal of Chromatography A, 1011, pp. 233-240;<br/>Cogliatti, D.H., Clarkson, D.T., Physiological