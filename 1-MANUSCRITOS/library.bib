@article{Liang2014,
   abstract = {Chitin is the second most abundant polysaccharide in nature, found in crustacean shells, insect exoskeletons and fungal cell walls. The action of chitin and chitin derivatives on plants has become a very interesting story of late. Chitin is a b1-4-linked polymer of N-acetyl-Dglucosamine (GlcNAc). In this unmodified form, chitooligosaccharides (degree of polymerization (dp) = 6-8)) are strong inducers of plant innate immunity. By contrast, when these chitooligosaccharides are acylated (so-called lipochitooligosaccharides, LCOs) and further modified, they can act as Nod factors, the key signaling molecules that play an important role in the initiation of the legume-rhizobium symbiosis. In a similar form, these molecules can also act as Myc factors, the key signaling molecules involved in the arbuscular mycorrhizal (AM) symbiosis. It has been proposed that Nod factor perception might have evolved from the more ancient AM symbiosis. Increasing evidence now suggests that LCO perception might have evolved from plant innate immunity signaling. In this review, we will discuss the evolutionary origin of symbiotic LCO recognition. © 2014 New Phytologist Trust.},
   author = {Y Liang and K Tóth and Y Cao and K Tanaka and C Espinoza and G Stacey},
   doi = {10.1111/nph.12898},
   issn = {00223751 (ISSN)},
   issue = {2},
   journal = {Journal of Physiology},
   keywords = {Acylation,Arbuscular mycorrhizal (AM) symbiosis,Chitin,Evolution, Molecular,Fabaceae,Host-Pathogen Interactions,Innate immunity,Lipochitooligosaccharides (LCOs),Lipopolysaccharides,Models, Biological,Myc factors,Mycorrhizae,Nod factors,Nodulation,Peptidoglycan,Plant Immunity,Rhizobium,Signal Transduction,Symbiosis,acylation,biological model,chemistry,chitin,genetics,host pathogen interaction,lipid-linked oligosaccharides,lipopolysaccharide,metabolism,microbiology,molecular evolution,mycorrhiza,peptidoglycan,physiology,plant immunity,signal transduction,symbiosis},
