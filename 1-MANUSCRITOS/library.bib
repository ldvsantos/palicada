@article{Schwarz1978,
   abstract = {O problema de selecionar um dos vários modelos de diferentes dimensões é tratado encontrando sua solução Bayes e avaliando os termos principais de sua expansão assintomática. Estes termos são um critério de grande amostra válido além do contexto bayesiano, uma vez que não dependem da distribuição a priori.},
