@article{Santos2020i,
   abstract = {Os cupins desempenham atividades de elevada importância ecológica, sendo, classificados como consumidores primários e decompositores, auxiliando ainda na aeração e nutrição do solo. Estes insetos apresentam caminhamento passíveis de serem compreendidos por métodos de processamento de imagens quantificadores de movimento. Desta forma, para alcançar os objetivos propostos no presente trabalho, técnicas de processamento digital de imagens foram aplicadas para avaliar o comportamento de caminhamento do cupim Nasutitermes corniger (Insecta: Isoptera) realizadas durante simulação de forrageio e apresentando como possíveis obstáculos visuais, materiais vegetais mortos. Buscando quantificar os resultados obtidos nesta pesquisa foi utilizado o cálculo do Módulo de Dispersão de Intensidades (MDI) implementado no MATLAB 2015b.  Os cupins foram coletados em colônias presentes na Universidade Federal de Sergipe-UFS, selecionados ao acaso 12 indivíduos classificados como soldados e distribuídos em 5 grupos. Tais indivíduos foram submetidos à atividade de simulação do caminhamento em arenas utilizando placas de Petri (14 x 1,5cm) iluminado a laser HeNe 632 nm, durante a movimentação do inseto foram capturados vídeos, posteriormente processados por meio do Método das Diferenças Generalizadas e o Momento de Inércia. Foi possível detectar as zonas de caminhamento e de maiores atividades ocasionadas naturalmente pelos grupos de Cupins presentes nas arenas, como também o método de MI mostrou ser significativamente diferente quando analisado antes a durante o caminhamento. Dessa forma, foi possível analisar a atividade do caminhamento do Nasutitermes corniger por meio de técnicas de processamento de imagens em, podendo ser aplicado como uma ferramenta possível para avaliar o caminhamento dos cupins.},
   author = {Luiz Diego Vidal Santos and Adilson Machado Enes and Francisco Sandro Rodrigues Holanda and Alceu Pedrotti and Carlos Eduardo Celestino de Andrade and José Igor Reinan Santos and Cleomara Oliveira Santos},
   issn = {2595-4431},
   issue = {4},
   journal = {Revista Brasileira de Meio Ambiente},
   keywords = {Forrageamento,Momento de Inércia.,Processamento digital de imagem},
   month = {9},
   title = {Processamento digital de imagem na investigação de caminhamento de cupins Nasutitermes corniger (insecta: isoptera)},
   volume = {8},
   url = {https://www.revistabrasileirademeioambiente.com/index.php/RVBMA/article/view/555 https://www.revistabrasileirademeioambiente.com/index.php/RVBMA/article/download/555/257},
   year = {2020}
}
@article{Huang2018,
   abstract = {Abstrata  Este estudo investiga o comportamento estrutural dos conectores de tesoura em lajes de plataforma de plataforma de concreto composto de fibra de vidro (GFRP) de concreto. Cinco tipos de amostras push-out com conectores de tesoura GFRP foram preparados e testados. Os modos de falha dos espécimes foram observados, e as curvas de deslizamento de carga foram obtidas. Foram investigados os efeitos das formas das costelas, a presença de buracos e a existência de vergalhões transversais no modo de falha, resistência à tesoura e ductilidade. Os resultados mostraram que (1) a resistência à tesoura e a ductilidade dos conectores de tesoura de costela tipo T eram maiores do que os dos conectores de tesoura de placa plana. (2) A resistência à tesoura e a ductilidade foram significativamente melhoradas por furos. (3) O vergalhão transversal tem uma influência significativa no modo de falha. As lajes de concreto nos espécimes sem um vergalhão transverso falharam. Da mesma forma, o conector de tesoura GFRP nos espécimes com um vergalhão transversal entrou em colapso. (4) Todas as amostras apresentaram um modo de falha semelhante causado pela falha de tesoura dos conectores na raiz quando o vergalhão transversal foi aplicado. Além disso, a resistência à tesoura e a ductilidade dos conectores de tesoura GFRP diminuíram à medida que o número de vergalhões transversais aumentava. Equações empíricas foram propostas para prever a resistência à tesoura e validadas com os dados do teste.},
   author = {Hailin Huang and Ao Li and Lin Chen and Chuijun Zeng and Mingqiao Zhu},
   doi = {10.3151/jact.16.368},
   issue = {8},
   journal = {Journal of Advanced Concrete Technology},
   pages = {368-381},
   title = {Push-Out Tests for Shear Connectors in GFRP-Concrete Composite Bridge Deck Slabs},
   volume = {16},
   url = {https://www.jstage.jst.go.jp/article/jact/16/8/16_368/_pdf/-char/en https://www.jstage.jst.go.jp/article/jact/16/8/16_368/_article},
   year = {2018}
}
