@article{Sonestedt2005,
   abstract = {ObjectivosExaminar se o status da obesidade e os fatores socioeconômicos e de estilo de vida estão associados à mudança do hábito alimentar passado autorre relatado, e também se o nível de obesidade depende da razão da mudança.DesignAnálise transversal no estudo Malmo Diet and Cancer (MDC) utilizando dados do exame de linha de base e o extenso questionário socioeconômico e de estilo de vida, incluindo questões sobre a mudança do hábito alimentar passado. O risco de ter mudado hábitos alimentares no passado foi examinado por meio da regressão logística. Foram examinadas diferenças médias no status da obesidade entre as categorias de razões para a mudança do hábito alimentar passado, utilizando-se a análise da variância.ConfiguraçãoMalmö, a terceira maior cidade da Suécia.AssuntosUma sub-amostra (15 282 mulheres e 9.867 homens) da coorte MDC recrutada de 1992 a 1996.ResultadosIndivíduos com índice de massa corporal (IMC) >30 kg m−2 teve um risco aumentado de ter relatado mudança de hábito alimentar passado em comparação com indivíduos com IMC <25 kg m−2 (razão de chances (OR) = 1,63, intervalo de confiança de 95% (IC) = 1,48-1,83 para as mulheres; OR = 1,53, IC 95% = 1,32 -1,76 para homens). O maior nível de obesidade foi observado entre os indivíduos que mudaram sua dieta por razões relacionadas à síndrome metabólica. Os trocadores eram mais propensos a serem altamente educados e viverem sozinhos, serem aposentados, ex-fumantes e não-bebedores na linha de base.ConclusõesComo a mudança do hábito alimentar passado está relacionada à obesidade e outros fatores de estilo de vida e socioeconômicos, pode existir uma situação de confusão complexa que poderia influenciar seriamente as relações observadas entre dieta e doença. Estudos precisam coletar informações sobre a mudança do hábito alimentar passado e levar essas informações em conta na análise e na interpretação dos resultados do estudo.},
   author = {Emily Sonestedt and Elisabet Wirfält and Bo Gullberg and Göran Berglund},
   doi = {10.1079/PHN2005736},
   issn = {1475-2727, 1368-9800},
   issue = {7},
   journal = {Public Health Nutrition},
   keywords = {Lifestyle factors,Obesity,Past food habit change},
   month = {10},
   pages = {876-885},
   title = {Past food habit change is related to obesity, lifestyle and socio-economic factors in the Malmo Diet and Cancer Cohort},
   volume = {8},
   url = {https://www.cambridge.org/core/journals/public-health-nutrition/article/past-food-habit-change-is-related-to-obesity-lifestyle-and-socioeconomic-factors-in-the-malmo-diet-and-cancer-cohort/47FB7841F83997A8DEB9CD443C783B35 https://www.cambridge.org/core/se},
   year = {2005}
}
