@article{Wipf2019,
   abstract = {Summary Arbuscular mycorrhiza (AM) symbiosis occurs between obligate biotrophic fungi of the phylum Glomeromycota and most land plants. The exchange of nutrients between host plants and AM fungi (AMF) is presumed to be the main benefit for the two symbiotic partners. In this review article, we outline the current concepts of nutrient exchanges within this symbiosis (mechanisms and regulation). First, we focus on phosphorus and nitrogen transfer from the fungal partner to the host plant, and on the reciprocal transfer of carbon compounds, with a highlight on a possible interplay between nitrogen and phosphorus nutrition during AM symbiosis. We further discuss potential mechanisms of regulation of these nutrient exchanges linked to membrane dynamics. The review finally addresses the common mycorrhizal networks formed AMF, which interconnect plants from similar and/or different species. Finally the best way to integrate this knowledge and the ensuing potential benefits of AM into sustainable agriculture is discussed.},
   author = {Daniel Wipf and Franziska Krajinski and Diederik van Tuinen and Ghislaine Recorbet and Pierre-Emmanuel Courty},
   doi = {10.1111/nph.15775},
   issn = {0028-646X},
   issue = {3},
   journal = {New Phytologist},
   keywords = {arbuscular mycorrhizal symbiosis,carbon supply,common mycorrhizal networks,membrane lipids,mineral nutrition,plant–plant interactions,transporters},
   month = {12},
   pages = {1127-1142},
   title = {Trading on the arbuscular mycorrhiza market: from arbuscules to common mycorrhizal networks},
   volume = {223},
   url = {https://nph-onlinelibrary-wiley.ez20.periodicos.capes.gov.br/doi/full/10.1111/nph.15775 https://nph.onlinelibrary.wiley.com/doi/pdfdirect/10.1111/nph.15775},
   year = {2019}
}
@article{Paes2020,
   abstract = {A atividade turística envolve uma complexidade de relações que abrange variados atores sociais em um destino turístico. Os turistas e os visitantes se destacam ao buscarem experiências turísticas memoráveis, sendo cocriadores das suas próprias experiências ao visitarem uma localidade. O presente estudo caracteriza-se por ser uma revisão bibliográfica que visa abordar aspectos sobre a atividade turística, destinos turísticos, cocriação de valor e o marketing de experiência, baseado em alguns dos principais estudiosos sobre os temas: co-criação (Vargo & Lusch, 2008; Payne et al., 2008) e marketing de experiência (Schmitt, 1999, 2002, 2006, 2010; Smith & Hanover, 2016). Para tal, foi realizada uma pesquisa bibliográfica sendo este trabalho de natureza exploratória e descritiva. Observa-se a necessidade de as localidades turísticas trabalharem em um planejamento integrado considerando o setor público, privado e a comunidade local, buscando devolverem atrativos e serviços turísticos consistentes com boas experiências turísticas.},
   author = {Taís Alexandre Antunes Paes and Rodrigo Ladeira and Maria Teresa Grimaldi Larocca},
   doi = {10.18472/cvt.20n1.2020.1757},
   issn = {1677-6976},
   issue = {1},
   journal = {Caderno Virtual de Turismo},
   keywords = {Co-criação de valor,Destinos turísticos,Marketing de experiência},
   month = {9},
   title = {Destinos turísticos e a sua relação com o processo de cocriação de valor e o marketing de experiência: uma revisão bibliográfica},
   volume = {20},
   url = {http://www.ivt.coppe.ufrj.br/caderno/index.php/caderno/article/view/1757 http://www.ivt.coppe.ufrj.br/caderno/index.php/caderno/article/download/1757/665},
   year = {2020}
}
