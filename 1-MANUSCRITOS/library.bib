@article{Xin2018,
   abstract = {Os objetivos deste estudo foram identificar diferenças genotípicas na captação e translocação do boro (B) no vetiver ( Chrysopogon zizanioidesL.), uma espécie promissora na fitorremediação B, e para determinar a eficiência do sistema de ilhas flutuantes de vetiver na fitorremediação B. Alterações na biomassa das plantas, captação e translocação de B foram determinadas em dois genótipos de vetiver, Sierra e Sunshine, cultivados hidroponicamente em solução nutritiva e expostos a seis concentrações diferentes de B nos 7d e 14d. Também foi determinada a eficiência da remoção de B por Sierra (um genótipo acumulativo de alto B) cultivado em ilhas flutuantes. A concentração de parte aérea diferiu significativamente entre os dois genótipos, mas as diferenças na concentração de raízes não foram significativas. A transferência de raiz para parte aérea ea capacidade de captação de B foram maiores na Serra do que na Sunshine. A captação e translocação de B foram afetadas pela concentração de B e pelo tempo de exposição. As plantas da Sierra cultivadas em ilhas flutuantes foram mais eficientes na remoção de B em concentrações mais baixas de B. A maioria dos B removidos acumulou-se nas seções médio-superior de folhas velhas. O Sierra é mais adequado para a remoção de B das águas residuais do que o Sunshine, especialmente no sistema de ilhas flutuantes de vetiver.},
   author = {Junliang Xin and Baifei Huang},
   doi = {10.1080/15226514.2018.1438355},
   issn = {1522-6514},
   issue = {8},
   journal = {International Journal of Phytoremediation},
   month = {5},
   pages = {847-854},
   title = {Comparison of boron uptake and translocation in two vetiver genotypes and evaluation of boron removal efficiency of vetiver floating islands},
   volume = {20},
   url = {https://www-tandfonline.ez141.periodicos.capes.gov.br/doi/full/10.1080/15226514.2018.1438355 https://www-tandfonline.ez141.periodicos.capes.gov.br/doi/pdf/10.1080/15226514.2018.1438355},
   year = {2018}
}
@article{McClain2016,
   abstract = {This article explores the elements limiting adaptive governance in the Tisza sub-basin, considers policy options available to the sub-basin, and concludes that more attention must be paid to frameworks governing adaptation in transboundary sub-basins where resources are limited. The Tisza is the largest sub-basin in the Danube River basin, and faces increasing water management pressures exacerbated by climate change. The Tisza countries have experienced challenges with managing climate change adaptation in a nested, consistent and effective manner pursuant to the EU Water Framework Directive. This is due to inefficiencies in climate change adaptation, such as weakened vertical coordination. © 2016 International Water Resources Association.},
   author = {S N McClain and C Bruch and S Secchi},
   doi = {10.1080/02508060.2016.1214774},
   issn = {02508060 (ISSN)},
   issue = {6},
   journal = {Water International},
   keywords = {Sub-basin governance,Tisza,Water Framework Directive,climate change adaptation},
