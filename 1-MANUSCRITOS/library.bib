   title = {Nanoparticles based on carbon dots and reduced graphene oxide as electrochemical sensor for voltammetric determination of hydroxychloroquine},
   volume = {36},
   url = {https://analyticalsciencejournals.onlinelibrary.wiley.com/doi/10.1002/elan.202300164},
   year = {2024}
}
