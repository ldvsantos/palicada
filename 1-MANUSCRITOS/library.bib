@article{Santos2022,
   abstract = {RESUMO Considerando que o tema empreendedorismo e agricultura sustentável ainda é pouco discutido em conjunto e que se mostra de suma importância, o presente estudo teve por objetivo identificar quais os fatores relevantes que sustentam a criação de um brand equity sustentável nas empresas relacionadas a exploração florestal através de uma análise de escopo da literatura acadêmica internacional. Usando critérios de revisão de escopo segundo as Cochrane, identificamos os fatores mais importantes relacionados às atividades desenvolvidas por negócios sustentáveis relacionados à exploração florestal e proteção ambiental que têm o potencial de moldar a eficiência de brand equity em marcas. Um total de 264 registros de citações foram selecionados inicialmente usando os descritores, resultando em 32 por meio dos critérios de elegibilidade e avaliação de qualidade. Os resultados sugerem que os fatores mais relevantes para construção de um branding voltados a sustentabilidade ambiental foram: desempenho inovador do país (inovação), percentual do faturamento da empresa investido em atividades de inovação, percentual do faturamento total investido na aquisição de máquinas, equipamentos, software ou licenças, percentual do faturamento total investido na reputação e branding da empresa, incluindo web design, percentagem do volume de negócios total investido no desenvolvimento de software. Além disso, a importância de mais pesquisas sobre branding voltado aos negócios relacionados a exploração florestal sustentável, já que poucos trabalhos sobre o tema emergiram desta revisão de escopo. ABSTRACT Considering that the theme of entrepreneurship and sustainable agriculture is still little discussed together and that it is of paramount importance, the present study aimed to identify the relevant factors that support the creation of sustainable brand equity in companies related to forest exploitation through a scoping analysis of the international academic literature. Using Cochrane scoping criteria, we identified the most important factors related to sustainable business activities related to forestry and environmental protection that have the potential to shape the effectiveness of brand equity in brands. A total of 264 citation records were initially selected using the descriptors, resulting in 32 through the eligibility and quality assessment criteria. The results suggest that the most relevant factors for the construction of a branding focused on environmental sustainability were: innovative performance of the country (innovation), percentage of company revenue invested in innovation activities, percentage of total revenue invested in the acquisition of machinery, equipment, software or licenses, percentage of total revenue invested in company reputation},
   author = {Luiz Diego Vidal Santos Santos and Francisco Sandro Rodrigues Holanda and Catuxe Varjão de Santana Oliveira and Vitor de Andrade Rodrigues Holanda and Mylena Silva Campos and José dos Santos Machado},
   doi = {10.53660/CLM-159-127},
   issn = {1414-7327},
   issue = {1},
   journal = {concilium},
   keywords = {Brand Equity,Gerenciamento estratégico,Palavras-chave: Floresta,Startups},
   title = {Brand equity sustentável: levantamento teórico sobre marcas relacionadas a exploração florestal},
   volume = {22},
   url = {http://www.clium.org/index.php/edicoes/article/view/159},
   year = {2022}
}
@article{Holanda2022,
   abstract = {O aporte de sedimentos em sistemas aquáticos são processos naturais que levam em consideração os contextos geomorfológicos, hidrológicos e ambientais. A carga de sedimentos transportados no fluxo de um rio é determinada pela vazão do rio, assim como pelos processos erosivos das suas margens. O objetivo desse trabalho foi analisar a produção de sedimentos suspensos e de carga de fundo no canal do rio Poxim Açú no município de São Cristóvão, no estado de Sergipe, nordeste do Brasil. Foram delimitados oito transectos (TR1-TR8) a jusante da barragem Jaime Umbelino de Souza, para realização de levantamento batimétrico e determinação da vazão. Amostras de água e material depositado no fundo do leito do rio também foram coletadas para avaliação da concentração de sedimentos em suspensão e, caracterização granulométrica e textural da carga de fundo. Percebeu-se que a operação da barragem e outros fatores ao longo do trecho estudado provocam variações da vazão e velocidade média da água (entre 0,59 a 1,25 m³.s-1, e 0,28 a 1,03 m.s-1), respectivamente, e consequentemente, influenciam na produção de sedimentos em suspensão assim como na carga de fundo.},
   author = {Francisco Sandro Rodrigues Holanda and José Oliveira Dantas and Itala Tainy Barreto Francisco dos Santos and Valter Ferreira Rocha Junior and Maria Hosana dos Santos and Luiz Diego Vidal Santos},
   doi = {10.24221/JEAP.7.2.2022.3958.073-082},
   issn = {2525-815X},
   issue = {2},
   journal = {Journal of Environmental Analysis and Progress},
   keywords = {carga de fundo,erosão},
   month = {4},
   pages = {073-082},
   title = {Dinâmica hidrossedimentológica do rio Poxim Açú à jusante da Barragem Jaime Umbelino em Sergipe, Brasil},
   volume = {7},
   url = {http://www.journals.ufrpe.br/index.php/JEAP/article/view/3958},
   year = {2022}
}
