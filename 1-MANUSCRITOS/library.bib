@article{Zhao2015,
   abstract = {Managed aquifer recharge (MAR) has been widely recognized as a promising tool for integrated water resource management such as water reuse and water banking. The latest 8th of ISMAR (ISMAR8), was held with the theme “MAR: meeting the water resource challenge”, on 15–19 October, 2013 in Beijing, China. ISMAR8 provided good opportunity to gain insights into the innovation of water resources management and the varied MAR projects underway. The special issue of EES will promote further academic exchange and further advances of our knowledge in MAR and its applications. © 2015, Springer-Verlag Berlin Heidelberg.},
