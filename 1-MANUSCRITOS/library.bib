@article{Soares2018,
   abstract = {O objetivo do presente trabalho consiste em caracterizar a pesquisa bibliográfica, a pesquisa bibliométrica, o artigo de revisão e o ensaio teórico. Para tanto, desenvolveu-se uma análise de conteúdo acerca dos conceitos presentes nos livros-texto de metodologia além de fontes complementares, buscando identificar o que são, que objetivo têm e de que formas se apresentam esses quatro tipos de textos. Nesse sentido, verificou-se, na literatura, que há características partilhadas por esses diferentes tipos de textos, que os tornam iguais, bem como que há características que os distinguem, tornando-os únicos. A pesquisa bibliográfica apresenta-se, na literatura, como mais flexível, podendo, inclusive, ser apenas parte da pesquisa empírica, e ser apresentada na forma de um capítulo de tese ou dissertação. A pesquisa bibliométrica precisa, necessariamente, contemplar uma etapa de análise quantitativa de dados. O artigo de revisão tem como característica principal a sistematicidade com a qual o material bibliográfico é coletado e analisado. Tanto a pesquisa bibliográfica quanto o artigo de revisão, usualmente, são apresentados conforme estrutura de pesquisa empírica. O ensaio, por sua vez, distancia-se dos outros três, pois independe de evidências empíricas, de análises quantitativas, de sistematicidade em sua construção e, por possuir uma estrutura amorfa. A qualidade do ensaio decorre da originalidade e do ineditismo de sua proposição.},
   author = {Sandro Vieira Soares and Icaro Roberto Azevedo Picolli and Jacir Leonir Casagrande},
   doi = {10.13058/raep.2018.v19n2.970},
   issn = {2358-0917},
   issue = {2},
   journal = {Administração: Ensino e Pesquisa},
   keywords = {Artigo de revisão,Bibliographic research,Bibliometric research,Ensaio teórico,Pesquisa bibliográfica,Pesquisa bibliométrica,Review article,Theoretical essay},
   month = {8},
   pages = {308-339},
