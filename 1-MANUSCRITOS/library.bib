@article{Millemaci2014,
   abstract = {Abstrata Propósito O objetivo deste estudo é investigar a validade da lei kaldor-verdoorn em explicar os determinantes de longo prazo do crescimento da produtividade do trabalho para o setor manufatureiro de algumas economias desenvolvidas (Países da Europa Ocidental, Austrália, Canadá, Japão e EUA). Design/metodologia/abordagem Os autores consideram o período 1973-2006 utilizando dados fornecidos pela Comissão Europeia – Economia e Assuntos Financeiros. O método é uma variável instrumental. A robustez das estimativas é verificada por meio dos testes chow e cusum e CUSUMQ. Os autores consideram a especificação tradicional da lei dinâmica de Verdoorn e aquela que também inclui a relação investimento/produção (I/Y), como um proxy da taxa de crescimento do capital, e o crescimento médio do custo do trabalho, como um proxy dos fatores de oferta. Resultados Os achados sugerem que a lei é válida para a fabricação, uma vez que os países mostram retornos crescentes à escala. O crescimento do capital e o crescimento do custo da mão-de-obra não parecem importantes para explicar o crescimento da produtividade. Os coeficientes verdoorn estimados são considerados substancialmente estáveis durante todo o período. Originalidade/valor Os autores consideram os anos mais recentes, que tem sido caracterizado por um declínio constante nas taxas médias de crescimento do PIB; um declínio do crescimento da produtividade; a redução a longo prazo da participação manufatureira do emprego total. Os autores examinam a importância de hipóteses alternativas como as relacionadas à existência de restrições de fornecimento. Os autores verificam a estabilidade do KVL ao longo do período sob a consideração e entre os países. Os autores avaliam se, no caso dos países desenvolvidos, as economias de escala são significativas.},
   author = {Emanuele Millemaci and Ferdinando Ofria},
   doi = {10.1108/JES-02-2012-0026},
   issn = {0144-3585},
   issue = {1},
   journal = {Journal of Economic Studies},
   keywords = {Increasing returns,Kaldor-Verdoorn law,Manufacturing sector,Productivity growth},
   month = {9},
   pages = {140-162},
   title = {Kaldor-Verdoorn's law and increasing returns to scale: A comparison across developed countries},
   volume = {41},
   url = {https://doi.org/10.1108/JES-02-2012-0026 https://www.emerald.com/insight/content/doi/10.1108/JES-02-2012-0026/full/pdf?title=kaldor-verdoorns-law-and-increasing-returns-to-scale-a-comparison-across-developed-countries},
   year = {2014}
}
@article{Kirienko2019,
   abstract = {Lysin-motif receptor-like kinase PsK1 is involved in symbiosis initiation and the maintenance of infection thread (IT) growth and bacterial release in pea. We verified PsK1 specificity in relation to the Nod factor structure using k1 and rhizobial mutants. Inoculation with nodO and nodE nodO mutants significantly reduced root hair deformations, curling, and the number of ITs in k1-1 and k1-2 mutants. These results indicated that PsK1 function may depend on Nod factor structures. PsK1 with replacement in kinase domain and PsSYM10 co-production in Nicotiana benthamiana leaves did not induce a hypersensitive response (HR) because of the impossibility of signal transduction into the cell. Replacement of P169S in LysM3 domain of PsK1 disturbed the extracellular domain (ECD) interaction with PsSYM10′ s ECD in Y2H system and reduced HR during the co-production of full-length PsK1 and PsSYM0 in N. benthamiana. Lastly, we explored the role of PsK1 in symbiosis with arbuscular mycorrhizal (AM) fungi; no significant differences between wild-type plants and k1 mutants were found, suggesting a specific role of PsK1 in legume–rhizobial symbiosis. However, increased sensitivity to a highly aggressive Fusarium culmorum strain was found in k1 mutants compared with the wild type, which requires the further study of the role of PsK1 in immune response regulation. © 2019 by the authors. Licensee MDPI, Basel, Switzerland.},
   author = {A N Kirienko and N A Vishnevskaya and A B Kitaeva and O Y Shtark and P Y Kozyulina and R Thompson and M Dalmais and A Bendahmane and I A Tikhonovich and E A Dolgikh},
   doi = {10.3390/ijms20071624},
   issn = {16616596 (ISSN)},
   issue = {7},
   journal = {International Journal of Molecular Sciences},
   keywords = {Arbuscular mycorrhizal fungi,Article,Bacterial mutants,Fusarium,Fusarium culmorum,Fusarium culmorum fungi,Genomic Structural Variation,Legume,LysM receptor-like kinases,Mycorrhizae,Nicotiana benthamiana,Nod factor perception,Pea Pisum sativum L.,Peas,Plant Proteins,Protein Domains,Protein Kinases,RNA extraction,Rhizobium,Rhizobium leguminosarum,Rhizobium symbiosis,Symbiosis,Tobacco,Western blotting,allergic reaction,chemistry,confocal microscopy,controlled study,dimerization,fungal colonization,fungus growth,genetic transformation,genetic variability,genetic variation,genetics,gibberellin,histochemistry,immune response,lysine,microbiology,mycorrhiza,mycosis,nonhuman,pathogenicity,pea,phosphate,phosphate transporter,plant gene,plant growth,plant leaf,plant protein,polyacrylamide gel electrophoresis,protein domain,protein kinase,protein motif,real time polymerase chain reaction,reverse transcription polymerase chain reaction,signal transduction,symbiosis,tobacco,transcription factor GAL4,transient expression},
   note = {Chemicals/CAS: lysine, 56-87-1, 6899-06-5, 70-54-2; phosphate, 14066-19-4, 14265-44-2; protein kinase, 9026-43-1; Plant Proteins; Protein Kinases<br/><br/><br/><br/>Cited By :1<br/><br/><br/><br/>Correspondence Address: Dolgikh, E.A.; All-Russia Research Institute for Agricultural Microbiology, Podbelsky chausse 3, Pushkin, Russian Federation; email: dol2helen@yahoo.com<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding details: Russian Science Foundation, RSF, 16-16-10043<br/><br/><br/><br/>Funding text 1: Funding: This work was financially supported by the Russian Science Foundation (grant 16-16-10043).<br/><br/><br/><br/>Manufacturers: Biorad, United States<br/><br/><br/><br/>References: Miya, A., Albert, P., Shinya, T., Desaki, Y., Ichimura, K., Shirasu, K., Narusaka, Y., Shibuya, N., CERK1, a LysM receptor kinase, is essential for chitin elicitor signaling in Arabidopsis (2007) Proc. Natl. Acad. Sci. USA, 104, pp. 19613-19618; <br/>Wan, J., Zhang, X.-C., Neece, D., Ramonell, K.M., Clough, S., Kim, S.-Y., Stacey, M.G., Stacey, G., A LysM receptor-like kinase plays a critical role in chitin signaling and fungal resistance in Arabidopsis (2008) Plant Cell, 20, pp. 471-481;<br/>Kaku, H., Nishizawa, Y., Ishii-Minami, N., Akimoto-Tomiyama, C., Dohmae, N., Takio, K., Minami, E., Shibuya, N., Plant cells recognize chitin fragments for defense signaling through a plasma membrane receptor (2006) Proc. Natl. Acad. Sci. USA, 103, pp. 11086-11091;<br/>Shimizu, T., Nakano, T., Takamizawa, D., Desaki, Y., Ishii-Minami, N., Nishizawa, Y., Minami, E., Kaku, H., Two LysM receptor molecules, CEBiP and OsCERK1, cooperatively regulate chitin elicitor signaling in rice (2010) Plant J, 64, pp. 204-214;<br/>Liu, T., Liu, Z., Song, C., Hu, Y., Han, Z., She, J., Fan, G., Chang, J., Chitin-induced dimerization activates a plant immune receptor (2012) Science, 336, pp. 1160-1164;<br/>Cao, Y., Liang, Y., Tanaka, K., Nguyen, C.T., Jedrzejczak, R.P., Joachi