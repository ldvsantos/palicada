@article{Caratelli2019,
   abstract = {The meaning about the origins of Al-Ain, the second largest city of Abu Dhabi Emirate in the UAE, resides in its name, which in Arabic means 'The spring'. The presence of abundant groundwater has allowed human settlements since the Neolithic period, marking this city as one of the oldest settlements continuously inhabited in the Gulf region. Under the rule of Sheikh Zayed bin Sultan Al Nayan (1918-2004), Al-Ain received special attention in order to preserve its character and identity, due also to the presence of historical heritage which forms a strong sense of belonging for its community. With the establishment of the UAE in 1971, and the institution of its municipality council in 1992, a special ordinance fixed a strict limit on building height, giving also particular attention to conservation of the original landscape formed by the seven ancient oases of palm trees and their irrigation systems of aflaj, an ancient irrigation system common in most arid zones of the Middle East, Central Asia, and the Mediterranean. Despite all these efforts spent in order to keep its original identity, nowadays this approach appears to be scrutinised under the pressures for further expansion and innovation in response to an increasingly challenging economy. With an increasing acceleration in the process of expansion and renovation, most of Al-Ain's urban fabric, realized after oil discovery in the 1960s, and still belonging to traditional typologies, has been replaced with new constructions inspired by different models, and new large developments have been laid out to cope with the increasing demand for dwellings. After recognition in 2011 of Al-Ain's archaeological sites and oases as a UNESCO World Heritage Site, the city's popularity rose as a tourist destination and place of cultural interest but has revealed in the meantime its systemic fragility. This paper focuses on the process of urban growth according to the nature of place, which characterized Al-Ain's history and currently forms the substrate of its cultural identity, and the mechanism of conflict/interaction between identity and innovation towards the definition of Al-Ain's urban transformation and regenerative process. © SPSD Press from 2010, SPSD Press, Kanazawa.},
   author = {P Caratelli and M A Misuri and M El Amrousi},
   doi = {10.14246/irspsd.7.3_45},
   issn = {21873666 (ISSN)},
   issue = {3},
   journal = {International Review for Spatial Planning and Sustainable Development},
   keywords = {Building heritage,Desert environment,Historical identity,Innovation,Urban development,Water resources},
   note = {Correspondence Address: Caratelli, P.; Department of Architecture and Design, Abu Dhabi UniversityUnited Arab Emirates; email: paolo.caratelli@adu.ac.ae<br/><br/><br/><br/>Export Date: 19 March 2020<br/><br/><br/><br/>References: &quot;Plan Al Ain 2030: Urban Structure Framework Plan&quot; (2007), https://faculty.uaeu.ac.ae/abintouq/GEO_Fall_2015/PlanAlAin2030.pdf; El Amrousi, M., Paleologos, E.K., Caratelli, P., Elhakeem, M., &quot;Are Garden Cities in the Desert Sustainable? The Oasis City of Al Ain in the Emirate of Abu Dhabi&quot; (2018) International Review for Spatial Planning and Sustainable Development, 6A (1), pp. 79-94; <br/>El Dali, T., Abdellatif, M.A., &quot;Al Ain Desert Community: Preserving the Local Environmental Character&quot; (1994) Art and Islamic World, 23, pp. 19-26;<br/>Garcia, E.J., Vale, B., (2017) Unravelling Sustainability and Resilience in the Built Environment, , London, UK: Routledge;<br/>Heard-Bey, F., (1982) From Trucial States to United Arab Emirates, , Dubai, UAE: Motivate Publishing;<br/>Herbert, F., (1965) Dune, , Quality Paperback Book Club;<br/>Iddison, P., &quot;Al Ain Oasis&quot; (2011), www.enhg.org/alain/phil/alainoasis/alainoasis.html, on February 2019; Issac, J., &quot;Uae's Per Capita Gdp Stays High&quot; (2016) Khaleej Times, , https://www.khaleejtimes.com/uaes-per-capita-gdp-stays-high, June 16, 2016;<br/>Madsen, B., (2018) The Early Bronze Age Tombs of Jebel Hafit: Danish Archaeological Investigations in Abu Dhabi 1961-1971, , Aarhus, DK: Aarhus University Press;<br/>Selim, G.M., Gamal, M., &quot;Neighborhoods &amp; Residential Communities: The Case of Al-Ain-Uae&quot; (2007) Proceedings of Housing Symposium, 3, pp. 343-361. , http://www.academia.edu/download/32075714/165385_1.pdf, Riyadh, Saudi Arabia;<br/>Shao, Y., Liu, B., &quot;Local Identity Regeneration of Unused Urban Spaces&quot; (2018) International review for spatial planning and sustainable development, 6 (4), pp. 21-34;<br/>(2017) Statistical Yearbook 2017, , Abu Dhabi, UAE;<br/>Tikriti, A., Yasin, W., (2011) Archaeology of the Falaj: A Field Study of the Ancient Irrigation Systems of the United Arab Emirates, , Abu Dhabi, UAE: Department of Historic Environment, Abu Dhabi Authority for Culture and Heritage (ADACH);<br/>Wikantiyoso, R., Suhartono, T., &quot;The Role of Csr in the Revitalization of Urban Open Space for Better Sustainable Urban Development&quot; (2018) International Review for Spatial Planning and Sustainable Development, 6 (4), pp. 5-20;<br/>Wilkinson, J.C., Water and Tribal Settlement in South-East Arabia (1977) A Study of the Aflaj of Oman, , Oxford, UK: Clarendon Press;<br/>Yildirim, E., El-Masri, S., &quot;Master Planning for Heritage Conservation in Al Ain Oasis, Uae&quot; (2010) Proceedings of 46th ISOCARP Congress, pp. 19-23. , Nairobi, Kenya},
   pages = {45-62},
   title = {Al-Ain's cultural landscape: Identity, innovation and sustainability in a challenging economy},
   volume = {7},
