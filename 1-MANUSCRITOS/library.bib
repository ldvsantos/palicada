@article{Santos2018g,
   abstract = {O modelo insustentável do uso intensivo de combustíveis fósseis tem impulsionado o desenvolvimento de pesquisas cujo objetivo prioritário é a obtenção de alternativas mais limpas e financeiramente viáveis. Dentre essas alternativas, insere-se o biodiesel produzido a partir da biomassa obtida mediante o cultivo de microalgas. Essa pesquisa realizou um estudo prospectivo de patentes sobre o cultivo de microalgas para a produção de biodiesel utilizando o código do Sistema Cooperativo de Classificação de Patentes (CCP), C12N1/12 combinado com C12P7/649, como melhor estratégia de busca, chegando a um total de 309 patentes, agrupadas em 103 famílias. Os resultados refletiram que essa tecnologia encontra-se em plena difusão, havendo maior número de depósitos e depositantes nos Estados Unidos da América, China e Coréia do Sul e os principais depositantes ainda são as pessoas físicas.},
   author = {Camila Cristina Andrade dos Santos and Luciano Matos Queiroz and Louisa Wessels Perelo and Emerson Sales Andrade},
   issue = {4},
   journal = {Cadernos de Prospecção},
   pages = {1057},
   title = {Prospecção Tecnológica de Patentes Sobre Cultivos de Microalgas Visando a Produção de Biodiesel},
   volume = {11},
   url = {https://rigs.ufba.br/index.php/nit/article/view/27206/16921},
   year = {2018}
}
@article{Marzban2017,
   abstract = {In order to evaluate arbuscular mycorrhizal fungi and rhizobium bacteria effects on leaf nitrogen (N) and phosphorus (P) concentration and root characteristics of green bean and maize under intercropping, experiment was carried out in the research field of College of Agriculture, Payame Noor University of Azna, Lorestan, Iran. In experiment, sandy loam soil with pH 7.3 and EC 0.49 dS m-1 was used.The treatments comprised three cropping systems (sole cropping of green bean and maize, and intercropping), and four inoculations (control, arbuscular mycorrhizal fungi, rhizobium and mix of arbuscular mycorrhizal fungi and rhizobium). The results showed that inoculation with rhizobium improved length, diameter, volume and area of green bean root.The highest of green bean N, P concentration and root dry mass were observed in sole culture of green bean inoculated with arbuscular mycorrhizal fungi. Moreover, root length, diameter, volume and area of maize increased by arbuscular mycorrhizal fungi, and total concentration of N and P enhanced with use of rhizobium in sole cropping. Although the usage of Rhizobium and AMF can be affected on increasing the root growth and nutrient uptake of crops, application of bacterium and fungi combination at the same time would not be suitable. Overall, intercropping of maize with green bean caused to increase of leaf N and P concentrations and root growth of maize.},
   author = {Z Marzban and E Faryabi and S Torabian},
   doi = {10.14720/aas.2017.109.1.08},
   issn = {15819175 (ISSN)},
   issue = {1},
   journal = {Acta Agriculturae Slovenica},
   keywords = {AM fungi,Bacteria (microorganisms),Fungi,Inoculation,Intercropping,Nitrogen,Phosphorus,Rhizobacteria,Rhizobiales,Rhizobium,Root area,Root dry mass,Root length,Zea mays,arbuscular mycorrhiza,concentration (composition),dry matter,fungus,inoculation,intercropping,legume,maize,phosphorus,rhizobacterium},
