@article{Novak2013,
   abstract = {The Inra has introduced a new research programme for designing and evaluating an innovative forage system, co-developed by researchers and socio-professional partners. The objective of this new system consists in producing milk in a context of climate change, while minimizing the use of raw materials from threatened sources and contributing to sustainable farming. This new system, OasYs, involves an agro-ecological approach: diversification of forage (species, mixtures, periods of production, end uses...), in link with farming systems in order to promote the resilience of this system and make the most of environmental strata. This system will help preserve water resources and fossil energy (by promoting grazing, legumes, water and nutrient recycling...). Adjusting animal requirements (calving periods and animal genetics, lactation phase) is another option being studied. © 2013 Association Francaise pour la Production Fourragere. All rights reserved.},
   author = {S Novak and R Delagarde and J.-L. Fiorelli},
   issn = {04292766 (ISSN)},
   issue = {215},
