@article{Gulka2020,
   abstract = {Resumo Apresenta a importância da conferência de qualidade dos metadados na melhoria dos periódicos científicos institucionais da Universidade Federal de Santa Catarina (UFSC). Essa certificação trata da representação dos metadados publicados em diferentes espaços digitais para identificar um mesmo artigo científico em um periódico. Avalia o serviço oferecido de Conferência de nova edição do Portal de Periódicos UFSC, sob o ponto de vista do editor.  Utiliza como método a descrição de processo e avaliação de serviço no espaço temporal de 2017 e 2018. Conclui que a conferência de qualidade foi percebida pelos editores dos periódicos da UFSC como um serviço que melhora a qualidade da revista. Aponta as vantagens e desvantagens de ter metadados consistentes garantindo uma recuperação da informação mais eficiente, a interoperabilidade entre sistemas, a preservação digital dos documentos, facilita a indexação de periódicos e promove as estruturas linked data por meio da web semântica.},
   author = {Juliana Aparecida Gulka and Lúcia da Silveira},
   issn = {2175-2850},
   issue = {1},
   journal = {RevIU. Revista Informação \& Universidade},
   keywords = {Artigos científicos,Certificação,Metadados,Portal de Periódicos},
   month = {10},
   pages = {1-10},
   title = {Revisão de metadados para consistência de artigos publicados em acesso aberto},
   volume = {2},
   url = {http://reviu.febab.org.br/index.php/reviu/article/view/11 http://reviu.febab.org.br/index.php/reviu/article/download/11/10},
   year = {2020}
}
@article{Stec2016,
   abstract = {Abscisic acid (ABA) is an ubiquitous plant hormone and one of the foremost signalling molecules, controlling plants' growth and development, as well as their response to environmental stresses. To date, the function of ABA has been extensively investigated as an abiotic stress molecule which regulates the plants' water status. However, in the context of symbiotic associations, ABA is less recognized. In contrast to well-described auxin/cytokinin and gibberellin/strigolactone involvement in symbioses, ABA has long been underestimated. Interestingly, ABA emerges as an important player in arbuscular mycorrhiza and legume-rhizobium symbiosis. The plant's use of stress hormones like ABA in regulation of those interactions directly links the efficiency of these processes to the environmental status of the plant, notably during drought stress. Here we provide an overview of ABA interplay in beneficial associations of plants with microorganisms and propose ABA as a potential factor determining whether the investment in establishing the interaction is higher than the profit coming from it.},
   author = {N Stec and J Banasiak and M Jasiński},
   doi = {10.18388/abp.2015_1210},
   issn = {0001527X (ISSN)},
   issue = {1},
   journal = {Acta Biochimica Polonica},
   keywords = {Abscisic Acid,Abscisic acid,Arbuscular mycorrhiza,Mycorrhizae,Nodulation,Plants,Rhizobium,Symbioses,Symbiosis,abscisic acid,metabolism,microbiology,mycorrhiza,physiology,plant,symbiosis},
