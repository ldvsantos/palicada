@article{Tormen2005,
   abstract = {This research aimed to analyze the entrepreneurial potential of students of a higher education institution (HEI) Private from the Carland Entrepreneurship Index Model (IEC). The sample consists of 205 students of Business Administration courses, Accounting, Foreign Trade, Technology in Logistics and Commercial Management, a private institution in the state of Santa Catarina. The methodology was chosen descriptive research through a survey of quantitative data approach. Therefore, data collection used the survey instrument proposed by Carland and Carland (1996) consists of 33 pairs of closed questions that measure the pontecial entrepreneur through four dimensions: personality traits (TP), propensity to innovation (PI), propensity to risk (PR) and the strategic posture (PE). In the data analysis spreadsheets and descriptive statistics. The results show that among the students surveyed identified the presence of the potential entrepreneur as the scale of the ERC in its four dimensions. We also observed the predominance of entrepreneurial category present in 81.46% of respondents, followed by the microenterprise category with 17.56% and the category macro entrepreneur with 0.97%. These findings further confirm the results of other empirical studies that applied the CIS in different cultural contexts.},
   author = {Juthielli Tormen},
   issue = {2},
   keywords = {Importante},
   pages = {9},
   title = {Potencial empreendedor dos estudantes das Ciências Sociais Aplicadas de uma instituição de ensino superior sob a ótica do Carland Entrepreneurship Index (CEI)},
   volume = {8},
   year = {2005}
}
@article{Soyano2014,
   abstract = {The symbiosis with nitrogen-fixing bacteria leading to root nodules is a relatively recent evolutionary innovation and limited to a distinct order of land plants. It has long been a mystery how plants have invented this complex trait. However, recent advances in molecular genetics of model legumes has elucidated genes involved in the development of root nodules, providing insights into this process. Here we discuss how the de novo assembly of transcriptional networks may account for the predisposition to nodulate. Transcriptional networks and modes of gene regulation from the arbuscular mycorrhizal symbiosis, nitrate responses and aspects of lateral root development have likely all contributed to the emergence and development of root nodules. © 2014 Elsevier Ltd.},
   author = {T Soyano and M Hayashi},
   doi = {10.1016/j.pbi.2014.07.010},
   issn = {13695266 (ISSN)},
   journal = {Current Opinion in Plant Biology},
   keywords = {Biological Evolution,Gene Expression Regulation, Plant,Gene Regulatory Networks,Mycorrhizae,Plant Physiological Phenomena,Root Nodules, Plant,Symbiosis,evolution,gene expression regulation,gene regulatory network,microbiology,mycorrhiza,nodulation,physiology,plant physiology,symbiosis},
   note = {Cited By :31<br/><br/><br/><br/>CODEN: COPBF<br/><br/><br/><br/>Correspondence Address: Hayashi, M.; Plant Symbiosis Research Unit, National Institute of Agrobiological Sciences, Tsukuba, Ibaraki 305-3602, Japan; email: makotoh@affrc.go.jp<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding details: Japan Society for the Promotion of Science, JSPS, GS029<br/><br/><br/><br/>Funding text 1: We thank Giles Oldroyd of John Innes Centre for critical reading and contributions to the manuscript. This work was supported by the Funding Program for Next Generation World-Leading Researchers from the Japan Society for the Promotion of Science ( GS029 ).<br/><br/><br/><br/>References: Oldroyd, G.E., Murray, J.D., Poole, P.S., Downie, J.A., The rules of engagement in the legume-rhizobial symbiosis (2011) Annu Rev Genet, 45, pp. 119-144; <br/>Pawlowski, K., Demchenko, K.N., The diversity of actinorhizal symbiosis (2012) Protoplasma, 249, pp. 967-979;<br/>Soltis, D.E., Soltis, P.S., Morgan, D.R., Swensen, S.M., Mullin, B.C., Dowd, J.M., Martin, P.G., Chloroplast gene sequence data suggest a single origin of the predisposition for symbiotic nitrogen fixation in angiosperms (1995) Proc Natl Acad Sci U S A, 92, pp. 2647-2651;<br/>Doyle, J.J., Phylogenetic perspectives on the origins of nodulation (2011) Mol Plant Microbe Interact, 24, pp. 1289-1295;<br/>Svistoonoff, S., Hocher, V., Gherbi, H., Actinorhizal root nodule symbioses: what is signalling telling on the origins of nodulation? (2014) Curr Opin Plant Biol, 20, pp. 11-18;<br/>Gutjahr, C., Parniske, M., Cell and developmental biology of arbuscular mycorrhiza symbiosis (2013) Annu Rev Cell Dev Biol, 29, pp. 593-617;<br/>Yokota, K., Hayashi, M., Function and evolution of nodulation genes in legumes (2011) Cell Mol Life Sci, 68, pp. 1341-1351;<br/>Hirsch, A.M., LaRue, T.A., Is the legume nodule a modified root or stem or an organ sui generis? (1997) Crit Rev Plant Sci, 16, pp. 361-392;<br/>Szczyglow