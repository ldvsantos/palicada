@article{Lyda2017,
   abstract = {Spider major ampullate silk fibers have been shown to display a unique combination of relatively high fracture strength and toughness compared to other fibers and show potential for tissue engineering scaffolds. While it is not possible to mass produce native spider silks, the potential ability to produce fibers from recombinant spider silk fibers could allow for an increased innovation rate within tissue engineering and regenerative medicine. In this pilot study, we improved upon a prior fabrication route by both changing the expression host and additives to the fiber pulling precursor solution to improve the performance of fibers. The new expression host for producing spidroin protein mimics, protozoan parasite Leishmania tarentolae, has numerous advantages including a relatively low cost of culture, rapid growth rate and a tractable secretion pathway. Tensile testing of hand pulled fibers produced from these spidroin-like proteins demonstrated that additives could significantly modify the fiber’s mechanical and/or antimicrobial properties. Cross-linking the proteins with glutaraldehyde before fiber pulling resulted in a relative increase in tensile strength and decrease in ductility. The addition of ampicillin into the spinning solution resulted in the fibers being able to inhibit bacterial growth.},
   author = {Todd A Lyda and Elizabeth L Wagner and Andre X Bourg and Congyue Peng and Golnaz Najaf Tomaraei and Delphine Dean and Marian S Kennedy and William R Jr.Marcotte},
   doi = {10.1371/journal.pone.0178201},
   issn = {19326203},
   issue = {5},
   journal = {PLoS ONE},
   keywords = {Agriculture,Animal products,Animals,Arachnida,Arthropoda,Bacterial growth,Bacterial physiology,Bacteriology,Biochemistry,Biology and life sciences,Cell biology,Cell processes,Chemical bonding,Chemistry,Cross-linking,Developmental biology,FRACTURE strength,FRACTURE toughness,Invertebrates,Leishmania,Medicine and health sciences,Microbial growth and development,Microbial physiology,Microbiology,Organisms,Parasitic protozoans,Pathogens,Pathology and laboratory medicine,Physical chemistry,Physical sciences,Protein secretion,Protein transport,Proteins,Protozoans,Recombinant proteins,Research Article,SECRETION,SILK fibroin,Secretion systems,Silk,Spiders,TISSUE engineering,Virulence factors},
   month = {11},
   pages = {1-15},
   title = {A Leishmania secretion system for the expression of major ampullate spidroin mimics},
   volume = {12},
   url = {http://search.ebscohost.com/login.aspx?direct=true&db=aph&AN=123179664&lang=pt-br&site=ehost-live http://content.ebscohost.com/ContentServer.asp?T=P&P=AN&K=123179664&S=R&D=aph&EbscoContent=dGJyMNLe80SeprM4zOX0OLCmsEiep65Sr6a4SbCWxWXS&ContentCustomer=dGJyM},
   year = {2017}
}
