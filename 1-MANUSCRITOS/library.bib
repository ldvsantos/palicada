@article{Garrett2020,
   abstract = {We propose combining the filter framework model of community assembly with the passenger-driver model of non-native species behavior to help clarify the impacts of invasive species in the communities they invade and to guide sustainable management protocols. Observational field surveys and a greenhouse experiment explored the role of the invasive legume Lespedeza cuneata in the communities it invades and how natives in three functional groups-grasses, forbs, and legumes-respond to its presence. Within-site analyses from the field survey revealed differences in invaded and uninvaded areas in half of the sites, suggesting that site-specific characteristics influences whether L. cuneata's presence corresponds to local differences in species composition. The greenhouse experiment found higher levels of saprophytic and arbuscular mycorrhizal fungi in soil conditioned by L. cuneata than in unconditioned soil. However, competition between L. cuneata or the native congener L. capitata and nine native species illustrated stronger aboveground competitive effects than belowground soil effects due to soil conditioning, with impacts differing among functional groups. The response of L. cuneata was reduced in the presence of grasses and other legumes but not forbs. Assessing the impact of L. cuneata with the combined community assembly model revealed this invasive plant acts as a driver because it alters abiotic and biotic filters to impact species composition. Managing for high grass abundance and planting native legumes will help sustain grasslands from L. cuneata invasion. © 2020 by the authors.},
   author = {E M Garrett and D J Gibson},
   doi = {10.3390/SU12155951},
   issn = {20711050 (ISSN)},
   issue = {15},
   journal = {Sustainability (Switzerland)},
   keywords = {Fungi,Lespedeza cuneata,Poaceae,aboveground biomass,arbuscular mycorrhiza,belowground biomass,biological invasion,community structure,competition,field survey,filter model,functional group,fungus,grass,grassland,identification method,invasive species,management practice,native species,passenger-driver model,plant-soil feedback,sustainability,sustainable management},
   note = {Correspondence Address: Gibson, D.J.; School of Biological Sciences, Southern Illinois UniversityUnited States; email: djgibson@siu.edu<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding details: Illinois Department of Natural Resources, IDNR<br/><br/><br/><br/>Funding text 1: This research was funded by the Illinois Association of Environmental Professionals. Permission to conduct the field work was obtained from the U.S Fish andWildlife Service, Illinois Department of Natural Resources, Illinois Nature Preserves Commission, University of Illinois Extension, and Shawnee National Forest. The greenhouse experiment was conducted in the Horticultural Research Center, SIUC.<br/><br/><br/><br/>References: Díaz, S., Cabido, M., Casanoves, F., Plant functional traits and environmental filters at a regional scale (1998) J. Veg. Sci., 9, pp. 113-122; <br/>Gibson, D.J., Allstadt, A.J., Baer, S.G., Geisler, M., Effects of foundation species genotypic diversity on subordinate species richness in an assembling community (2012) Oikos, 121, pp. 496-507;<br/>Keddy, P.A., Assembly and response rules-2 goals for predictive community ecology (1992) J. Veg. Sci., 3, pp. 157-164;<br/>Seastedt, T.R., Pyšek, P., Mechanisms of plant invasions of North American and European grasslands (2011) Annu. Rev. Ecol. Evol. Syst., 42, pp. 133-153;<br/>Temperton, M.V., Hobbs, R.J., The search for ecological assembly rules and its relevance to restoration ecology (2004) In Assembly Rules and Restoration Ecology: Bridging the Gap between Theory and Practic, pp. 34-54. , Temperton, V.M., Ed.; Island Press: Washington, DC, USA;<br/>Wilson, D.S., Pinno, B.D., Environmentally-contingent behaviour of invasive plants as drivers or passengers (2013) Oikos, 122, pp. 129-135;<br/>MacDougall, S.A., Turkington, R., Are invasive species the drivers or passengers of change in degraded ecosystems? (2005) Ecology, 86, pp. 42-55;<br/>Kulmatiski, A., Beard, K.H., Decoupling plant-growt