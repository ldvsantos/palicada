   pages = {1084-1090},
   publisher = {Editura Universitatii din Pitesti},
   title = {Implementation of sustainable development in borussia dortmund gmbh\&co.Kgaa},
   volume = {21},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85105804758&doi=10.7752%2Fjpes.2021.s2136&partnerID=40&md5=aa549e62a51b5867fa34f2b243a96ab5},
