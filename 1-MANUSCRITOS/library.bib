@book{Veer1996,
   abstract = {Trata-se de um verdadeiro tratado sobre a vida e a obra de Vygotsky, que mostra a complexidade da história de suas ideias, tentando resgatar o vigor original de suas teorias. O estudo foi feito a partir de dados inéditos e das cópias originais dos trabalhos de Vygotsky da e da própria correspondência do pensador russo. Desta forma os autores desmascaram mitos infundados, que com o objetivo de apresentar Vygotsky como um guru da psicologia russa, oferecem uma interpretação redutiva de suas obras, não percebendo o caráter multifacético de seu pensamento e sua abordagem predominantemente evolucionária de todos os fenômenos psicológicos. Índice/Index: 1. Os primeiros anos em Moscou 2. A teoria histórico-cultural 3. Moscou, Kharkov e Leningrado},
   author = {René van der Veer and Jaan Valsiner},
   isbn = {978-85-15-01275-6},
   pages = {488},
   publisher = {Edicoes Loyola},
   title = {Vygotsky - Uma síntese},
   url = {https://books.google.com.br/books?id=eTjmewWdpNAC},
   year = {1996}
}
@article{Nanjareddy2014,
   abstract = {Nitrogen-limited conditions are considered to be a prerequisite for legume-rhizobial symbiosis, but the effects of nitrate-rich conditions on symbiotic status remain poorly understood. We addressed this issue by examining rhizobial (Rhizobim tropici) and arbusclar mycorrhizal (Glomus intraradices) symbiosis in Phaseolus vulgaris L. cv. Negro Jamapa under nitrate pre-incubation and continuous nitrate conditions. Our results indicate that nitrate pre-incubation, independent of the concentration, did not affect nodule development. However, the continuous supply of nitrate at high concentrations impaired nodule maturation and nodule numbers. Low nitrate conditions, in addition to positively regulating nodule number, biomass, and nitrogenase activity, also extended the span of nitrogen-fixing activity. By contrast, for arbuscular mycorrhizae, continuous 10 and 50mmol/L nitrate increased the percent root length colonization, concomitantly reduced arbuscule size, and enhanced ammonia transport without affecting phosphate transport. Therefore, in this manuscript, we have proposed the importance of nitrate as a positive regulator in promoting both rhizobial and mycorrhizal symbiosis in the common bean. © 2014 Institute of Botany, Chinese Academy of Sciences.},
   author = {K Nanjareddy and L Blanco and M.-K. Arthikala and X A Affantrange and F Sánchez and M Lara},
   doi = {10.1111/jipb.12156},
   issn = {16729072 (ISSN)},
   issue = {3},
   journal = {Journal of Integrative Plant Biology},
   keywords = {Ammonium Compounds,Arbuscular,Arbuscule,Biomass,Cell Size,Colony Count, Microbial,Common bean,Gene Expression Regulation, Plant,Glomus intraradices,Membrane Proteins,Membrane Transport Proteins,Mycorrhiza,Mycorrhizae,Nitrate,Nitrates,Nitrogen Fixation,Nitrogenase,Nodule,Phaseolus,Phaseolus vulgaris,Phenotype,Phosphorus,Plant Proteins,Plant Shoots,Rhizobium,Root Nodules, Plant,Symbiosis,ammonia,ammonium derivative,arbuscule,article,bacterial count,biomass,carrier protein,cell size,common bean,drug effect,enzyme activity,gene expression regulation,genetics,growth, development and aging,legume,membrane protein,metabolism,microbiology,mycorrhiza,nitrate,nitric acid derivative,nitrogen fixation,nitrogenase,nodulation,nodule,nodulin,phenotype,phosphorus,physiology,plant,rhizobacterium,symbiosis,transport process,vegetable protein},
