@article{,
   abstract = {Due to its potential thermal degradation or polymorphic transformation, thermal stability of a food additive may limit its use in food preparations, when heating process is involved. In this paper, we present an investigation on thermal behavior of sodium cyclamate, one of the most frequently used components in tabletop sweeteners. Thermogravimetric data revealed that sodium cyclamate exists in two polymorphic forms: sodium cyclamate di-hydrated (C6H12NSO3NaÁ2H2O) and anhydrous sodium cyclamate (C6H12NSO3Na). X-ray powder diffraction data revealed that hydrate and anhydrate sodium cyclamate are true polymorphs. Under heating conditions, the hydrated form dehydrated in a complex multiple-step process. Finally, thermal decomposition of sodium cyclamate was studied and a degradation mechanism is proposed. At 170 °C, sodium cyclamate sublimates and dimerizes, by condensation of two cyclamate moieties, leading to formation of highly pure N,N-diciclohexyl sulfamide, a potential anxiolytic compound.},
   author = {D A V Medina and A P G Ferreira and E T G Cavalheiro},
   doi = {10.1007/s10973-019-08037-7},
   issn = {1388-6150, 1588-2926},
   title = {Polymorphism and thermal behavior of sodium cyclamate},
   url = {http://link.springer.com/10.1007/s10973-019-08037-7}
}
