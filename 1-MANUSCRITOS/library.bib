@article{Santos2019b,
   abstract = {Este trabalho tratou de identificar as características associadas da carne de sol produzida no município Itororó, Bahia, Brasil, com objetivo de demonstrar a potencialidade de registro de Indicação Geográfica (IG) para o território abrangido pelo município. A pesquisa foi dividida em duas partes, diferenciação do produto e a determinação de área de indicação geográfica. Feita a revisão bibliográfica, foram comparadas as ações e características existentes do município em questão, bem como em relação ao produto. Assim ficou sinalizada a potencialidade do território do município de Itororó-BA em obter a proteção industrial pela Indicação Geográfica para o produto alimentício "carne do sol".},
   author = {Joelito Cruz Santos and Wagna Piler Carvalho dos Santos},
   doi = {10.9771/cp.v12i1.27215},
   issn = {2317-0026},
   issue = {1},
   journal = {Cadernos de Prospecção},
   month = {1},
   pages = {231},
   title = {Contribuições para indicação geográfica (IG): considerações sobre Itororó - BA como uma potencial ig para carne do sol},
   volume = {12},
   url = {https://cienciasmedicasbiologicas.ufba.br/index.php/nit/article/view/27215 https://cienciasmedicasbiologicas.ufba.br/index.php/nit/article/download/27215/16975},
   year = {2019}
}
