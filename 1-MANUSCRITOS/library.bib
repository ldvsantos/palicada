@article{Dusek2019,
   abstract = {This paper deals with a source market size estimation tool that is based on a combination of geomarketing information and consumer spending datasets. We have decided to apply a proposed estimation method on three consumption expenditure groups that are related to the tourism and hospitality industry in the Czech Republic. The geographic and consumer spending data sets for the period 2011 - 2016 were drawn from publicly available sources. With the use of GIS software, this method allowed us to estimate and graphically display consumer spending on recreation and culture; restaurants and hotels; and transport in 2016 at the level of Czech districts, as well as the average annual growth rate during the period 2011 - 2016. This paper describes the Czech tourism and hospitality market from its size and growth point of view. It shows the trends in expenditures for hospitality and tourism services, explain the purchasing power in Czech regions and districts and predict the development for next few years. The results obtained by this low-cost method can be easily used by enterprises from the Czech Republic within domestic tourism, as well as by the foreign companies wanting to attract Czech visitors. © 2019 People and Global Business Association.},
   author = {R Dušek and P Štumpf and V Vojtko},
   doi = {10.17549/gbfr.2019.24.1.14},
   issue = {1},
   journal = {Global Business and Finance Review},
   keywords = {Consumer behaviour,GIS software,Geomarketing,Hospitality,SMEs,Tourism},
   pages = {14-26},
   title = {Geomarketing - tool for consumer spending estimation in the Czech tourism \& hospitality market},
   volume = {24},
   url = {http://www.scopus.com/record/display.uri?eid=2-s2.0-85065473585&origin=resultslist&sort=plf-f&src=s&st1=%22low+cost%22&st2=Hotel&sid=cd813dec5e5f278714b0616b2b9cc793&sot=b&sdt=b&sl=93&s=%28TITLE-ABS-KEY%28%22low+cost%22%29+AND+TITLE-ABS-KEY%28Hotel%29%29+},
   year = {2019}
}
@article{Hasan2020,
   abstract = {Jute fibre is the second most important fibre next to cotton. It is obtained from the bark of plant through microbial retting process. Here we report optimized microbial retting protocol that can lower retting period and produce high fibre quality. A total of 451 bacterial colonies have been isolated from five jute retting water samples in Bangladesh. Higher pectinolytic bacterial isolates were predominant in the later stage of jute retting. Out of these, 168 isolates have been screened by both semi-quantitative and quantitative pectinase, xylanase and cellulase enzyme assay. Among them, 144 isolates have been selected on the basis of extra cellular enzyme activity of these three enzymes. 16 s ribosomal gene sequencing analysis identified 2 phyla- Firmicutis (80.55%) and Proteobacteria (19.45%). To check the synergistic and antagonistic effect 10 selected isolates were tested in 167 different combinations. Three best combinations were identified that lowered retting period from 18–21 days to 10 days producing high quality fibre in both laboratory and field trial. This improved retting technology can be adopted in industrial scale for the production of quality jute fibre in a controlled condition in reduced water quantity without polluting the environment. © 2020, The Author(s).},
   author = {R Hasan and N Aktar and S M T Kabir and U Honi and A Halim and R Islam and M D H Sarker and M S Haque and M M Alam and M S Islam},
   doi = {10.1038/s41598-020-61898-z},
   issue = {1},
   journal = {Scientific Reports},
   title = {Pectinolytic Bacterial Consortia Reduce Jute Retting Period and Improve Fibre Quality},
   volume = {10},
   year = {2020}
}
@article{Quadros2017,
   abstract = {A extração de areia no leito do rio Jacuí tem sido a principal responsável pelo atendimento á demanda deste bem mineral para atender a construção civil do Rio Grande do Sul. Tal atividade tem sido responsabilizada pelos processos erosivos observados, principalmente, nas margens desse rio. Esse artigo traz informações e considerações técnicas baseadas em observações e estudos de campo, e em experimentos expeditos de laboratório, a respeito dos fatores antrópicos e dos fatores naturais que influenciam na erosão das margens do rio Jacuí. Tais observações são discutidas a luz do conhecimento científico, no sentido de fornecer um melhor entendimento dos processos erosivos atuantes no rio e dar sustentação aos estudos de campo e às conclusões apresentadas. O trabalho identificou atividades antrópicas e processos naturais que contribuem para a erosão das margens observadas no rio Jacuí.},
   author = {Telmo Fernando Perez de Quadros},
   doi = {10.18316/rca.v11i1.3179},
   issn = {1981-8858},
   issue = {1},
   journal = {Revista de Ciências Ambientais},
   keywords = {Anthropogenic Actions in the Environment.,Ações Antrópicas no Meio Ambiente.,Dinâmica Fluvial,Environment,Erosão de Margem Fluvial,Meio Ambiente,Mineração,Mining,River Bank Erosion,River Dynamics},
   month = {11},
   pages = {49-64},
   title = {Efeito da dinâmica fluvial e da ação antrópica sobre a erosão de margens fluviais: o caso da mineração de areia no rio Jacuí},
   volume = {11},
   url = {https://www.revistas.unilasalle.edu.br/index.php/Rbca/article/view/3179 https://revistas.unilasalle.edu.br/index.php/Rbca/article/download/3179/pdf},
   year = {2017}
}
