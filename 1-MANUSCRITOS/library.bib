@article{Aquino2020,
   abstract = {Resumo A pandemia de COVID-19 tem desafiado pesquisadores e gestores a encontrar medidas de saúde pública que evitem o colapso dos sistemas de saúde e reduzam os óbitos. Esta revisão narrativa buscou sistematizar as evidências sobre o impacto das medidas de distanciamento social na epidemia de COVID-19 e discutir sua implementação no Brasil. Foram triados artigos sobre o efeito do distanciamento social na COVID-19 no PubMed, medRXiv e bioRvix, e analisados atos do poder público nos níveis federal e estadual para sumarizar as estratégias implementadas no Brasil. Os achados sugerem que o distanciamento social adotado por população é efetivo, especialmente quando combinado ao isolamento de casos e à quarentena dos contatos. Recomenda-se a implementação de medidas de distanciamento social e de políticas de proteção social para garantir a sustentabilidade dessas medidas. Para o controle da COVID-19 no Brasil, é imprescindível que essas medidas estejam aliadas ao fortalecimento do sistema de vigilância nos três níveis do SUS, que inclui a avaliação e uso de indicadores adicionais para monitorar a evolução da pandemia e o efeito das medidas de controle, a ampliação da capacidade de testagem, e divulgação ampla e transparente das notificações e de testagem desagregadas.},
   author = {Estela M L Aquino and Ismael Henrique Silveira and Julia Moreira Pescarini and Rosana Aquino and Jaime Almeida de Souza-Filho and Aline dos Santos Rocha and Andrea Ferreira and Audêncio Victor and Camila Teixeira and Daiane Borges Machado and Enny Paixão and Flávia Jôse Oliveira Alves and Flávia Pilecco and Greice Menezes and Ligia Gabrielli and Luciana Leite and Maria da Conceição Chagas de Almeida and Naiá Ortelan and Qeren Hapuk R Ferreira Fernandes and Renzo Joel Flores Ortiz and Raquel Nunes Palmeira and Elzo Pereira Pinto Junior and Erika Aragão and Luis Eugenio Portela Fernandes de Souza and Manoel Barral Netto and Maria Glória Teixeira and Mauricio Lima Barreto and Maria Yury Ichihara and Raíza Tourinho dos Reis Silva Lima},
   doi = {10.1590/1413-81232020256.1.10502020},
   issn = {1413-8123, 1413-8123, 1678-4561},
   journal = {Ciência \& Saúde Coletiva},
   keywords = {COVID-19,Distanciamento social,Pandemias,Vigilância epidemiológica},
   month = {8},
   pages = {2423-2446},
   title = {Medidas de distanciamento social no controle da pandemia de COVID-19: potenciais impactos e desafios no Brasil},
   volume = {25},
   url = {https://www.scielosp.org/article/csc/2020.v25suppl1/2423-2446/pt/ https://www.scielosp.org/article/ssm/content/raw/?resource_ssm_path=/media/assets/csc/v25s1/en_1413-8123-csc-25-s1-2423.pdf},
