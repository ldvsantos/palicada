@article{Foo2014,
   abstract = {All of the classical plant hormones have been suggested to influence nodulation, including some that interact with the Autoregulation of Nodulation (AON) pathway. Leguminous plants strictly regulate the number of nodules formed through this AON pathway via a root-shoot-root loop that acts to suppress excessive nodulation. A related pathway, the Autoregulation of Mycorrhization (AOM) pathway controls the more ancient, arbuscular mycorrhizal (AM) symbiosis. A comparison of the published responses to the classical hormones in these 2 symbioses shows that most influence the symbioses in the same direction. This may be expected if they affect the symbioses via common components of these symbiotic regulatory pathways. However, some hormones influence these symbioses in opposite directions, suggesting a more complex relationship, and probably one that is not via the common components of these pathways. In a recent paper we showed, using a genetic approach, that strigolactones and brassinosteroids do not act downstream of the AON genes examined and argued that they probably act independently to promote nodule formation. Recently it has been shown that the control of nodulation via the AON pathway involves mobile CLE peptide signals. It is therefore suggested that a more direct avenue to determine if the classical hormones play a direct role in the autoregulatory pathways is to further examine whether CLE peptides and other components of these processes can influence, or be influenced by, the classical hormones. Such studies and other comparisons between the nodulation and mycorrhizal symbioses should allow the role of the classical hormones in these critical symbioses to be rapidly advanced. © 2014 Landes Bioscience.},
   author = {E Foo and B J Ferguson and J B Reid},
   doi = {10.4161/psb.29593},
   issn = {15592316 (ISSN)},
   issue = {9},
   journal = {Plant Signaling and Behavior},
   keywords = {Arbuscular mycorrhizae,Autoregulation of nodulation,Development,Fabaceae,Gibberellins,Mycorrhizae,Nodule,Plant Growth Regulators,Plant Root Nodulation,Signal Transduction,Symbiosis,genetics,microbiology,mycorrhiza,nodulation,physiology,phytohormone,signal transduction,symbiosis},
   note = {Chemicals/CAS: Plant Growth Regulators<br/><br/><br/><br/>Cited By :14<br/><br/><br/><br/>Correspondence Address: Foo, E.; School of Biological Sciences, University of TasmaniaAustralia<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding details: Australian Research Council, Australian Research Council, DP130103084, DP140101709, DP130102266<br/><br/><br/><br/>Funding text 1: We wish to thank Prof Peter Gresshofffor careful reading of the manuscript.Due to the research field being so large many articles had to be left out, for which we apologize. This work was supported by the Australian Research Council for provision of Discovery Project grants to E.F. and J.B.R. (DP140101709) and to B.J.F. (DP130103084 and DP130102266).<br/><br/><br/><br/>References: Sprent, J.I., Evolving ideas of legume evolution and diversity: A taxonomic perspective on the occurrence of nodulation (2007) New Phytol, 174, pp. 11-25. , http://dx.doi.org/10.1111/j.1469-8137.2007.02015.x, PMID:17335493; <br/>Szczyglowski, K., Amyot, L., Symbiosis, inventiveness by recruitment? (2003) Plant Physiol, 131, pp. 935-940. , http://dx.doi.org/10.1104/pp.017186, PMID:12644646;<br/>Reid, D.E., Ferguson, B.J., Hayashi, S., Lin, Y.H., Gresshoff, P.M., Molecular mechanisms controlling legume autoregulation of nodulation (2011) Ann Bot, 108, pp. 789-795. , http://dx.doi.org/10.1093/aob/mcr205, PMID:21856632;<br/>Staehelin, C., Xie, Z.P., Illana, A., Vierheilig, H., Longdistance transport of signals during symbiosis: Are nodule formation and mycorrhization autoregulated in a similar way? (2011) Plant Signal Behav, 6, pp. 372-377. , http://dx.doi.org/10.4161/psb.6.3.13881, PMID:21455020;<br/>Ryu, H., Cho, H., Choi, D., Hwang, I., Plant hormonal regulation of nitrogen-fixing nodule organogenesis (2012) Mol Cells, 34, pp. 117-126. , http://dx.doi.org/10.1007/s10059-012-0131-1, PMID:22820920;<br/>Foo, E., Ross, J.J., Jones, W.T., Reid, J.B., Plant hormones in arbuscular mycorrhizal 