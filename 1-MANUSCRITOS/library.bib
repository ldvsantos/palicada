@article{Pereira2019a,
   abstract = {A Internet das Coisas (IoT), solução que permite a conexão entre diferentes objetos através da rede mundial de computadores, oferece às empresas de alimentos e bebidas um vasto potencial para otimização de suas operações. Ao mesmo tempo, o setor de panificação e confeitaria brasileiro é impelido a adotar novas tecnologias, visando o aumento do seu diferencial competitivo e inovativo. Dentro deste contexto, o presente artigo teve como objetivo realizar a prospecção tecnológica de soluções do sistema Iot com potencial de aplicação no setor de panificação, sendo para isso levantadas as patentes depositadas no INPI e no Questel Orbit e as produções cientificas presentes nas plataformas CAPES e Scielo. A prospecção aponta para um crescimento mundial nas pesquisas e desenvolvimento de produtos que relacionam IoT e alimentação, principalmente na China. O Brasil, apresenta um cenário incipiente no desenvolvimento dessas tecnologias, embora já existam algumas iniciativas do poder público e da indústria.},
   author = {Beneildo Rodrigues Oliveira Pereira and Silvia Uchoa and Clodoaldo Nascimento and João Santos and Ramon Cardeal Silva and Jéssica Caroline Rodrigues de Lima},
   doi = {10.9771/cp.v12i1.27220},
   issn = {2317-0026},
   issue = {1},
   journal = {Cadernos de Prospecção},
   keywords = {Internet das coisas,Panificação,Prospecção.},
   month = {5},
   pages = {92},
   title = {SMART BAKERY: ESTUDO PROSPECTIVO SOBRE INTERNET DAS COISAS (IOT) APLICADAS AO SETOR DE PANIFICAÇÃO},
   volume = {12},
   url = {https://portalseer.ufba.br/index.php/nit/article/view/27220 https://portalseer.ufba.br/index.php/nit/article/download/27220/16964},
   year = {2019}
}
