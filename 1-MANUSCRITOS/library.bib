   issue = {3},
   journal = {REVISTA COMUNICACAO MIDIATICA},
   keywords = {advertising,azon,brand,environmentalism},
   pages = {105-118},
   title = {AMAZON BRAND STRATEGIES COMMUNICATION PUBLICITARIA ENVIRONMENTALISM AND SUSTAINABILITY},
   volume = {10},
