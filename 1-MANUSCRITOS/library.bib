@article{Kahlon2017,
   abstract = {Genetically modified crops have raised concerns about unintended consequences on non-target organisms including beneficial soil associates. Pea transformed with four antifungal genes 1-3 β glucanase, endochitinase, polygalacturonase-inhibiting proteins, and stilbene synthase is currently under field-testing for efficacy against fungal diseases in Canada. Transgenes had lower expression in the roots than leaves in greenhouse experiment. To determine the impact of disease-tolerant pea or gene products on colonization by non-target arbuscular mycorrhizae and nodulation by rhizobium, a field trial was established. Transgene insertion, as single gene or stacked genes, did not alter root colonization by arbuscular mycorrhiza fungus (AMF) or root nodulation by rhizobium inoculation in the field. We found no effect of transgenes on the plant growth and performance although, having a dual inoculant with both AMF and rhizobium yielded higher fresh weight shoot-to-root ratio in all the lines tested. This initial risk assessment of transgenic peas expressing antifungal genes showed no deleterious effect on non-target organisms. © 2017, Springer-Verlag Berlin Heidelberg.},
   author = {J G Kahlon and H.-J. Jacobsen and J F Cahill  Jr. and L M Hall},
   doi = {10.1007/s00572-017-0781-0},
   issn = {09406360 (ISSN)},
   issue = {7},
   journal = {Mycorrhiza},
   keywords = {Antibiosis,Antifungal genes,Arbuscular mycorrhiza,Canada,Fungi,Gene Expression,Genetically modified,Mycorrhizae,Non-target effects,Peas,Pisum sativum,Plant Diseases,Plant Proteins,Plant Root Nodulation,Plant Roots,Plant Shoots,Plants, Genetically Modified,Rhizobium,Risk assessment,antibiosis,arbuscular mycorrhiza,fungus,gene expression,genetically modified organism,genetics,growth, development and aging,immunology,inhibition,legume,metabolism,microbiology,mycorrhiza,nodulation,pea,physiology,plant disease,plant protein,plant root,protein,rhizobacterium,risk assessment,root colonization,shoot,transgenic plant},
   note = {Chemicals/CAS: Plant Proteins<br/><br/><br/><br/>Cited By :3<br/><br/><br/><br/>CODEN: MCORE<br/><br/><br/><br/>Correspondence Address: Kahlon, J.G.; Agricultural, Food and Nutritional Sciences, 410 Agriculture/Forestry, University of AlbertaCanada; email: Jagroop@ualberta.ca<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding details: Alberta Crop Industry Development Fund, ACIDF<br/><br/><br/><br/>Funding details: Alberta Crop Industry Development Fund, ACIDF<br/><br/><br/><br/>Funding details: Alberta Pulse Growers Commission, APG<br/><br/><br/><br/>Funding details: University of Alberta, U of A<br/><br/><br/><br/>Funding text 1: We greatly acknowledge Lisa Raatz, Judy Irving, Keith Topinka, graduate students, and summer staff at the weed science and environmental biosafety lab at the University of Alberta for assistance with field trial and Dr. Muhammed Rahman, AFNS, University of Alberta, for conducting the gene expression analysis for the project. We are thankful to Premier Tech Technologies (Riviere-Du-Loup, QC) for generously providing us the dual inoculant MYKE? PRO PS3+R and Dr. Deng-Jin Bing, AAFC, Lacombe, for kindly supplying the seed for AC Earlystar and Agassiz for the experiments. The research fund was provided by the Alberta Crop Industry Development Fund Ltd. (ACIDF) and Alberta Pulse Growers (APG). The authors declare that they have no conflict of interest.<br/><br/><br/><br/>References: Albrecht, C., Geurts, R., Bisseling, T., Legume nodulation and mycorrhizae formation: two extremes in host specificity meet (1999) EMBO J, 2, p. 281; <br/>Amian, A.A., Papenbrock, J., Jacobsen, H., Hassan, F., Enhancing transgenic pea (Pisum sativum L.) resistance against fungal diseases through stacking of two antifungal genes (chitinase and glucanase) (2011) GM Crops, 2 (2), pp. 1-6;<br/>Andrews, M., Nitrogen effects on the partitioning of dry matter between shoot and root of higher plants (1993) Curr Topics Plant Physiol, 1, pp