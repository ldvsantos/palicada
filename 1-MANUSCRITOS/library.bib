@article{Kitala2023,
   abstract = {<p>Copper and zinc are micronutrients that play a crucial role in many cellular pathways, act as cofactors in enzymatic systems, and hence, modulate enzyme activity. The regulation of these elements in homeostasis is precisely controlled by various mechanisms. Superoxide dismutase (SOD) is an enzyme requiring both copper and zinc for proper functioning. Additionally, there is an interaction between the concentrations of copper and zinc. Dietary ingestion of large amounts of zinc augments intestinal absorption of this trace element, resulting in copper deficiency secondary to zinc excess. The presence of an overabundance of copper and zinc has a detrimental impact on the cardiovascular system; however, the impact on vascular contractility varies. Copper plays a role in the modulation of vascular remodeling in the cardiac tissue, and the phenomenon of cuproptosis has been linked to the pathogenesis of coronary artery disease. The presence of copper has an observable effect on the vasorelaxation mediated by nitric oxide. The maintenance of proper levels of zinc within an organism influences SOD and is essential in the pathogenesis of myocardial ischemia/reperfusion injury. Recently, the effects of metal nanoparticles have been investigated due to their unique characteristics. On the other hand, dietary introduction of metal nanoparticles may result in vascular dysfunction, oxidative stress, and cellular DNA damage. Copper and zinc intake affect cardiovascular function, but more research is needed.</p>},
   author = {Klaudia Kitala and Damian Tanski and Janusz Godlewski and Magdalena Krajewska-Włodarczyk and Leszek Gromadziński and Michał Majewski},
   doi = {10.3390/nu15133040},
   issn = {2072-6643},
   issue = {13},
   journal = {Nutrients},
   month = {7},
   pages = {3040},
   title = {Copper and Zinc Particles as Regulators of Cardiovascular System Function—A Review},
   volume = {15},
   year = {2023}
}
@article{VieiraBrs2025,
   abstract = {<p> Coffee leaf rust (CLR), caused by the biotrophic fungus <italic>Hemileia vastatrix</italic> , has greatly impacted coffee production worldwide due to reductions in yield. This study investigated the potential use of Re‐leaf® (salicylates [0.69%], copper [0.5%] and zinc [6%]) to reduce CLR severity by boosting host defence reactions. A 2 × 2 factorial experiment was arranged with plants sprayed with water (control) or Re‐leaf (induced resistance [IR] stimulus) and noninoculated or inoculated with <italic>H</italic> . <italic>vastatrix</italic> . In vitro assays showed germ tubes were not formed on urediniospores exposed to IR stimulus at 5–12.5 mL/L and urediniospore germination was significantly lower as rates increased. CLR severity was also significantly reduced compared to the control, with the area under CLR progress curve and intensity of fungal sporulation significantly lower by 96% and 92%, respectively, and incubation period higher by 54% compared to control. The IR stimulus‐sprayed and infected plants showed better photosynthetic performance, preservation of photosynthetic pigments, greater activity of defence‐related enzymes and a more robust antioxidative metabolism compared to water‐sprayed and infected ones. The higher concentration of superoxide anion radical for IR stimulus‐sprayed and infected leaves may intensify cell defence reactions besides having a fungistatic effect. These results strongly support the potential use of IR stimulus to boost defences in coffee tissues and hamper the infection process of <italic>H</italic> . <italic>vastatrix</italic> . Its fungistatic effect against germination of fungal urediniospores should also be considered as a strategy to reduce the amount of inoculum required to start a CLR epidemic under field conditions. </p>},
   author = {Verônica Vieira Brás and Leandro Castro Silva and Bruno Nascimento Silva and Luis Felipe Lata‐Tenesaca and Leonardo Packer Quadros and Fabrício Ávila Rodrigues},
   doi = {10.1111/ppa.14051},
   issn = {0032-0862},
   issue = {3},
   journal = {Plant Pathology},
   month = {4},
   pages = {797-812},
   title = {A compound of salicylates, copper and zinc increases coffee resistance against infection by <i>Hemileia vastatrix</i>},
   volume = {74},
   year = {2025}
}
