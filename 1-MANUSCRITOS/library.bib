@article{Kohler2015,
   abstract = {A field experiment was carried out to assess the effectiveness of combining mycorrhizal inoculation with a native AM fungus (. Glomus sp.) and the addition of an urban organic waste compost (OWC) applied at two rates (0.5 and 2.0% (w:w)), with regard to promoting the establishment of Anthyllis cytisoides L. seedlings in a heavy metal polluted mine tailing, as well as stimulating soil microbial functions. The results showed that the combined use of the highest dose of OWC and AM inoculation significantly increased shoot biomass - by 64% - compared to the control value. However, the separate use of each treatment had no effect on the shoot biomass of this shrub species. At the 2% rate, OWC enhanced root colonisation by the introduced fungus as well as soil nutrient content and soil dehydrogenase and ß-glucosidase activities. The combined treatment increased the uptake of Zn and Mn in shoots, although only Zn reached excessive or potentially toxic levels. This study demonstrates that the combination of organic amendment and an AM fungus is a suitable tool for the phytomanagement of degraded mine tailings, although its effectiveness is dependent on the dose of the amendment. © 2015 Elsevier B.V.},
   author = {J Kohler and F Caravaca and R Azcón and G Díaz and A Roldán},
   doi = {10.1016/j.scitotenv.2015.01.085},
   issn = {00489697 (ISSN)},
   journal = {Science of the Total Environment},
   keywords = {Anthyllis cytisoides,Article,Biodegradation, Environmental,Climate,Composting,Environmental Restoration and Remediation,Fungi,Glomus,Glomus (fungus),Heavy metal contamination,Heavy metals,Legume shrub,Manganese,Metals, Heavy,Mining,Mycorrhizae,Mycorrhizal inoculation,Organic residue,Organic residues,Phyto-stabilisation,Phytostabilisation,Semi-arid climate,Semiarid climate,Soil Microbiology,Soil Pollutants,Soil pollution,Soils,Tailings,Zinc,analysis,arbuscular mycorrhiza,beta glucosidase,biological uptake,biomass,biomass production,bioremediation,chemical analysis,climate,colonization,compost,composting,concentration (parameters),ecosystem restoration,environmental management,environmental monitoring,enzyme activity,enzyme assay,fungal colonization,fungus identification,heavy metal,inoculation,manganese,microbiology,mine tailings,mining,mycorrhiza,mycorrhizal inoculation,nutrient content,nutrient uptake,organic waste compost,oxidoreductase,phytomanagement,plant,plant root,procedures,semiarid region,separation technique,shoot biomass,shrub,soil microflora,soil pollutant,soil pollution,tailings,zinc},
