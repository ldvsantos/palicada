@article{Vieira2015,
   abstract = {O objetivo deste artigo é revelar a importância da política pública de Assistência Técnica e Extensão Rural (ATER) na promoção do desenvolvimento rural sustentável para a agricultura familiar. O problema de pesquisa apresenta o seguinte questionamento: como a política pública de ATER estabelece relação com o desenvolvimento rural sustentável para agricultura familiar? Para tanto, procurou-se compreender a atuação das políticas públicas de ATER; identificar quais as principais diretrizes da Política Nacional de Assistência Técnica e Extensão Rural (PNATER) que contribuem para o desenvolvimento rural sustentável e sugerir ferramentas que auxiliem a ATER na promoção ao processo de desenvolvimento rural sustentável. Com respaldo bibliográfico e documental, com abordagem qualitativa, o artigo realiza uma revisão com viés na atualização da legislação de ATER, vislumbrando perspectivas futuras. Nesta análise, que percorre a trajetória da extensão rural no país, destacam-se os apontamentos que subsidiam as políticas públicas como instrumentos fundamentais para sua execução efetiva. Tal execução prevê a utilização de ferramentais que auxiliem a ATER no fomento ao desenvolvimento da agricultura familiar em três vertentes complementares. Uma vertente sustentável, outra participativa e uma terceira, que se apoia na articulação entre ATER/pesquisa/ensino, tendo como base processo dialógico orientado à comunicação para o meio rural.},
   author = {Silvia Cristina Vieira and Cristiane Hengler Corrêa Bernardo and Ana Elisa Bressan Shimith Lourenzani},
   issn = {2448-0452},
   issue = {1},
   journal = {Revista Eletrônica Competências Digitais para Agricultura Familiar},
   keywords = {Agricultura Familiar,Comunicación Rural,Comunicação Rural,Desarrollo Rural Sostenible,Desenvolvimento Rural Sustentável,Extensión Rural,Extensão Rural,Family farming,Política Pública,Public Policy,Rural Communication,Rural Extension,Sustainable Rural Development},
   month = {11},
   pages = {1-22},
   title = {Política Pública de ATER para o desenvolvimento rural sustentável na Agricultura Familiar},
   volume = {1},
   url = {http://codaf.tupa.unesp.br:8082/index.php/recodaf/article/view/7 http://codaf.tupa.unesp.br:8082/index.php/recodaf/article/download/7/11},
   year = {2015}
}
@article{Komakech2011,
   abstract = {As the pressure on the water resources mounts within a river basin, institutional innovation may occur not as a result of a planned sequence of adjustments, but arising out of the interplay of several factors. By focusing on the basin trajectory this paper illustrates the importance of understanding how local-level institutional arrangements interface with national-level policies and basin-wide institutions. We expand Molle's typology of basin actors responses by explicitly introducing a meso-layer which depicts the interface where State-level and local-level initiatives and responses are played out; and focus on how this interaction finds expression in the creation and modification of hydraulic property rights. We subsequently apply this perspective to the case of Pangani River Basin in Tanzania.The Pangani River Basin development trajectory did not follow a linear path and sequence of responses. Attempts by the state government to establish 'order' in the basin by issuing water rights, levying water fees and designing a new basin institutional set-up have so far proven problematic, and instead generated 'noise' at the interface.So far water resources development in the Pangani has primarily focused on blue water, and the paper shows how investments in infrastructure to control blue water have shaped the relationship between water users, and between water user groups and the State. It remains unknown, however, what the implications will be of widespread investments in improved green water use throughout the basin - not only hydrologically for the availability of blue water, but also socially for the livelihoods of the basin population, and for the evolving relationships between green and blue water users, and between them and the State. The paper concludes with a question: will green water development engender a similar double-edged material-symbolic dynamic as blue water development has.The findings of this paper demonstrate that the expanded typology of basin actors' responses helps to better understand the present situation. Such an improved understanding is useful in analysing current and proposed interventions. © 2010 Elsevier B.V.},
   author = {H Komakech and B van Koppen and H Mahoo and P van der Zaag},
   doi = {10.1016/j.agwat.2010.06.011},
   issn = {03783774 (ISSN)},
   issue = {11},
   journal = {Agricultural Water Management},
   keywords = {Basin trajectory,Conflict,Furrow systems,Hydraulic property,Hydraulics,Institutional arrangement,Institutional arrangements,Investments,Laws and legislation,Pangani Basin,Rivers,Societies and institutions,Tanzania,Trajectories,Water resources,Water rights,Water supply,Watersheds,furrow irrigation,hydraulic property,hydrological response,institutional framework,investment,national planning,policy analysis,resource development,river basin,spatiotemporal analysis,state role,trajectory,typology,user fee,water availability,water economics,water planning,water resource,water use},
