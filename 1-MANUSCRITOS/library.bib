@article{Pandit2020,
   abstract = {Este trabalho mostrou pela primeira vez que técnicas de transformação de nutrientes orgânicos baseados em materiais disponíveis localmente (esterco, resíduos verdes e biochar avançado) podem aumentar a eficiência de fertilização do substrato resultante por um fator de três em comparação com outras emendas orgânicas sem biocarvão. Utilizamos três métodos diferentes de compostagem para investigar as técnicas de transformação de nutrientes orgânicos; i) compostagem convencional (processo de compostagem concluído sem virar as pilhas) ii) compostagem aeróbica (processo de compostagem com rotação manual de pilhas) e iii) compostagem bokashi (fermentação anaeróbica por lacto). A compostagem foi realizada na ausência (composto somente) e na presença de biochar (co-composto). O biocarvão foi produzido localmente a partir de um arbusto invasor ' Eupatorium adenophorum' Um ensaio em vaso com milho cultivado em solo argiloso foi realizado para investigar o efeito agronômico produzido usando três métodos de compostagem mencionados acima, que foram comparados com fertilizantes minerais convencionais (NPK). Efeitos significativos do bokashi-biochar co-composto (60 t ha- 1 ) foram observados no crescimento do milho, que aumentou a biomassa em 243% em comparação com a NPK mineral, mostrando também melhores efeitos de crescimento do que as emendas de composições aeróbicas e convencionais. Os nutrientes disponíveis no solo melhorados (P disponível e outros cátions base trocáveis ​​(K + , Ca 2+ e Mg 2+ )) foram provavelmente a causa do efeito de crescimento superior do bokashi-biochar co-composto.},
   author = {Naba Raj Pandit and Hans Peter Schmidt and Jan Mulder and Sarah E Hale and Olivier Husson and Gerard Cornelissen},
   doi = {10.1080/03650340.2019.1610168},
   issn = {0365-0340},
   issue = {2},
   journal = {Archives of Agronomy and Soil Science},
   month = {4},
   note = {Publisher: Taylor &amp; Francis},
   pages = {250-265},
   title = {Nutrient effect of various composting methods with and without biochar on soil fertility and maize growth},
   volume = {66},
   url = {https://www-tandfonline.ez20.periodicos.capes.gov.br/doi/full/10.1080/03650340.2019.1610168 https://www-tandfonline.ez20.periodicos.capes.gov.br/doi/pdf/10.1080/03650340.2019.1610168},
   year = {2020}
}
@article{Michels2020,
   abstract = {Smartphone technology is promising for the future development of agriculture, as it can facilitate and improve many operational procedures and can also be combined with precision agriculture technologies. Yet, existing research on smartphone adoption in agriculture is scarce. Therefore, this paper empirically explores the factors influencing smartphone adoption by German farmers. The relationship between farmers, farm characteristics and smartphone adoption was analysed using a binomial logit model. The dataset, collected in 2016, consists of 817 German farmers and is representative in terms of age, farm size and diversification as well as regional distribution across the study area. The results indicate that, among other factors, farmers’ age, education, and farm size are determinants of smartphone adoption. Furthermore, the paper provides descriptive information about the usage of smartphone functions and agriculture-related app functions. Thus, this paper contributes to the literature by identifying key determinants of smartphone adoption in agriculture. The findings may be of interest for policy makers, researchers in the field of precision agriculture technologies as well as developers and providers of farm equipment and precision agriculture technologies that integrate with smartphones, since the paper includes information concerning smartphone use and key factors influencing smartphone adoption.},
   author = {Marius Michels and Wilm Fecke and Jan-Henning Feil and Oliver Musshoff and Johanna Pigisch and Saskia Krone},
   doi = {10.1007/s11119-019-09675-5},
   issn = {1573-1618},
   issue = {2},
   journal = {Precision Agriculture},
   month = {4},
   pages = {403-425},
   title = {Smartphone adoption and use in agriculture: empirical evidence from Germany},
   volume = {21},
   url = {https://doi.org/10.1007/s11119-019-09675-5 http://link.springer.com/content/pdf/10.1007%2Fs11119-019-09675-5.pdf},
   year = {2020}
}
@article{Fu2017,
   abstract = {Geography is a subject to explore spatial distribution, time evolution and regional characteristics of geographical elements or geographical complexes. Geography is unique in bridging social sciences and natural sciences, and has characteristics of comprehensiveness, interdisciplinary research and regionalism. With the development of geographical science technology and research methods, geography is in the gorgeous historical process towards geographical science. Research themes of geography are focusing on the comprehensive research on the earth surface. The research paradigms of geography are shifting from geography knowledge description, coupling pattern and process, to the simulation and prediction of complex human and earth system. The development of Chinese geography needs to be rooted in the major needs of national strategy, and plays important roles in the studies of urbanization development, coupling ecological processes and services, water resources management and geopolitics. Under the country's major needs, China's geography tends to achieve the geography theory innovation, new method and technology application and developed disciplinary system with Chinese characteristics, and make more contribution to national and global sustainable development. © 2017, Science Press. All right reserved.},
   author = {B Fu},
   doi = {10.11821/dlxb201711001},
   issn = {03755444 (ISSN)},
   issue = {11},
   journal = {Dili Xuebao/Acta Geographica Sinica},
   keywords = {Chinese characteristics,Comprehensiveness,Decision making,Earth systems,Geography,Human and earth system,Interdisciplinary research,Paradigm,Planning,Regional characteristics,Sustainable development,Water resources,Water resources management,decision making,decision support system,geographical knowledge,paradigm shift,physical science,research,sustainable development},
