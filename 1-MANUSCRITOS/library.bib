   keywords = {Case study,Urban competitiveness,Urban strategic management},
   publisher = {Editora CHAMPAGNAT},
   title = {Urban Strategic Management, City Marketing, Total Quality Management and local economic development. Methodological approach},
   volume = {11},
   year = {2019}
}
