@misc{Liu2019a,
   abstract = {A invenção divulga um método para processar esgoto doméstico a baixa temperatura para remoção simultânea de carbono, nitrogênio e fósforo com base no processo A-SBR, e o método compreende as seguintes etapas: lodo ativado de um tanque de sedimentação secundário de uma estação de tratamento de esgoto urbano é inoculado em um reator A-SBR, após operação estável, a taxa de remoção de carbono, nitrogênio e fósforo é alta; é utilizado um método de resfriamento gradual, a temperatura é primeiro reduzida para 18 a 22 ° C, após estabilizada a taxa de remoção de carbono, nitrogênio e fósforo, a temperatura é reduzida ainda mais para 12 a 16DEG C, quando a taxa de remoção de carbono, nitrogênio e fósforo no sistema são estáveis, microorganismos para remoção simultânea de carbono, nitrogênio e fósforo são considerados enriquecidos sob condições de baixa temperatura, e o processo A-SBR foi iniciado com sucesso; o esgoto doméstico real é gradualmente adicionado para finalmente realizar a remoção simultânea de carbono, nitrogênio e fósforo no esgoto doméstico. O método resolve os problemas de que o efeito da remoção de carbono, nitrogênio e fósforo no esgoto doméstico é ruim, e a startup é lenta e realiza um início rápido sob condições de baixa temperatura e a remoção simultânea de alta eficiência de carbono, nitrogênio e fósforo.},
   author = {Shuli Liu and Jinwei Fu and Bingtao Liu and Weiyan Zhao},
   isbn = {CN109205783 (A)},
   note = {<b>Classifications<br/></b><br/><br/><b>IPC<br/></b><br/>C02F3 / 12; C02F3 / 30<br/><b>CPC<br/></b><br/>C02F3 / 1263 (CN); C02F3 / 301 (CN); C02F3 / 308 (CN); C02F2209 / 06 (CN); C02F2209 / 08 (CN); C02F2209 / 16 (CN); C02F2209 / 22 (CN); C02F2209 / 44 (CN); C02F2301 / 10 (CN)},
   publisher = {Univ Norte China Recursos Hídricos E Energia Elétrica},
   title = {Método para processamento de esgoto doméstico a baixa temperatura para remoção simultânea de carbono, nitrogênio e fósforo com base no processo A- SBR},
   url = {https://worldwide.espacenet.com/publicationDetails/biblio?DB=EPODOC&II=0&ND=3&adjacent=true&locale=en_EP&FT=D&date=20190115&CC=CN&NR=109205783A&KC=A},
   year = {2019}
}
@article{Pinto2019,
   abstract = {This study sought to analyse tourists’ purchasing behaviours involving online travel agencies (OTAs) (i.e. Booking.com and Expedia.com). The research focused on identifying which factors most strongly influence buyers’ decision making and whether the degree of importance given to factors changes according to tourists’ sociodemographic, economic or travel characteristics. The results show that most tourists book their accommodations through OTAs mainly because browsing is easier and better prices are offered. The results further suggest that the most important factor when booking accommodations is price, although the overall buying process is quite complex. Online reviews, promotions and photos are also important. The importance online tourists give to price varies by age group, income and country of residence. Online reviews are significant regardless of tourists’ characteristics, except for age. Cluster analyses additionally revealed three different tourist segments based on the importance given to price, online reviews, promotions and photos.},
   author = {Ivete Pinto and Conceição Castro},
   issn = {2182-8466},
   issue = {2},
   journal = {Tourism \& Management Studies},
   keywords = {Booking.com,E-commerce,Expedia.com,online shopping,online travel agencies,tourist consumer’s behavior},
   month = {9},
   pages = {7-20},
   title = {Online travel agencies: factors influencing tourists’ purchase decisions},
   volume = {15},
   url = {https://www.tmstudies.net/index.php/ectms/article/view/1114 https://www.tmstudies.net/index.php/ectms/article/download/1114/pdf_129},
   year = {2019}
}
