@article{Fontes2021,
   abstract = {Problems with soil erosion are considered to be one of the major environmental degradation events in many areas of the world.&nbsp;The lower São Francisco River has been impacted by changes in the river flow caused by public policies implemented in recent decades caused by the electric power generation.&nbsp;From this perspective it has been tested some sustainable techniques in order to mitigate soil loss by controlling bank erosion.&nbsp;Among the tested geotextiles,&nbsp;the Syagrus coronata and Juncus sp geotexteis were temporally more efficient in the erosion control,&nbsp;producing a less amount of sediment,&nbsp;although on the resistance and durability of the fibers,&nbsp;Typha latifolia presented better results.},
