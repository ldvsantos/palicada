   author = {Ekaterini Dalaka and Maria I Gini and Evangelia Diapouli and Konstantinos Eleftheriadis},
   doi = {10.1007/s11869-019-00676-x},
   issn = {1873-9318},
   issue = {5},
   journal = {AIR QUALITY ATMOSPHERE AND HEALTH},
   keywords = {AIR,Biomass-burning aerosol,EMISSIONS,EPISODE,EVOLUTION,FIRES,GREECE,IMPACT,Long-range transport,POLLUTION,Potassium-40,RADIONUCLIDES,Radioactive aerosol,SMOKE,Total beta,Wildfire event},
