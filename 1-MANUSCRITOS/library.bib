@article{Deguenon2022,
   abstract = {<p>To achieve “good ecological status for water and aquatic environments”, extensive treatment techniques have been developed. The goal of this work is to study the two stages efficiency of filters planted with Typha domingensis. Two tanks in series of filters planted with reeds were used. Each tank consists of a tank of 1m3 in volume fitted with drainage pipes pierced with holes. Three different layers of gravel were laid over the drain pipes. From the comparison of the characterization of raw domestic wastewater and treated water, it appears that the reductions obtained at the outlet of the 2nd floor are more satisfactory than at the outlet of the 1st floor. The reductions at the exit of the 2nd floor are: 91.7% for total suspended solids; 98.3% for COD; 94.7% for BOD5; 79.9% for NTK and 49.8% for Pt.</p>},
   author = {Hontonho Esperance Justine Deguenon and Nonviho Guevara and Lyde Arsene Sewedo Tometin and M. Solange Guehou and Martin Pépin Aina and C. K. Dominique Sohounhloue},
