   pages = {406-430},
   publisher = {Emerald Group Holdings Ltd.},
   title = {A literature review on the causality between sustainability and corporate reputation: What goes first?},
   volume = {31},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85082298979&doi=10.1108%2FMEQ-09-2019-0207&partnerID=40&md5=4df760adfabdf2870ab8a592a6b679b6},
