@article{Martins2016,
   abstract = {Este estudo objetivou conhecer as percepções e os conceitos dos professores de Ciências Exatas sobre educação empreendedora.  A pesquisa constitui-se em um estudo de caso com abordagem qualitativa. As informações foram obtidas por meio de entrevistas semiestruturadas com 6 professores de Ciências Exatas, que atuam em escolas de três municípios do Vale do Taquari/RS/BR. A análise dos enunciados seguiu as orientações  metodológicas da análise textual discursiva - ATD. Os resultados que emergiram apontam que 5 professores conhecem os conceitos que norteiam a educação empreendedora e ministram práticas pedagógicas inovadoras em suas aulas, levando seus alunos a aprender a empreender, contribuindo para a melhoria do ensino de Ciências Exatas.},
   author = {Silvana Neumann Martins and Aline Diesel and Jacqueline Silva da Silva},
   doi = {10.15536/thema.13.2016.36-46.309},
