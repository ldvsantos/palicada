   issue = {1},
   journal = {Revista Thema},
   keywords = {Ciências Exatas,professores,práticas pedagógicas inovadoras.},
   month = {10},
   pages = {36-46},
   title = {Educação Empreendedora nos Ensinos Médio e Fundamental: Diversas Percepções},
   volume = {13},
