   title = {Green stores: an analysis of LEED-Certified fashion stores},
   volume = {11},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85067798531&doi=10.1080%2F17569370.2019.1607227&partnerID=40&md5=afee42d946e0827282196ab9d5334522},
   year = {2019}
}
@article{Nguyen2020578,
   abstract = {Purpose: This study aims to point out the importance and the relevance of sustainability issues and the need for their enhancement in the contemporary model of corporate social responsibility (CSR) as the top priority for business entities. Furthermore, it also highlights ways to enhance sustainability in the contemporary CSR model in the fast fashion industry of developing countries. Design/methodology/approach: Literature review has been extensively done through available databases, including ProQuest and ScienceDirect. Findings: This study delivers a full insight into the current state of research on the CSR model and sustainability in developing countries. The prevalent corporate environmental sustainability practices of global apparel brands are identified to propose ways to enhance sustainability in the contemporary CSR model. Research limitations/implications: The growth of fast fashion industry brings the risks of unsustainability to developing countries. Thus, it is a must for the garment and textile companies to enhance a sustainable CSR model through promoting sustainable leadership and integrating corporate culture. Originality/value: To the best of author’s knowledge, this study is the first to emphasise the role of sustainable leadership in promoting a sustainable CSR model in the fast fashion industry of developing countries. © 2020, Emerald Publishing Limited.},
   author = {H T Nguyen and D M D Le and T T M Ho and P M Nguyen},
   doi = {10.1108/SRJ-03-2019-0108},
