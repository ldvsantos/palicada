@article{Stearns2017,
   abstract = {"Buy local" campaigns educate consumers about local foods opportunities and have the potential to change consumer behavior by encouraging increased purchasing of local products. Initiatives nationwide strengthen communities through entrepreneurship. An analysis of buy local initiatives conducted through Extension, departments of agriculture and economic development, and nonprofit organizations around the country shed light on the structures of those initiatives and best management practices for communicating with target audiences. Program staff use a variety of communication tools, including social media, advertising, and events, to reach diverse community groups. Findings stimulate consideration of how Extension might build capacity of buy local programs through collaboration and communication efforts.},
