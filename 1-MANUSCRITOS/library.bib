@article{VanDerHeijden2016,
   abstract = {Highly diverse microbial assemblages colonize plant roots. It is still poorly understood whether different members of this root microbiome act synergistically by supplying different services (for example, different limiting nutrients) to plants and plant communities. In order to test this, we manipulated the presence of two widespread plant root symbionts, arbuscular mycorrhizal fungi and nitrogen-fixing rhizobia bacteria in model grassland communities established in axenic microcosms. Here, we demonstrate that both symbionts complement each other resulting in increased plant diversity, enhanced seedling recruitment and improved nutrient acquisition compared with a single symbiont situation. Legume seedlings obtained up to 15-fold higher productivity if they formed an association with both symbionts, opposed to productivity they reached with only one symbiont. Our results reveal the importance of functional diversity of symbionts and demonstrate that different members of the root microbiome can complement each other in acquiring different limiting nutrients and in driving important ecosystem functions. © 2016 International Society for Microbial Ecology All rights reserved.},
   author = {M G A Van Der Heijden and S D Bruin and L Luckerhoff and R S P Van Logtestijn and K Schlaeppi},
   doi = {10.1038/ismej.2015.120},
   issn = {17517362 (ISSN)},
   issue = {2},
   journal = {ISME Journal},
   keywords = {Bacteria,Bacteria (microorganisms),Bacterial Physiological Phenomena,Biodiversity,Fabaceae,Fungi,Mycorrhizae,Nitrogen,Plant Roots,Seedlings,Symbiosis,arbuscular mycorrhiza,bacterial phenomena and functions,bacterium,biodiversity,fungus,grassland,growth, development and aging,legume,metabolism,microbiology,mycorrhiza,nitrogen,nutrient uptake,nutrition,physiology,plant root,recruitment (population dynamics),rhizobacterium,root colonization,seedling,seedling establishment,species diversity,symbiosis},
