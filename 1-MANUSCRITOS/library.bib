@article{Fernandes2019,
   abstract = {Devido ao aumento do número de publicações científicas e não científicas relacionadas ao tema empreendedorismo, a oferta de disciplinas específicas voltadas ao campo em cursos superiores, a predisposição dos brasileiros em empreender e a falta de consenso na literatura sobre o conceito de empreendedor, a pesquisa buscou investigar: Como o empreendedor é reconhecido no campo de Empreendedorismo e Inovação nas pesquisas vinculadas em periódicos nacionais? Em vista de responder esta questão, o estudo teve como objetivo analisar as diferentes definições de empreendedor no campo de Empreendedorismo e Inovação. Como estratégia metodológica, realizou-se uma pesquisa de natureza exploratória qualitativa, utilizando-se do procedimento sistemático denominado meta-estudo. A partir da coleta de dados, identificaram-se 105 artigos relacionados ao tema e após a análise dos mesmos, através de análise de conteúdo categorial, foi possível observar que a maior parte dos estudos analisados ainda reconhece o empreendedor como sendo aquele que cria/abre uma nova empresa, sendo proprietário ou principal responsável por ela. As principais divergências das demais pesquisas apontam para uma conceituação do empreendedor associada à atividade inovadora, visão, desenvolvimento econômico de uma região, identificação de oportunidades e características comportamentais. Cabe ressaltar que a pesquisa considerou os estudos publicados apenas em revistas brasileiras de empreendedorismo e inovação, assim, podem ser indicadas comparações com a literatura internacional},
   author = {Nicole Pinheiro e outros Fernandes},
   doi = {10.18226/23190639.v7n3.02},
   journal = {Revista Brasileira de Gestão e Inovação},
   keywords = {Empreendedor. Perfil. Características pessoais. Op},
   title = {Quem é o empreendedor? A busca por uma definição do conceito através da produção científica brasileira},
   year = {2019}
}
@misc{Gartner1988,
   abstract = {En este paper, de perspectiva conductista, señala que la pregunta por quién es un emprendedor es un interrogante equivocado y destaca que para dilucidar el fenómeno de los emprendimientos la pregunta debería ser ¿cómo nacen o se crean las organizaciones? Señala a la empresarialidad como el proceso de creación de organizaciones, poniendo en acento en lo que lleva a la creación de una empresa en oposición a aquellas perspectivas que focalizan en las características personales y relacionales de los individuos. El autor afirma que si la intención es comprender el por qué de los emprendimiento es necesario focalizar la mirada en el proceso de creación de la nueva empresa. Desde esta perspectiva se discute con aquellas que subrayan que se nace con las habilidades para desarrollar una actividad emprendedora sosteniendo que las habilidades emprendedoras se aprenden mientras se hacen. La pregunta central es ¿cómo nacen las organizaciones?, y se destacan cuatro elementos esenciales para comprender el proceso emprendedor: a) los individuos involucrados; b) las actividades desarrolladas por estos individuos; c) la estructura estrategias asumidas por la organización; y d) el contexto en donde el desarrollo de la nueva empresa tiene lugar. Al respecto, el autor señala que el emprender no es un estado fijo sino un rol que los individuos toman para la creación de la empresa.},
   author = {Gartner and Willian},
   journal = {American Journal of Small Business},
   pages = {11-32},
   title = {Who is an entrepreneur_Gartner.pdf},
   volume = {12},
   year = {1988}
}
