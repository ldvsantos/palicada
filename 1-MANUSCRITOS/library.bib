@article{,
   abstract = {The investigation of startup failures has gained much interest as startups are a driver of growth and most tend to fail. The aim of this study is to identify the patterns of startup failure by developing a process model of the different phases involved. By analyzing over 200 post-mortem reports, critical events can be identified and classified. Further, an identification and comparison of the patterns of failure will allow a deeper insight into the process of startup failures and allows us to understand the events leading to this failure.},
