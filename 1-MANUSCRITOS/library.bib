@article{Sa2008,
   abstract = {This work aimed to evaluate the potassium permanganate (KMnO4) and 1-MetilCicloPropeno (1-MCP), associated with passive modified atmosphere (PMA), as postharvert conservation of the Cantaloupe melon (Cucumis melon L). The fruits were obtained in the farm Dinamarca Indústria Agrícola, in Mossoró/RN, Brazil. They were collected in the standard of exportation and sent to the Embrapa Agroindústria Tropical, in Fortaleza/CE, where they were selected, treated with carnaúba wax in the grain stalk. Four fruits were conditioned in a box and packed in Xtend bags with sachês of vermiculita with KMnO4. The treatments were: no treatment, 1; 2; 3 g of KMnO4 kg-1 and 600 ppb of 1-MCP. The fruits were stored for 14 days in temperature of 3 ± 2°C and relative humidity of 85 ± 2%. After this period, they were removed from the packings and stored 8 days in ambient temperature (23 ± 2 °C) and relative humidity of 90 ± 2%, being evaluated each 2 days (0; 2; 4; 6 and 8 days). It was evaluated loss of mass, notes of appearance, firmness of the rind and the pulp, total soluble solids, titulável total acidity and pH, total soluble sugars and coloration. Results showed that treatments were not statistically significant, when compared with the use of refrigeration associated to PMA. Therefore, the employed of permanganate is not justified in the evaluated conditions, since it will raised the cost of production.},
   author = {Cynthia Renata Lima Sá and Ebenézer de Oliveira Silva and Daniel Terao},
   issue = {01},
   journal = {Rev. Ciênc. Agron.},
   pages = {10},
   title = {Efeito do KMnO4 e 1–MCP com atmosfera modificada na conservação pós-colheita de melão Cantaloupe},
   volume = {39},
   url = {http://www.ceinfo.cnpat.embrapa.br/arquivos/artigo_3300.pdf},
   year = {2008}
}
@article{Abisuga-Oyekunle2020,
   abstract = {A redução da pobreza ocupou um lugar de destaque na agenda de desenvolvimento internacional após a adoção dos Objetivos de Desenvolvimento do Milênio das Nações Unidas (ODM) em 2000. Os países africanos iniciaram várias missões para estabelecer um crescimento econômico sustentado aumentando a produtividade com o objetivo final de redução da pobreza. A importância das pequenas e médias empresas (PMEs) na redução da pobreza e na geração de empregos é amplamente reconhecida. Apesar da elevada taxa de insucesso entre as PME, particularmente no contexto africano, algumas estão a tentar obter excelentes resultados e a demonstrar sinais de crescimento, inovação e sustentabilidade. Este artigo explora o desenvolvimento das PMEs como uma medida estratégica para a criação de empregos na África Subsaariana. Ele examina o papel das PMEs na obtenção de empregos sustentáveis ​​na África. Este estudo irá beneficiar os governos da África, levando-os a se concentrarem no desenvolvimento das PMEs e orientando-os sobre a melhor forma de integrar o desenvolvimento das PMEs para alcançar o alívio da pobreza. As recomendações propostas neste estudo podem ser úteis na formulação de políticas, operação de negócios e práticas regulatórias para o crescimento e desenvolvimento sustentáveis ​​no contexto da África Subsaariana.},
   author = {Oluwayemisi Adebola Abisuga-Oyekunle and Swapan Kumar Patra and Mammo Muchie},
   doi = {10.1080/20421338.2019.1656428},
   issn = {2042-1338},
   issue = {4},
   journal = {African Journal of Science, Technology, Innovation and Development},
   month = {8},
   pages = {405-419},
   title = {SMEs in sustainable development: Their role in poverty reduction and employment generation in sub-Saharan Africa},
   volume = {12},
   url = {https://www-tandfonline.ez20.periodicos.capes.gov.br/doi/full/10.1080/20421338.2019.1656428 https://www-tandfonline.ez20.periodicos.capes.gov.br/doi/pdf/10.1080/20421338.2019.1656428},
   year = {2020}
}
