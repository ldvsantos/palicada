@article{Romano2013,
   abstract = {According to the statements of the United Nations, two-thirds of the world's population which is about 5.5 billion people will suffer from moderately severe to severe water shortages in just over ten years. Unfortunately, the water and wastewater industry is often very hesitant with the introduction of new technologies. Water supply companies carry a responsibility for public safety, hence, it is naturally reasonable that they do not enter into unjustifiable risks. However, new technologies allow a more intelligent handling of existing water resources so that the situation must not worsen.},
