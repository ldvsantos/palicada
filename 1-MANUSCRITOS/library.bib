   year = {2015}
}
@inproceedings{Aybaly2017541,
   abstract = {The luxury industry is sought due to the over consumptive world we live in. The fact that something is rare in demand makes the goods attractive, but what about the aspect of sustainability? What about wellness, environmental impacts, and human rights? One might say that luxury is exempts to follow any tenable rules. However, this chapter will demonstrate why it is worth for the luxury industry to follow a sustainable path and how this aspect can contribute to the ultimate luxury good. The purpose of this chapter is to explore and understand the complexity of sustainability in a luxury environment and what problems it may cause. It is obvious that luxury and sustainability are not always aligned, but this chapter will show different aspects and common grounds.},
