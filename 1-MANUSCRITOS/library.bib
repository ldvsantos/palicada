@article{Costa2011,
   abstract = {A erosão do solo constitui em um problema global de degradação de terras agrícolas, tornando-se necessário o seu controle e estabilização, para retornar a área a um estado biológico estável. Portanto, objetivou-se com o presente trabalho estudar a eficiência do uso de paliçadas vivas na contenção de erosão. Inicialmente, foram confeccionados fardos com galhos de bambu, que foram dispostos na área em intervalos de cicno metros, posteriormente as ravinas existentes na área foram quantificadas. Também foram instaladas estacas graduadas para o acompanhamento da movimentação do solo. Após o início da estação chuvosa fezse uma avaliação das dimensões das ravinas e movimento do solo. Pode-se observar que, com a implantação das paliçadas ocorreu uma diminuição das dimensões das erosões. As paliçadas também proporcionaram um menor movimento de solo na área, de até 75%, indicando que a instalação das paliçadas na área foi eficaz para o controle da erosão do tipo ravinar.},
   author = {Joceline Costa and Sue Éllen Queiroz and Roger Luciano Fernandes and Luciele Silva and Moisés Silva},
   issn = {2317-2606},
   issue = {13},
   journal = {Enciclopedia Biosfera},
   keywords = {movimento de solo,ravina},
   month = {11},
   pages = {1266},
   title = {Paliçadas vivas: uma alternativa para recuperação de áreas degradadas por erosão},
   volume = {7},
   url = {https://conhecer.org.br/ojs/index.php/biosfera/article/view/4209},
   year = {2011}
}
