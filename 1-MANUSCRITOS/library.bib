@article{Bastos2018DeterminantesBrasileiro,
   abstract = {In this paper, we sought to understand the determinants of poverty in the Brazilian countryside in the years from 2001 to 2012. In this period there were intensive changes that have altered the dynamics of income in rural areas, such as the Non-agricultural occupations, an increase in the number of beneficiaries of income transfers, and an increase in retirees by the special rural retirement scheme. Using PNAD data, we sought to investigate socioeconomic factors and those related to productivity, infrastructure and occupation type, in order to shed light on the causes associated with the state of poverty in rural areas. We concluded that the three main changes observed in the rural areas contribute to the reduction of poverty and income inequality in these areas.},
   author = {Patricia de Melo Abrita Bastos and Leonardo Bornacki de Mattos and Gilnei Costa Santos},
   doi = {10.19093/res6163},
   issn = {1519-504X},
   issue = {41},
   journal = {Revista de Estudos Sociais},
   month = {12},
   pages = {4-30},
   title = {Determinantes da pobreza no meio rural brasileiro},
   volume = {20},
   url = {http://periodicoscientificos.ufmt.br/ojs/index.php/res/article/view/6163 https://dialnet.unirioja.es/servlet/articulo?codigo=6801538 https://dialnet.unirioja.es/descarga/articulo/6801538.pdf},
   year = {2018}
}
