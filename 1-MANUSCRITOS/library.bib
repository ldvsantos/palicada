   keywords = {ANIMAL-WELFARE,Brazil,COMPETITIVENESS,COWS,EFFICIENCY,FAMILY FARMS,MANAGEMENT-PRACTICES,MILK QUALITY,PASTURE,SELECTION,STRATEGIES,Santa Catarina,attitudinal survey,dairy cow,dairy farming,family farming,food production,food quality,grazing management,hygiene,milk,multivariate analysis,pasture,ruminant,smallholder,sustainability},
