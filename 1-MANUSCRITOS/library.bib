   abstract = {<p>Beyond the need to find a non-toxic alternative to DiGlycidyl Ether of Bisphenol-A (DGEBA), the serious subject of non-epichlorohydrin epoxy resins production remains a crucial challenge that must be solved for the next epoxy resin generations.</p>},
