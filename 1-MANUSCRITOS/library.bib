@article{Robert2020,
   abstract = {This article analyses the implementation of innovations in water management in the city of Lima (Peru). A capital city in the middle of the desert, the water supply of this metropolis of 10 million inhabitants represents a major challenge in the face of increasing demand and the impact of climate change on the vulnerability of water resources. Based on an analysis in terms of urban metabolism, the paper questions the emergence of new environmental concerns in water management. We investigate the logic of the implementation of innovations as part of a socio-ecological transition, highlighting their context and the power relations which they reflect. The logics of change appear multiple and fragmented and illustrate the complexity of the transition process initiated by this large Latin American city. © 2020 Cairn France. All rights reserved.},
   author = {J Robert},
   doi = {10.3917/flux1.116.0161},
   issn = {11542721 (ISSN)},
   issue = {2},
