@article{Dolbec2013,
   abstract = {How can flagships and brand stores contribute to building brands? We inquire about the relationships between store image, brand experience, brand attitude, brand attachment and brand equity using store intercepts. We find that flagships, due to the powerful brand experiences they allow, have a stronger impact on brand attitude, brand attachment and brand equity compared to brand stores. We provide retail marketers with avenues to offer increased in-store brand experiences by appealing to consumers' emotions, senses, behaviors, and cognition. © 2013 New York University.},
