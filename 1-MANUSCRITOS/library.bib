@article{Fernndez-Llamazares2021,
   abstract = {<p>The knowledge systems and practices of Indigenous Peoples and local communities play critical roles in safeguarding the biological and cultural diversity of our planet. Globalization, government policies, capitalism, colonialism, and other rapid social-ecological changes threaten the relationships between Indigenous Peoples and local communities and their environments, thereby challenging the continuity and dynamism of Indigenous and Local Knowledge (ILK). In this article, we contribute to the “World Scientists' Warning to Humanity,” issued by the Alliance of World Scientists, by exploring opportunities for sustaining ILK systems on behalf of the future stewardship of our planet. Our warning raises the alarm about the pervasive and ubiquitous erosion of knowledge and practice and the social and ecological consequences of this erosion. While ILK systems can be adaptable and resilient, the foundations of these knowledge systems are compromised by ongoing suppression, misrepresentation, appropriation, assimilation, disconnection, and destruction of biocultural heritage. Three case studies illustrate these processes and how protecting ILK is central to biocultural conservation. We conclude with 15 recommendations that call for the recognition and support of Indigenous Peoples and local communities and their knowledge systems. Enacting these recommendations will entail a transformative and sustained shift in how ILK systems, their knowledge holders, and their multiple expressions in lands and waters are recognized, affirmed, and valued. We appeal for urgent action to support the efforts of Indigenous Peoples and local communities around the world to maintain their knowledge systems, languages, stewardship rights, ties to lands and waters, and the biocultural integrity of their territories—on which we all depend.</p>},
   author = {Álvaro Fernández-Llamazares and Dana Lepofsky and Ken Lertzman and Chelsey Geralda Armstrong and Eduardo S. Brondizio and Michael C. Gavin and Phil O'B. Lyver and George P. Nicholas and Pua'ala Pascua and Nicholas J. Reo and Victoria Reyes-García and Nancy J. Turner and Johanna Yletyinen and E. N. Anderson and William Balée and Joji Cariño and Dominique M. David-Chavez and Christopher P. Dunn and Stephen C. Garnett and Spencer Greening (La'goot) and Shain Jackson (Niniwum Selapem) and Harriet Kuhnlein and Zsolt Molnár and Guillaume Odonne and Gunn-Britt Retter and William J. Ripple and László Sáfián and Abolfazl Sharifian Bahraman and Miquel Torrents-Ticó and Mehana Blaich Vaughan},
   doi = {10.2993/0278-0771-41.2.144},
   issn = {0278-0771},
   issue = {2},
   journal = {Journal of Ethnobiology},
   month = {7},
   pages = {144-169},
   title = {Scientists' Warning to Humanity on Threats to Indigenous and Local Knowledge Systems},
   volume = {41},
   year = {2021}
}
