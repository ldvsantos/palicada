   journal = {Performance Apparel Markets},
   keywords = {Antibacterial properties,Commerce,Control technologies,Environmental footprints,Environmental sustainability,Home furnishing,Industrial flooring,Market penetration,Odor control,Plastic materials,Sales,Spinning (fibers),Sports,Supply chains,Sustainable development},
