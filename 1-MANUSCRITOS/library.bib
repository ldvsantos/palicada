@article{Bakker2011,
   abstract = {This paper explores Canada's approach to water governance. It argues that fragmented governance has had negative impacts on Canada's ability to manage water resources adequately (particularly in the context of urbanization, agriculture and resource extraction), and to deal with new issues (such as climate change). Further, it argues that Canada's highly decentralized approach to water governance creates challenges of integration, coordination and data availability. The paper explores possible future strategies for innovations in water governance that may have the potential to improve water management outcomes. © 2011 Taylor & Francis.},
   author = {K Bakker and C Cook},
   doi = {10.1080/07900627.2011.564969},
   issn = {07900627 (ISSN)},
   issue = {2},
   journal = {International Journal of Water Resources Development},
   keywords = {Canada,Climate change,Data availability,Decentralized approach,Innovation,Negative impacts,Possible futures,Resource extraction,Water governance,Water management,decentralization,fragmentation,innovation,water management,water resource},
