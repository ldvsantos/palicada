@article{Nakagawa2015,
   abstract = {Rice (Oryza sativa L.) is a monocot model crop for cereal molecular biology. Following the emergence of molecular genetics of arbuscular mycorrhizal (AM) symbiosis in model legumes in the 1990s, studies on rice genetic resources have considerably contributed to our understanding of the molecular mechanisms and evolution of root intracellular symbioses. In this review, we trace the history of these studies and suggest the potential utility of AM symbiosis for improvement in rice productivity. © 2015, Nakagawa and Imaizumi-Anraku.},
   author = {T Nakagawa and H Imaizumi-Anraku},
   doi = {10.1186/s12284-015-0067-0},
   issn = {19398425 (ISSN)},
   issue = {1},
