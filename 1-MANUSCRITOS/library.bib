   issue = {3},
   journal = {Journal of Industrial Ecology},
   keywords = {Commerce; Environmental impact; Service life,Malus x domestica,Smartphones,brand; eBay; reuse; Second-hand markets; Use Phas,electronics industry; environmental impact; marke},
