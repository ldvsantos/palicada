@article{Santibanez2019,
   abstract = {El Sistema de Investigación y Educación Agrario puede dividirse a su vez en el Sistema de Investigación Agrario y Sistema de Educación para la Agricultura. Ambos sistemas están estrechamente vinculados, puesto que el Sistema de Investigación Agrario requiere de la formación de capital humano avanzado que le provee el Sistema de Educación para la Agricultura, además los estudiantes de post-grado son personal clave para los proyectos de investigación y desarrollo de las universidades y centros de investigación.  Los principales actores del Sistema de Investigación Agrario son las Universidades, Institutos Tecnológicos, Centros Científico Tecnológicos y Empresas, que realizan investigación básica, investigación aplicada y desarrollo tecnológico en el ámbito agrario.},
   author = {Edgardo Santibáñez},
   month = {5},
   title = {Desafíos, brechas y propuestas para un sistema de innovación agrario, agroalimentario y forestal al año 2030},
   url = {http://bibliotecadigital.fia.cl/handle/20.500.11944/146242 http://bibliotecadigital.fia.cl/bitstream/20.500.11944/146242/1/UDE-2016-116_IF.pdf},
   year = {2019}
}
@article{Panzone2016,
   abstract = {Este artigo contribui para a literatura existente sobre indicações geográficas, observando a preferência declarada dos consumidores pelo azeite extravirgem em dois grupos diferentes em sua identidade regional. Em particular, os consumidores de dois grupos foram convidados a classificar os produtos em uma pesquisa de ranking contingente. Um grupo ("insiders", consumidores sicilianos) compartilhou a origem com um bom produto (óleo siciliano); o outro grupo ("forasteiros", Roma e Milão) apresentou "nenhuma associação" de produtos de consumo. Os resultados indicam que os insiders estão dispostos a pagar mais pelos bens originários da região com os quais se identificam em comparação com uma região associada a pessoas de fora. A identidade parece dar um viés pelo qual um produto local não é necessariamente percebido como superior em termos absolutos, mas em termos relativos: produtos externos nunca são considerados melhores do que opções internas, mas são inferiores ou iguais no valor percebido.},
   author = {Luca Panzone and Giuseppe Di Vita and Stefania Borla and Mario D’Amico},
   doi = {10.1080/08974438.2016.1145611},
   issn = {0897-4438},
   issue = {3},
   journal = {Journal of International Food \& Agribusiness Marketing},
   month = {12},
   pages = {286-313},
   title = {When Consumers and Products Come From the Same Place: Preferences and WTP for Geographical Indication Differ Across Regional Identity Groups},
   volume = {28},
   url = {https://www-tandfonline.ez20.periodicos.capes.gov.br/doi/full/10.1080/08974438.2016.1145611 https://www-tandfonline.ez20.periodicos.capes.gov.br/doi/pdf/10.1080/08974438.2016.1145611},
   year = {2016}
}
