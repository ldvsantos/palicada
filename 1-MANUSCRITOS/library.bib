   pages = {75-83},
   publisher = {Royal Institution of Naval Architects},
   title = {Eco-Tuna purse seiner},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85025833578&partnerID=40&md5=4374836ffc1022ee0c1d85966544967b},
