   month = {6},
   pages = {624-629},
   title = {Projeto Colmeia: Elaboração de site educacional como ferramenta para a gamificação},
   url = {https://sol.sbc.org.br/index.php/ctrle/article/view/8941 https://sol.sbc.org.br/index.php/ctrle/article/download/8941/8842},
   year = {2019}
}
