@book{Lima2018a,
   abstract = {Este trabalho tem por objetivo mapear o desenvolvimento científico e tecnológico de embalagens ativas para vegetais. A partir da identificação de documentos de patentes e de artigos, foi realizada uma análise do cenário tecnológico sobre o tema, com identificação e apreciação da evolução ao longo do tempo, para apontamento da dinâmica deste mercado em diversas partes do mundo. Para tanto, foram realizadas buscas em bases de patentes e de artigos, a partir de um conjunto de palavras chave selecionadas. As bases utilizadas foram o software Questel Orbit, que identificou 620 patentes e o Scopus, com 350 artigos, a partir das quais foram realizadas análises e projeções apresentadas nos gráficos. Por fim, a junção de palavras-chave e os principais códigos IPC permitiram uma análise mais direcionada às tecnologias de embalagens ativas, com vistas à identificação de tendências e direcionamento de mercado.},
   author = {Debora Cristina da Silva Lima and Pauline Maria Reis Costa and Clinston Paulino and Josealdo Tonholo and Sílvia Beatriz Beger Uchoa and Ticiano Gomes do Ribeiro Nascimento  Adriana},
   pages = {1150},
   title = {Estudo de Prospecção Tecnológica sobre Embalagens Ativas para Vegetais},
   volume = {11},
   url = {https://portalseer.ufba.br/index.php/nit/article/view/27191/16928},
   year = {2018}
}
