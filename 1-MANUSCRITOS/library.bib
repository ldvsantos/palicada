}
@article{2019,
   abstract = {To analyze the research status quo and research hotspots of diabetic foot by bibliometrics, and to provide valuable evidence for clinical research. Methods: The published relevant literatures on diabetic foot were retrieved from the Web of Science core collection database from 2007 to 2016. Through the citation analysis method in bibliometrics, and using the literature analysis function of the Web of Science database to analyze the research status quo and research hotspots of the diabetic foot, and understand its research direction. Results: A total of 3 327 articles related to diabetic foot were retrieved. The published literatures volume had increased year by year. The research directions focused on endocrine metabolism, surgery and dermatology. The literature types were mainly journal articles and conference abstracts. The United States had the largest number of publications, China ranked 8th. The organization with the largest number of publications was the University of Washington in the United States, and the most published in China was Sichuan University. David G(USA) was the scholar who published the most literatures, and Diabetic Medicine was the journal that published the most literatures. The international researches of diabetic foot focused on the diagnosis and treatment of foot ulcers and assessment screening. In the nursing field, it focused on foot symptom management, effective self-management and guidance education. Researchers in China focused on the treatment with traditional Chinese medicine in the diabetic foot. Conclusions: From 2007 to 2016, the researches on diabetic foot had strengthened year by year. The research strength of the United States was the strongest. The global researches focused on the diagnosis, treatment and prevention management of diabetic foot infection and ulcer.},
   author = {陈金京 and 李振东 and 冯宝勤 and 刘静},
   issn = {1009-6493},
   issue = {9},
   journal = {Chinese Nursing Research},
   keywords = {Abstracts,Bibliometrics,Citation Analysis,Clinical Research,Databases,Dermatology,Diabetes Education,Diabetic Foot,Elective,Endocrine System -- Metabolism,Health,Human,Self Care,Surgery},
   pages = {1486-1493},
   title = {基于Web of Science数据库糖尿病足研究的文献计量学分析.},
   volume = {33},
   url = {https://clarivate.com/webofsciencegroup/ https://proxy.library.mcgill.ca/login?url=http://search.ebscohost.com/login.aspx?direct=true&db=rzh&AN=136813518&site=ehost-live},
   year = {2019}
}
