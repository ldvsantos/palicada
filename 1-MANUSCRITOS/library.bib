   pages = {234-251},
   publisher = {International Business Information Management Association, IBIMA},
   title = {Change management business strategy of volkswagen in the connection of the emission scandal based on the current cartel agreements},
   volume = {2017-Janua},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85048477660&partnerID=40&md5=44101eb159eb3b05898d800b26541231},
