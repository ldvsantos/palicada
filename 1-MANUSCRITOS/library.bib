@article{Thornberry2001,
   abstract = {Many large companies are seeking ways of rein-venting or revitalizing their entrepreneurial roots. These companies often long for some of the spark, innovation, speed and risk taking that they once had, but which have slowly eroded under the weight of size, bureaucracy, complex processes and hierarchy. Corporate entrepreneurship encompasses a set of activities, attitudes, and actions that are believed to help large companies regain some of this lost magic. Although much has been written about corporate entrepreneurship over the last ten years, very little is understood regarding its implementation within large company settings. First, the concept is little understood beyond the halls of academia, and there are very few guidelines regarding successful implementation. This article discusses what corporate entrepreneurship is, and highlights a number of field examples where it has been implemented. The article then examines lessons learned from these field experiments, and provides the reader with suggestions and cautions on how to infuse more entrepreneurial spirit into their own organizations. },
   author = {Neal Thornberry},
   issue = {5},
   journal = {European Management},
   keywords = {Corporate entrepreneurship,Industry rule-breaking,Intrapren-euring,Organizational transformation},
   pages = {526-533},
   title = {Corporate entrepreneurship: antidote or oxymoron?},
   volume = {19},
   url = {https://www.sciencedirect.com/science/article/pii/S0263237301000664},
   year = {2001}
}
