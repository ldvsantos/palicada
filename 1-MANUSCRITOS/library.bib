@article{Yan2017,
   abstract = {In the field of fruits damage assessment, biospeckle activity is considered relevant to quality properties of plants, such us damage, aging, or diseases. In this paper, biospeckle technique was applied to identify the early bruising of apples. Then a total of 50 undamaged apples were determined to be artificially bruised as samples. Three methods (Fujii, GD, and LSTCA) were used to extract effective information from these speckle images for measuring the intensity of biospeckle activity. The results showed that for all of three methods, the biospeckle activities of the undamaged areas in apple were similar; after the hit, the damaged area showed a lower biospeckle activity. It can be concluded that early bruising can be identified by biospeckle technique.},
   author = {Lei Yan and Jiaxin Liu and Sen Men},
   doi = {10.1142/S0217984917400346},
   issn = {0217-9849},
   issue = {19-21},
   journal = {Modern Physics Letters B},
   month = {7},
   pages = {1740034},
   title = {The biospeckle method for early damage detection of fruits},
   volume = {31},
   url = {https://www-worldscientific-com.ez20.periodicos.capes.gov.br/doi/abs/10.1142/S0217984917400346 https://www-worldscientific-com.ez20.periodicos.capes.gov.br/doi/pdf/10.1142/S0217984917400346},
   year = {2017}
}
