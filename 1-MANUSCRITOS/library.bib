@article{AndradedeSouzaMoraes2019ArbuscularCerrado,
   abstract = {Integrated crop livestock systems under no-tillage (ICLS–NT) with intercropping in the pasture phase can be an alternative for improvements in soil quality, with possible changes in the dynamics of arbuscular mycorrhizal fungi (AMF). This study was aimed at evaluating the diversity of AMF and their quantitative characteristics in ICLS–NT with intercropping between grasses and legumes in the pasture phase of the Cerrado of Mato Grosso, Brazil. The experimental area is located in Itiquira, MT, at Gravataí farm, on a dystrophic Red Latosol. The experimental design was a randomized block design in a split-plot arrangement and three replications, totaling approximately 60 ha. Plots were represented by the grasses Urochloa ruziziensis and Urochloa brizantha cv. BRS Paiaguás intercropped with the legumes (subplots) cowpea (Vigna unguiculata) cv. BRS Tumucumaque, pigeon pea (Cajanus cajan) cv. BRS Mandarin, and grasses in monoculture. Spore density AMF was not influenced by cropping systems. The intercropping with legumes influenced mycorrhizal colonization AMF and inoculum potential in relation to monocropping. The highest diversity of species AMF occurred when grasses were intercropped. The highest yield was observed in the grass U. ruziziensis, regardless of the intercropping. In general, the intercropping of grasses and legumes positively influenced the mycorrhizal colonization, inoculum potential, diversity of AMF species, and yield of the evaluated grasses. © 2019 Elsevier B.V.},
   author = {J M Andrade de Souza Moraes and C S Zanchi and G C Pires and C F Moretti and M V Barbosa and A O Silva and L P Pacheco and M A Carbone Carneiro and R L Oliveira and K Kemmelmeier and E D Souza and J M de Souza Moraes and C S Zanchi and G C Pires and C F Moretti and M V Barbosa and A O Silva and L P Pacheco and M A Carbone Carneiro and R L Oliveira and K Kemmelmeier and E D Souza},
   doi = {10.1016/j.rhisph.2019.100165},
   issn = {24522198 (ISSN)},
   journal = {Rhizosphere},
   keywords = {Diversity,Intercropping,Paiaguás,Urochloa ruziziensis},
