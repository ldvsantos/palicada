@article{Arthikala2015a,
   abstract = {Respiratory oxidative burst homolog (RBOH)-mediated reactive oxygen species (ROS) regulate a wide range of biological functions in plants. They play a critical role in the symbiosis between legumes and nitrogen-fixing bacteria or arbuscular mycorrhizal (AM) fungi. For instance, overexpression of PvRbohB enhances nodule numbers, but reduces mycorrhizal colonization in Phaseolus vulgaris hairy roots and downregulation has the opposite effect. In the present study, we assessed the effect of both rhizobia and AM fungi on electrolyte leakage in transgenic P. vulgaris roots overexpressing (OE) PvRbohB. We demonstrate that elevated levels of electrolyte leakage in uninoculated PvRbohB-OE transgenic roots were alleviated by either Rhizobium or AM fungi symbiosis, with the latter interaction having the greater effect. These results suggest that symbiont colonization reduces ROS elevated electrolyte leakage in P. vulgaris root cells. © 2015 Taylor and Francis Group, LLC.},
   author = {M.-K. Arthikala and N Nava and C Quinto},
   doi = {10.1080/15592324.2015.1011932},
   issn = {15592316 (ISSN)},
   issue = {4},
   journal = {Plant Signaling and Behavior},
   keywords = {Arbuscular mycorrhizal fungi (AMF),Cell membrane stability,Colony Count, Microbial,Electrolytes,Ion leakage,Mycorrhizae,Overexpression,P. vulgaris,Phaseolus,Plant Leaves,Plant Proteins,Plant Roots,Plants, Genetically Modified,RBOH,ROS,Reactive Oxygen Species,Rhizobium,Rhizobium tropici,Symbiosis,bacterial count,electrolyte,genetics,growth, development and aging,metabolism,microbiology,mycorrhiza,physiology,plant leaf,plant root,reactive oxygen metabolite,symbiosis,transgenic plant,vegetable protein},
