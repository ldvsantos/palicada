@article{Kongpun2014,
   abstract = {Soil acidity is a major limiting factor for upland crops. Arbuscular mycorrhizal fungi (AMF) help improve soil fertility through a fallow enriching tree, Macaranga denticulata, and directly enhance growth of many crops, but its benefit to legumes in acid soil are not known. Three experiments evaluated the benefits from AMF on legumes growing on acidic, low phosphorus soil (pH 5, 11 mg P kg-1 by Bray II). In Experiment 1, root zone soil and root fragments of M. denticulata significantly increased cowpea (Vigna unguiculata) growth and P uptake. In experiment 2, CMU22 - a strain of Acaulospora morrowiae propagated from a single spore in the rhizosphere of mimosa (Mimosa invisa) - growing in soil with pH 5 and 11 mg P kg-1 was as effective as soil from the root zone of M. denticulata on cowpea and mimosa growth. In experiment 3, cowpea growing in soil with pH 5 and 11 mg P kg-1 was inoculated with varying rates of mimosa root zone soil containing CMU22 and CMU22 spores. Both types of inoculum promoted cowpea growth, but at a low rate of 100 spores plant-1. Root zone soil that contained infected root fragments and hyphae, as well as spores, was more effective. Arbuscular mycorrhizal fungi adapted to acidic, low P soils have been shown to be effective in alleviating acid soil stress in legumes, with CMU22, an Acaulospora morrowiae, especially well adapted to acid soil.},
   author = {A Kongpun and B Dell and B Rerkasem},
   doi = {10.12982/CMUJNS.2014.0026},
   issn = {16851994 (ISSN)},
   issue = {2},
   journal = {Chiang Mai University Journal of Natural Sciences},
   keywords = {Acid soil,Arbuscular mycorrhizal fungi,Legumes,Phosphorus},
   note = {Correspondence Address: Kongpun, A.; The Office of the Commission on Agricultural Resource Education, Chulalongkorn University, Bangkok 10330, Thailand; email: ayutkongpun@yahoo.com<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>References: Brundrett, M., Bougher, N., Dell, B., Grove, T., Malajczuk, N., Working with Mycorrhizas in Forest and Agriculture (1996), The Australian Centre for International Agricultural Research (ACAIR) Monograph No. 32, Canberra, Australia; Harter, R.D., Acid Soils of the tropics [Internet]. c2002-2011 (2002), http://people.umass.edu/psoil370/Syllabus-files/Acid_Soils_of_the_, Nort Fort Myers (FL) 33917 USA: ECHO Technical Note; [cited 2011 Feb 13]. Available from; Haselwandter, K., Structure and function of siderophores produced by mycorrhizal fungi (2008) Mineral Mag, 72, pp. 61-64. , Tropics.pdf 10.1180/minmag.2008.072.1.61; <br/>Hu, X., Boyer, G.L., Siderophore-Mediated Aluminum Uptake by Bacillus megaterium ATCC 19213 (1996) Appl Environ Microb, 62, pp. 4044-4048;<br/>Kanyasone, V., Arbuscular Mycorrhizal Fungi (AMF) for Rubber Seedlings and Agroforestry in Northern Lao P.D.R. (2009), MS Thesis, Chiang Mai University; Maddox, J.J., Soileau, J.M., Effects of phosphate fertilization, lime amendments and inoculation withVA-mycorrhizal fungi on soybeans in an acid soil (1991) Plant Soil, 134, pp. 83-93;<br/>Marschner, H., Mineral Nutrition of Higher Plant (1995), p. 899. , 2nd ed, Academic Press, London; Munns, D.N., Fox, R.L., Comparative lime requirements of tropical and temperate legumes (1977) Plant Soil, 46, pp. 533-548. , 10.1007/BF0015912;<br/>Murphy, V., Riley, J.P., A modified single solution method for the determination of phosphate in natural waters (1962) Anal Chim Acta, 27, pp. 31-36;<br/>Parkpian, P., Pongsakul, P., Sangtong, P., Characteristics of acid soils in Thailand: A review (1991) Proceeding of the Second International Symposium on Plant-Soil Interactions at Low pH, pp. 397-405. , In Plant-Soil Interaction at Low pH. Eds. R J Wright, V C Baligar and R P Murrmann, Beckley, West Virginia;<br/>Plassard, C., Dell, B., Phosphorus nutrition of mycorrhizal trees (2010) Tree Physiol, 30, pp. 1129-1139. , 10.1093/treephys/tpq063;<br/>Wongmo, J., Influences of Arbuscular Mycorrhizal Fungi on Different Food Crops (2008), PhD Thesis, Chiang Mai University; Yimyam, N., Fallow regeneration and upland rice yield variation in a system of shifting cultivation with Pada (2006), (Macaranga denticulataI (BL.) Muell. Arg) as the fallow enriching species in northern Thailand. PhD thesis, Chiang Mai University; Yimyam, N., Arbuscular micorrhizal fungi on growth of arabica coffee seedling (2006), p. 20. , Highland Research and Training Center, Chiang Mai University; Yimyam, N., Rerkasem, K., Rerkasem, B., Fallow enrichment with pada (Macaranga denticulata (Bl.) Muell Arg.) trees in rotational shifting cultivation in Northern Thailand (2003) Agroforest Syst., 57, pp. 79-86. , 10.1023/A: 1023949628251;<br/>Youpensuk, S., Dell, B., Lumyong, S., Rerkasem, B., Arbuscular mycorrhizal fungi from the rhizosphere of a fallow enriching tree, Macaranga denticulata Muell (2004) Arg. and their effect on the host plant. Agroforest Syst, 60, pp. 239-246. , 10.1023/B: AGFO.0000024417.88703.65;<br/>Youpensuk, S., Lordkaew, S., Rerkasem, B., Arbuscular mycorrhizal fungi association with tangerine (Citrus reticulata) in northern Thailand and their effect on the host plant (2008) Sci Asia, 34, pp. 259-264. , 10.2306/scienceasia1513-1874.2008.34.259},
   pages = {127-140},
   title = {Acid-adapted arbuscular mycorrhizal fungi promote growth of legumes in phosphorus-deficient acid soil},
   volume = {13},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84902347922&doi=10.12982%2FCMUJNS.2014.0026&partnerID=40&md5=5345eb894863bcff6772a6b428e044a7},
   year = {2014}
