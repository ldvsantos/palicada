@article{Cope2019,
   abstract = {Mycorrhizal fungi form mutualistic associations with the roots of most land plants and provide them with mineral nutrients from the soil in exchange for fixed carbon derived from photosynthesis. The common symbiosis pathway (CSP) is a conserved molecular signaling pathway in all plants capable of associating with arbuscular mycorrhizal fungi. It is required not only for arbuscular mycorrhizal symbiosis but also for rhizobia-legume and actinorhizal symbioses. Given its role in such diverse symbiotic associations, we hypothesized that the CSP also plays a role in ectomycorrhizal associations. We showed that the ectomycorrhizal fungus Laccaria bicolor produces an array of lipochitooligosaccharides (LCOs) that can trigger both root hair branching in legumes and, most importantly, calcium spiking in the host plant Populus in a CASTOR/POLLUX-dependent manner. Nonsulfated LCOs enhanced lateral root development in Populus in a calcium/calmodulin-dependent protein kinase (CCaMK)-dependent manner, and sulfated LCOs enhanced the colonization of Populus by L. bicolor. Compared with the wildtype Populus, the colonization of CASTOR/POLLUX and CCaMK RNA interference lines by L. bicolor was reduced. Our work demonstrates that similar to other root symbioses, L. bicolor uses the CSP for the full establishment of its mutualistic association with Populus. © 2019 ASPB.},
   author = {K R Cope and A Bascaules and T B Irving and M Venkateshwaran and J Maeda and K Garcia and T A Rush and C Ma and J Labbé and S Jawdy and E Steigerwald and J Setzke and E Fung and K G Schnell and Y Wang and N Schleif and H Bücking and S H Strauss and F Maillet and P Jargeat and G Bécard and V Puech-Pagès and J.-M. Ané},
   doi = {10.1105/tpc.18.00676},
   issn = {10404651 (ISSN)},
   issue = {10},
   journal = {Plant Cell},
   keywords = {Calcium,Calcium Channels,Calcium-Calmodulin-Dependent Protein Kinases,Gene Expression Regulation, Plant,Laccaria,Lipopolysaccharides,Mycorrhizae,Plant Roots,Plants, Genetically Modified,Populus,Signal Transduction,Symbiosis,calcium,calcium calmodulin dependent protein kinase,calcium channel,chemistry,gene expression regulation,genetics,growth, development and aging,lipid-linked oligosaccharides,lipopolysaccharide,metabolism,microbiology,mycorrhiza,physiology,plant root,signal transduction,symbiosis,transgenic plant},
   note = {Chemicals/CAS: calcium, 7440-70-2, 14092-94-5; calcium calmodulin dependent protein kinase, 97350-82-8; Calcium; Calcium Channels; Calcium-Calmodulin-Dependent Protein Kinases; lipid-linked oligosaccharides; Lipopolysaccharides<br/><br/><br/><br/>Cited By :13<br/><br/><br/><br/>CODEN: PLCEE<br/><br/><br/><br/>Correspondence Address: Ané, J.-M.; Department of Bacteriology, University of WisconsinUnited States; email: jeanmichel.ane@wisc.edu<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding details: 2017-67014-26530, DE-AC05-00OR22725<br/><br/><br/><br/>Funding details: 1238305<br/><br/><br/><br/>Funding details: Agence Nationale de la Recherche, ANR, ANR-10-LABX-41, ANR-14-CE18-0008-01<br/><br/><br/><br/>Funding details: National Science Foundation, NSF, DGE-1256259<br/><br/><br/><br/>Funding details: Oak Ridge National Laboratory, ORNL<br/><br/><br/><br/>Funding details: Oregon State University, OSU<br/><br/><br/><br/>Funding details: U.S. Department of Agriculture, USDA, WIS01695<br/><br/><br/><br/>Funding details: U.S. Department of Energy, USDOE<br/><br/><br/><br/>Funding details: U.S. Department of Energy, USDOE, 1546742, DE-SC0018247, 1331098<br/><br/><br/><br/>Funding text 1: We thank Sarah Swanson for training and support with confocal microscopy techniques, Francis Martin for providing L. bicolor strain S238N, Giles Oldroyd for providing the binary vector pEC11579 carrying G-GECO, Fabienne Maillet for providing purified sLCOs and nsLCOs, and Hugues Driguez for providing synthetic LCO standards for mass spectrometry. Financial support for this project was primarily provided by the USDA (grant WIS01695) and National Science Foundation (NSF; grant DGE-1256259). Additional financial support was provided by the U.S. Department of Energy (DOE; grant DE-SC0018247) and NSF (grants 1546742 and 1331098) for partial analysis of Ca2+ spiking; the French Agence Nationale de la Recherche (contract ANR-14-CE18-0008-01) and the Laboratoir