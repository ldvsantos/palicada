@inbook{Petrone2013,
   abstract = {AbstrataA variedade de técnicas de bioengenharia de solo utilizáveis para mitigação de desastres, restauração ambiental e redução da pobreza é hoje pouco conhecida nos países em desenvolvimento. A pesquisa sobre plantas authochtonais adequadas para esse tipo de trabalho é o primeiro passo essencial para a divulgação dessa disciplina. O presente artigo está focado nesta questão relacionada à realização de diversas tipologias de obras de Bioengenharia de Solo no trópico úmido do Equador. Percebendo paliás vivos ao lado de uma estrada não pavimentada, uma trama experimental foi obtida com o plantio de 100 estacas de cada uma das seguintes espécies: Brugmansia versicolor Lagerh (nome comum local: Guanto); Euphorbia cotinifolia L. (nome comum local: Lechoso); Malvaviscus penduliflorus DC. (nome comum local: Cucarda), Trichanthera gigantea (Humb. & Bonpl.) Nees (nomes comuns locais: Nacedero, quiebrabarriga, inchabarriga).},
   author = {Alessandro Petrone and Federico Preti},
   city = {Berlin, Heidelberg},
   editor = {Claudio Margottini and Paolo Canuti and Kyoji Sassa},
   isbn = {978-3-642-31313-4},
   booktitle = {Landslide Science and Practice: Volume 7: Social and Economic Impact and Policies},
   keywords = {Bioengenharia de solo,Cortes,Deslizamentos},
   month = {11},
   pages = {325-329},
   publisher = {Springer},
   title = {Soil Bioengineering Measures in Latin America: Authocthonal Cuttings Suitability},
   url = {https://doi.org/10.1007/978-3-642-31313-4_43},
   year = {2013}
}
