@article{Provorov2014,
   abstract = {The major factors of the directed evolution of fungi are their symbiotic interactions with plants possessing the universal systems for hosting the mycobionts in tissue and cellular compartments, and for regulating their development and metabolism using the signal and trophic feedbacks. These systems originated due to co-evolution of plants with the glomeromycotan fungi, which were preadapted for associations with plants due to interactions with endosymbiotic cyanobacteria (Geosiphon-Nostoc system). During co-evolution with Glomeromycota the plants developed molecular and cellular mechanisms for interactions with diverse microbes including N2-fixing proteobacteria and actinobacteria.},
   author = {N A Provorov and O.Yu. Shtark},
   issn = {00263648 (ISSN)},
   issue = {3},
