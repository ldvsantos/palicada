@article{Takeda2015,
   abstract = {Arbuscular mycorrhiza (AM) is established by the entry of AM fungi into the host plant roots and the formation of symbiotic structures called arbuscules. The host plant supplies photosynthetic products to the AM fungi, which in return provide phosphate and other minerals to the host through the arbuscules. Both partners gain great advantages from this symbiotic interaction, and both regulate AM development. Our recent work revealed that gibberellic acids (GAs) are required for AM development in the legume Lotus japonicus. GA signaling interact with symbiosis signaling pathways, directing AM fungal colonization in host roots. Expression analysis showed that genes for GA biosynthesis and metabolism were induced in host roots around AM fungal hyphae, suggesting that the GA signaling changes with both location and time during AM development. The fluctuating GA concentrations sometimes positively and sometimes negatively affect the expression of AMinduced genes that regulate AM fungal infection and colonization. © 2015, Taylor & Francis Group, LLC.},
   author = {N Takeda and Y Handa and S Tsuzuki and M Kojima and H Sakakibara and M Kawaguchi},
   doi = {10.1080/15592324.2015.1028706},
