   isbn = {9789811661273},
   issn = {21903018},
   journal = {Smart Innovation, Systems and Technologies},
   keywords = {Food sector; Fresh food; Fresh food sector; Purch,Personnel; Surveys; Sustainable development,Sales},
   note = {cited By 0; Conference of 8th International Conference on Sustainable Design and Manufacturing, KES-SDM 2021 ; Conference Date: 15 September 2021 Through 17 September 2021; Conference Code:265689},
   pages = {149-158},
   publisher = {Springer Science and Business Media Deutschland GmbH},
