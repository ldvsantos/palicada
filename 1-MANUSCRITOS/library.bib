@article{Netemeyer2004,
   abstract = {This article presents four studies that develop measures of "core/primary" facets of customer-based brand equity (CBBE). Drawing from various CBBE frameworks, the facets chosen are perceived quality (PQ), perceived value for the cost (PVC), uniqueness, and the willingness to pay a price premium for a brand. Using numerous advocated scale developmental procedures, the measures of these facets showed evidence of internal consistency and validity over 16 different brands in six product categories. Results also suggest that PQ, PVC, and brand uniqueness are potential direct antecedents of the willingness to pay a price premium for a brand, and that willingness to pay a price premium is a potential direct antecedent of brand purchase behavior. © 2003 Elsevier Science Inc. All rights reserved.},
   author = {Richard G. Netemeyer and Balaji Krishnan and Chris Pullig and Guangping Wang and Mehmet Yagci and Dwane Dean and Joe Ricks and Ferdinand Wirth},
