   note = {CODEN: NGOXE<br/><br/><br/><br/>Correspondence Address: Meng, G.; School of Resource and Civil Engineering, Wuhan Institute of TechnologyChina; email: 172246012@qq.com<br/><br/><br/><br/>Export Date: 19 March 2020<br/><br/><br/><br/>References: He, C., Strategic choice of China's ecological modernization (2009) Decision&amp;Information, (12), pp. 17-18. , (in Chinese with English abstract); <br/>Wang, Y., Su, L., Building Institutions for ecological civilization: An overview of China sustainable development report 2014 (2014) Science &amp; Technology for Development, (2), pp. 11-19. , (in Chinese with English abstract);<br/>Pang, J., Zhang, W., Wang, H., Approach of water conservancy modernization with Chinese characteristics (2011) China Water Resources, (21), pp. 17-19. , (in Chinese with English abstract);<br/>Du, D., Wang, Y., Research and prospect on water conservancy modernization (2012) Water Resources Development Research, 12 (3), pp. 45-48. , (in Chinese with English abstract);<br/>Tao, C., The Study on Water Conservancy Modernization With Index System and Assessment Mothods (2011), Nanjing: Hohai University (in Chinese with English abstract); Ou, J., Cheng, J., Evaluation index system of Jiangsu water modernization (2012) Journal of Irrigation and Drainage, 5 (1), pp. 12-15. , (in Chinese with English abstract);<br/>Ou, J., Cheng, J., Development strategy thinking of rural water conservancy in coastal region of Jiangsu Province (2011) Journal of Irrigation and Drainage, 30 (4), pp. 88-90. , (in Chinese with English abstract);<br/>Zhang, H., Xie, X., Yang, L., Study on evaluation index system and evaluation method for water modernization in China (2010) Journal of China Institute of Water Resources and Hydropower Research, 8 (2), pp. 107-113. , (in Chinese with English abstract);<br/>Feng, G., Thinking about rural water conservancy modernization in China (1999) Beijing Water Resources, (4), pp. 1-3. , (in Chinese with English abstract);<br/>Wang, Y., Huang, Y., Evaluation and prospect of China's water conservancy modernization process (2012) China Population, Resources and Environment, 22 (6), pp. 120-127. , (in Chinese with English abstract);<br/>Grey, D., Sadoff, C., (2012) Water for Growth and Development, , Mexico: Framework Theme, 4th World Water Forum;<br/>Serageldin, I., Looking ahead: Water life and the environment in the twenty-first century water resources development (2010) International Journal of Water Resource Development, 15 (1-2), pp. 17-28;<br/>Seekler, D., Barker, R., Amarasinghe, U., Water scarcity in the twenty-first century water resources development (2010) International Journal of Water Resource Development, 15 (1-2), pp. 29-42;<br/>Zhao, X., Zhang, Q., Fan, Z., An objective and subjective synthetic approach to determine weights for multiple attribute decision making (1997) Journal of Shenyang Polytechnic University, 19 (4), pp. 95-98. , (in Chinese with English abstract)},
