   year = {2019}
}
@article{NoAuthor2015132,
   abstract = {Vaude, based in Germany, is considered to be one of the founders of the outdoor apparel sector, which serves a global market valued at more than US$25 bn in 2013. It is also Europe's leading supplier of environmentally sustainable apparel, equipment and accessories for cycling and mountain sports. The company's outdoor apparel collections encompass a full assortment of garments with high-tech performance features, including antimicrobial efficacy, thermal insulation, UV protection and waterproof breathability. These garments are highly functional, and the vast majority are certified under the strictest environmental, health and safety standards for outdoor apparel. In addition, many have received awards which are considered to be very prestigious in this increasingly competitive industry. Since its foundation in 1974, Vaude has earned much respect for its corporate ethos which combines a passion for the outdoors with an unwavering commitment to corporate social responsibility (CSR). In addition, its brand has gained widespread appeal among environmentally conscious consumers who enjoy the outdoors. The company is optimistic about the future. In particular, it is confident that it can remain successful in a heavily concentrated global market by maintaining its emphasis on high quality, functional products which meet stringent criteria for environmental friendliness and social justice. © Textiles Intelligence Limited 2015.},
