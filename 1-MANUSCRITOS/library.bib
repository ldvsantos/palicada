@article{Dias2019,
   abstract = {A agricultura familiar caracteriza-se como importante instrumento catalisador de mudanças no espaço rural. De modo que várias políticas públicas têm sido focalizadas para o seu fortalecimento. Algumas ações conduzem para constituição e consolidação de mercados loco-regionais para produtores familiares, em especial para suprir alguns desafios e entraves ao desenvolvimento da agricultura familiar, como a comercialização de seus produtos. Assim, destaca-se o Programa de Aquisição de Alimentos - PAA (2003) e a vinculação de um percentual mínimo para compra da merenda escolar diretamente da agricultura familiar local com as recentes alterações do Programa Nacional de Alimentação Escolar (2009), além de se constituírem como elementos centrais para viabilizar a produção agrícola familiar contribuindo para o desenvolvimento socioterritorial e da segurança alimentar e nutricional. Desta maneira, o estudo analisou de forma exploratória a execução do PNAE no Rio Grande do Norte a partir dos resultados alcançados pelas escolas públicas estaduais entre os anos de 2011 e 2013, auferindo cumprimento legal e prospectando contribuições para a agricultura familiar a partir do desempenho e operacionalização desta política pública, à luz das referências bibliográficas, levantamento documental e a combinação de procedimentos metodológicos de abordagem qualitativa e quantitativa. Verificou-se que embora o Estado tenha alcançado a média total de 26,2%, ainda baixo do teto mínimo de 30%, dos recursos a serem aplicados na compra de produtos de produtos da agricultura familiar, sob a ótica da regionalização interna, o desempenho das Diretorias Regionais de Alimentação Escolar (DRAEs) é bastante diverso e conflitivo.},
   author = {Thiago Ferreira Dias and Erysson Faustino de Oliveira},
   doi = {10.15628/holos.2019.6838},
   issn = {1807-1600},
   issue = {5},
   journal = {HOLOS},
   keywords = {Agricultura Familiar. Mercados Institucionais. Ali},
   month = {12},
   pages = {1-19},
   publisher = {Instituto Federal de Educacao, Ciencia e Tecnologia do Rio Grande do Norte (IFRN)},
   title = {Agricultura Familiar, Políticas Públicas e Mercados Institucionais: uma Análise Exploratória do Programa Nacional de Alimentação Escolar - PNAE no Rio Grande do Norte},
   volume = {5},
   url = {http://www2.ifrn.edu.br/ojs/index.php/HOLOS/article/view/6838},
   year = {2019}
}
