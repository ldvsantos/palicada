@article{,
   abstract = {Technological prospection is a formal process to identify, evaluate and interpret an innovation (or an innovation proposal) on a particular domain. This work shows how we planned and executed a study based on technological prospection to check the innovation proposals of virtual environments and technologies used to support education. We found that the main topic discussed in the academic community of computers and education is target of a few innovative attempts done by people not necessarily linked to universities.},
