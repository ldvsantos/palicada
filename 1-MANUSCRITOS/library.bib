@article{Vijayakumar2016,
   abstract = {Interaction of plant roots with arbuscular mycorrhizal fungi (AMF) is a complex trait resulting in cooperative interactions among the two symbionts including bidirectional exchange of resources. To study arbuscular mycorrhizal symbiosis (AMS) trait variation in the model plant Lotus japonicus, we performed an integrated multi-omics analysis with a focus on plant and fungal phospholipid (PL) metabolism and biological significance of lysophosphatidylcholine (LPC). Our results support the role of LPC as a bioactive compound eliciting cellular and molecular response mechanisms in Lotus. Evidence is provided for large interspecific chemical diversity of LPC species among mycorrhizae with related AMF species. Lipid, gene expression and elemental profiling emphasize the Lotus-Glomus intraradices interaction as distinct from other arbuscular mycorrhizal (AM) interactions. In G.intraradices, genes involved in fatty acid (FA) elongation and biosynthesis of unsaturated FAs were enhanced, while in Lotus, FA synthesis genes were up-regulated during AMS. Furthermore, FAS protein localization to mitochondria suggests FA biosynthesis and elongation may also occur in AMF. Our results suggest the existence of interspecific partitioning of PL resources for generation of LPC and novel candidate bioactive PLs in the Lotus-G.intraradices symbiosis. Moreover, the data advocate research with phylogenetically diverse Glomeromycota species for a broader understanding of the molecular underpinnings of AMS. © 2016 John Wiley & Sons Ltd.},
   author = {V Vijayakumar and G Liebisch and B Buer and L Xue and N Gerlach and S Blau and J Schmitz and M Bucher},
   doi = {10.1111/pce.12624},
   issn = {01407791 (ISSN)},
   issue = {2},
   journal = {Plant Cell and Environment},
   keywords = {Arbuscular mycorrhiza,Biosynthetic Pathways,Fatty acid synthesis,Fungi,Gene Expression Regulation, Plant,Glomeromycota,Glomus intraradices,Glomus intraradices (syn: Rhizophagus irregularis),Glycerophospholipids,Ionomics,Lipid Metabolism,Lipidomics,Loteae,Lotus (genus),Lotus corniculatus var. japonicus,Lysophosphatidylcholines,Metabolomics,Models, Biological,Mycorrhizae,Phosphates,Phospholipids,Proteomics,Quantitative Trait, Heritable,RNA, Messenger,Rhizophagus,Sequence Analysis, RNA,Subcellular Fractions,Symbiosis,Time Factors,Transcription, Genetic,Transcriptome,Transcriptomics,arbuscular mycorrhiza,biochemical composition,biological model,biosynthesis,cell fractionation,cytology,drug effects,fatty acid,fungus,gene expression,gene expression regulation,genetic transcription,genetics,glycerophospholipid,legume,lipid metabolism,lysophosphatidylcholine,messenger RNA,metabolism,metabolomics,microbiology,mitochondrion,molecular analysis,mycorrhiza,phosphate,phospholipid,phylogenetics,physiological response,physiology,procedures,protein,proteomics,quantitative trait,root system,sequence analysis,symbiosis,time factor,transcriptome},
