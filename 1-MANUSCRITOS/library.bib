@article{Simo2018,
   abstract = {AbstratoA energia, o momentum e as trocas de massa entre o solo e a atmosfera ocorrem na camada superficial. A diferença entre a temperatura da tela do ar a 2 m (T2) e a temperatura da superfície terrestre (LST) é um parâmetro chave na sua determinação. Aqui, uma análise dessa diferença é feita com dados de um site na ilha de Maiorca, no Mediterrâneo Ocidental. Enquanto estudos prévios são freqüentemente construídos para intervalos temporais relativamente curtos (de vários dias a poucos meses), o trabalho atual analisa séries de 2 anos de duração com uma resolução temporal de 30 minutos, em particular a variabilidade sazonal e diurna. A incerteza de LST medida perto do solo é estimada em pelo menos 2 ∘∘^\{\circ \}C. A diferença entre T2 e LST (T2-LST) no centro do dia varia entre - 3 e - 10 ∘∘^\{\circ \}C, chegando a cerca de - 18 ∘∘^\{\circ \}C para os dias secos de verão. Estatisticamente, é mostrado que estes valores estão relacionados com o aquecimento da radiação da superfície transmitida para cima pela turbulência térmica. Os valores no verão são muito maiores porque o solo seco superior não permite que o calor seja transmitido eficientemente ao solo. À noite T2-LST é geralmente menos de 3 ∘∘^\{\circ \}C, com correlações fracas de T2-LST com radiação líquida ou fluxo no solo, indicando que estes processos são ativos e eficientes no transporte de calor na maioria dos casos. As melhores quantidades correlacionadas à noite com T2-LST são a temperatura do solo superior, o LST e o fluxo de calor turbulento, refletindo a importância do estado da superfície. Nas noites de verão T2-LST leva valores muito pequenos, abaixo de 1 ∘∘^\{\circ \}C, mesmo permitindo estratificação instável. Este é o resultado de um solo no qual os primeiros centímetros são muito quentes após o pôr do sol, não sendo capazes de enviar calor para o solo seco e liberá-lo na atmosfera.},
   author = {Gemma Simó and Daniel Martínez-Villagrasa and Maria A Jiménez and Vicente Caselles and Joan Cuxart},
   doi = {10.1007/s00024-018-1930-x},
   issn = {1420-9136},
   issue = {11},
   journal = {Pure and Applied Geophysics},
   keywords = {-atmosfera,-onda radiação,Instrumentação de,calor do solo,fluxo de calor turbulento fluxo de,gradiente de temperatura,incertezas,interações superfície,temperatura da superfície terrestre},
   month = {5},
   pages = {3939-3953},
   title = {Impact of the Surface–Atmosphere Variables on the Relation Between Air and Land Surface Temperatures},
   volume = {175},
   url = {https://doi.org/10.1007/s00024-018-1930-x http://link.springer.com/content/pdf/10.1007%252Fs00024-018-1930-x.pdf},
   year = {2018}
}
@article{Puschel2017,
   abstract = {Legumes establish root symbioses with rhizobia that provide plants with nitrogen (N) through biological N fixation (BNF), as well as with arbuscular mycorrhizal (AM) fungi that mediate improved plant phosphorus (P) uptake. Such complex relationships complicate our understanding of nutrient acquisition by legumes and how they reward their symbiotic partners with carbon along gradients of environmental conditions. In order to disentangle the interplay between BNF and AM symbioses in two Medicago species (Medicago truncatula and M. sativa) along a P-fertilization gradient, we conducted a pot experiment where the rhizobia-treated plants were either inoculated or not inoculated with AM fungus Rhizophagus irregularis ‘PH5' and grown in two nutrientpoor substrates subjected to one of three different P-supply levels. Throughout the experiment, all plants were fertilized with 15N-enriched liquid N-fertilizer to allow for assessment of BNF efficiency in terms of the fraction of N in the plants derived from the BNF (%NBNF). We hypothesized (1) higher %NBNF coinciding with higher P supply, and (2) higher %NBNF in mycorrhizal as compared to non-mycorrhizal plants under P deficiency due to mycorrhiza-mediated improvement in P nutrition. We found a strongly positive correlation between total plant P content and %NBNF, clearly documenting the importance of plant P nutrition for BNF efficiency. The AM symbiosis generally improved P uptake by plants and considerably stimulated the efficiency of BNF under low P availability (below 10 mg kg-1 water extractable P). Under high P availability (above 10 mg kg-1 water extractable P), the AM symbiosis brought no further benefits to the plants with respect to P nutrition even as the effects of P availability on N acquisition via BNF were further modulated by the environmental context (plant and substrate combinations). As a response to elevated P availability in the substrate, the extent of root length colonization by AM fungi was reduced, the turning points occurring at about 8 and 10 mg kg-1 water extractable P for M. sativa and M. truncatula, respectively. Our results indicated competition for limited C resource between the two kinds of microsymbionts and thus degradation of AM symbiotic functioning under ample P supply. © 2017 Püschel, Janoušková, Vo?ríšková, Gryndlerová, Vosátka and Jansa.},
   author = {D Püschel and M Janoušková and A Voříšková and H Gryndlerová and M Vosátka and J Jansa},
   doi = {10.3389/fpls.2017.00390},
   issn = {1664462X (ISSN)},
   journal = {Frontiers in Plant Science},
   keywords = {Arbuscular mycorrhiza,Competition,Legumes,Nitrogen acquisition,Phosphorus uptake,Rhizobia,Root symbioses,Synergies},
   note = {Cited By :24<br/><br/><br/><br/>Correspondence Address: Püschel, D.; Department of Mycorrhizal Symbioses, Institute of Botany, Czech Academy of SciencesCzech Republic; email: david.puschel@ibot.cas.cz<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding details: GrantovÃ¡ Agentura ÄeskÃ© Republiky, GA ÄR, 15-05466S<br/><br/><br/><br/>Funding details: National Institute of Agricultural Botany, NIAB<br/><br/><br/><br/>Funding details: RVO 61388971, RVO 67985939, LK11224<br/><br/><br/><br/>Funding text 1: This research was carried out in a joint working group involving the Institute of Microbiology and the Institute of Botany. It was financially supported by the Czech Science Foundation (project 15-05466S), Czech Ministry of Education, Youth and Sports (project LK11224), and the J. E. Purkyn?e fellowship to JJ, as well as by the long-term research development programs RVO 61388971 and RVO 67985939.<br/><br/><br/><br/>References: Ankomah, A.B., Zapata, F., Hardarson, G., Danso, S.K.A., Yield, nodulation, and N-2 fixation by cowpea cultivars at different phosphorus levels (1996) Biol. Fertil. Soils, 22, pp. 10-15; <br/>Ballhorn, D.J., Schadler, M., Elias, J.D., Millar, J.A., Kautz, S., Friend or foe-Light availability determines the relationship between mycorrhizal fungi, rhizobia and lima bean (Phaseolus lunatus L.) (2016) PLoS ONE, 11;<br/>Barea, J.M., Pozo, M.J., Azcón, R., Azcón-Aguilar, C., Microbial co-operation in the rhizosphere (2005) J. Exp. Bot., 56, pp. 1761-1778;<br/>Bethlenfalvay, G.J., Pacovsky, R.S., Bayne, H.G., Stafford, A.E., Interactions between nitrogen-fixation, mycorrhizal colonization, and hostplant growth in the Phaseolus-Rhizobium-Glomus symbiosis (1982) Plant Physiol., 70, pp. 446-450;<br/>Bever, J.D., Preferential allocation, physio-evolutionary feedbacks, and the stability and environmental patterns of mutualism between plants and their root symbionts (2015) New Phytol., 205, pp. 1503-1514;<br/>Bolger, T.P., Pate, J.S., Unkovich, M.J., Turner, N.C., Estimates of seasonal nitrogen-fixation of annual subterranean clover-based pastures using the 15N natural-abundance technique (1995) Plant Soil, 175, pp. 57-66;<br/>Divito, G.A., Sadras, V.O., How do phosphorus, potassium and sulphur affect plant growth and biological nitrogen fixation in crop and pasture legumes? A meta-analysis (2014) Field Crop Res., 156, pp. 161-171;<br/>Edwards, E.J., McCaffery, S., Evans, J.R., Phosphorus availability and elevated CO2 affect biological nitrogen fixation and nutrient fluxes in a cloverdominated sward (2006) New Phytol., 169, pp. 157-167;<br/>Gange, A.C., Ayres, R.L., On the relation between arbuscular mycorrhizal colonization and plant ‘benefit’ (1999) Oikos, 87, pp. 615-621;<br/>Garau, G., Reeve, W.G., Brau, L., Deiana, P., Yates, R.J., James, D., The symbiotic requirements of different Medicago spp. suggest the evolution of Sinorhizobium meliloti and S. medicae with hosts differentially adapted to soil pH (2005) Plant Soil, 276, pp. 263-277;<br/>Giovannetti, M., Mosse, B., Evaluation of techniques for measuring vesicular arbuscular mycorrhizal infection in roots (1980) New Phytol., 84, pp. 489-500;<br/>Jakobsen, I., The role of phosphorus in nitrogen fixation by young pea plants (Pisum sativum) (1985) Physiol. Plant., 64, pp. 190-196;<br/>Jakobsen, I., Chen, B.D., Munkvold, L., Lundsgaard, T., Zhu, Y.G., Contrasting phosphate acquisition of mycorrhizal fungi with that of root hairs using the root hairless barley mutant (2005) Plant Cell Environ., 28, pp. 928-938;<br/>Jakobsen, I., Rosendahl, L., Carbon flow into soil and external hyphea from roots of mycorrhizal cucumber plants (1990) New Phytol., 115, pp. 77-83;<br/>Jansa, J., Finlay, R., Wallander, H., Smith, F.A., Smith, S.E., Role of mycorrhizal symbioses in phosphorus cycling (2011) Soil Biol., 26, pp. 137-168;<br/>Jansa, J., Mozafar, A., Frossard, E., Long-distance transport of P and Zn through the hyphae of an arbuscular myco