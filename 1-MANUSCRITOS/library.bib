@misc{Yu2019,
   abstract = {A invenção fornece um método de tratamento de emissão zero de águas residuais semicoco coque com base na ozonização catalítica. O método compreende principalmente unidades de sedimentação oblíqua do painel, flutuação de ar multifásica, filtração multimídia, destilação de amônia, ozonização catalítica, pré-operação, tratamento biológico em vários estágios, oxidação residual de ozônio e tratamento de membrana. A invenção pertence ao campo de tratamento de águas residuais de coque e o método é particularmente adequado para o tratamento de emissão zero de águas residuais de semi-coque. O método de tratamento de águas residuais semi-coque compreende principalmente as etapas a seguir: as águas residuais semi-coque passam primeiro pelas unidades de sedimentação e flotação de ar oblíquas do painel e depois passam pelo tratamento biológico em várias etapas, no momento, a maioria dos óleos e sólidos em suspensão no momento. as águas residuais são removidas,},
   author = {Yonghui Yu and Wei Wang and Xianru Li and Huangzhao Wei and Chenglin Sun},
