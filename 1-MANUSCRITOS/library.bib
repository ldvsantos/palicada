   abstract = {When it comes to the maintenance of completed soil bioengineering work, each type of live bank protection requires a different sequence of maintenance steps, depending on the composition and development of the living plant material that is used. This article describes the approach to maintenance, according to the type of bioengineering technique used, for the first 10 to 15 years after the completion of the work. The paper distinguishes between three types of techniques, depending on the amount and proportion of different wood cuttings that were used for river bank protection and the kind, scope, and sequence of maintenance steps required, i.e. pioneering techniques, climax techniques, and crossover techniques. For these categories of soil bioengineering techniques, the article describes and outlines the different measures required during the completion, development, and maintenance phase.},
   author = {Andreas Stowasser and Tabea Lagemann},
   doi = {10.3243/kwe2008.09.002},
   issn = {1865-9926, 1865-9926},
   issue = {9},
   journal = {Korrespondenz Wasserwirtschaft},
   keywords = {34: Surface and Groundwater Hydrology (CE),Article,Banks,Bioengineering,Categories,Chips,Civil Engineering (CE),Crossovers,Maintenance,Plants (organisms),Proportion,River banks,Rivers,Soil (material),Wood},
   note = {Data de revisão - 2008-10-01<br/><br/><br/><br/>Publisher: Gesellschaft zur Forderung der Abwassertechnik e.V , Theorod-Heuss-Alle 17, Hennef, D-53773, Germany, [mailto:bringewski@dwa.de], [URL:http://www.gfa-ka.de]<br/><br/><br/><br/>SubjectsTermNotLitGenreText - Maintenance; Bioengineering; Soil (material); River banks; Proportion; Categories; Wood; Crossovers; Rivers; Banks; Plants (organisms); Chips<br/><br/><br/><br/>Última atualização em - 2011-11-13},
   pages = {487-492},
   title = {Maintenance and Development of Wooden Soil Bioengineering Structures on River Banks-Part 2: Specific Maintenance Steps for Different Soil Bioengineering Techniques},
