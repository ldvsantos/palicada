@article{DeSouza2019a,
   abstract = {Positive feedback between arbuscular mycorrhizal fungal (AMF) and vascular plants can contribute to plant species establishment, but how this feedback affects plant invasion by Prosopis juliflora SW. (DC.), or resistance to invasion by Mimosa tenuiflora (Willd.) Poir in Brazilian semi-arid region is not well known. In this work, we tested how modified and native AMF communities affect the establishment of P. juliflora and M. tenuiflora plants. We examined the effects of inoculation with modified and native AMF communities on number of AMF spores, root colonization, number of N-fixing nodules, plant dry biomass, plant phosphorous concentration, and plant responsiveness to mycorrhizas of P. juliflora and M. tenuiflora. We found that the modified AMF community enhanced the root colonization, plant dry biomass, and plant phosphorous concentration of invasive P. juliflora, whereas native AMF enhanced M. tenuiflora. Our results demonstrate that the invasive P. juliflora alters soil AMF community composition, and this change generates positive feedback to the invasive P. juliflora itself and decreases AMF associations with native M. tenuiflora. © 2019, Sociedade Brasileira de Microbiologia.},
   author = {T A F de Souza and D Santos and L A de Andrade and H Freitas},
   doi = {10.1007/s42770-019-00125-y},
   issn = {15178382 (ISSN)},
   issue = {4},
   journal = {Brazilian Journal of Microbiology},
   keywords = {Biodiversity,Biological invasion,Brazil,Fabaceae,Fungi,Glomeromycota,Introduced Species,Legumes-arbuscular mycorrhizal fungal interaction,Mimosa,Mycorrhizae,Phosphorus,Plant Roots,Plant-soil feedback,Soil,Soil Microbiology,Spores, Fungal,Tropical seasonal dry forest,biodiversity,chemistry,classification,fungus,fungus spore,genetics,growth, development and aging,introduced species,isolation and purification,metabolism,microbiology,mycorrhiza,phosphorus,plant root,soil},
