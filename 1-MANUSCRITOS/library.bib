@article{Mamontova2019,
   abstract = {Legume crops represent the major source of food protein and contribute to human nutrition and animal feeding. An essential improvement of their productivity can be achieved by symbiosis with beneficial soil microorganisms—rhizobia (Rh) and arbuscular mycorrhizal (AM) fungi. The efficiency of these interactions depends on plant genotype. Recently, we have shown that, after simultaneous inoculation with Rh and AM, the productivity gain of pea (Pisum sativum L) line K-8274, characterized by high efficiency of interaction with soil microorganisms (EIBSM), was higher in comparison to a low-EIBSM line K-3358. However, the molecular mechanisms behind this effect are still uncharacterized. Therefore, here, we address the alterations in pea seed proteome, underlying the symbiosis-related productivity gain, and identify 111 differentially expressed proteins in the two lines. The high-EIBSM line K-8274 responded to inoculation by prolongation of seed maturation, manifested by up-regulation of proteins involved in cellular respiration, protein biosynthesis, and down-regulation of late-embryogenesis abundant (LEA) proteins. In contrast, the low-EIBSM line K-3358 demonstrated lower levels of the proteins, related to cell metabolism. Thus, we propose that the EIBSM trait is linked to prolongation of seed filling that needs to be taken into account in pulse crop breeding programs. The raw data have been deposited to the ProteomeXchange with identifier PXD013479. © 2019 by the authors.},
   author = {T Mamontova and A M Afonin and C Ihling and A Soboleva and E Lukasheva and A S Sulima and O Y Shtark and G A Akhtemova and M N Povydysh and A Sinz and A Frolov and V A Zhukov and I A Tikhonovich},
   doi = {10.3390/molecules24081603},
   issn = {14203049 (ISSN)},
   issue = {8},
   journal = {Molecules},
   keywords = {Arbuscular mycorrhiza,Bacteria,Beneficial soil microorganisms,Biomass,Chromatography, High Pressure Liquid,Combined inoculation,Fungi,Gene Expression Regulation, Plant,Gene Ontology,Genotype,Inoculation efficiency,LC-MS,Metabolic Networks and Pathways,Molecular Sequence Annotation,Mycorrhizae,Pea (Pisum sativum L.),Peas,Plant Proteins,Plant Root Nodulation,Proteome,Proteomics,Rhizobial symbiosis,Seed proteome,Seeds,Soil Microbiology,Symbiosis,Tandem Mass Spectrometry,bacterium,biomass,chemistry,classification,fungus,gene expression regulation,gene ontology,genetics,genotype,growth, development and aging,high performance liquid chromatography,isolation and purification,metabolism,microbiology,molecular genetics,mycorrhiza,nodulation,pea,physiology,plant protein,plant seed,procedures,proteome,proteomics,symbiosis,tandem mass spectrometry},
