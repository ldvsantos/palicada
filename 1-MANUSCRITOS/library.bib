   year = {1992}
}
@article{Tasci2018,
   abstract = {Different studies on consumer/customer-based brand equity (CBBE), have revealed varying pictures of components and divergent relationships. The current study analyzed a large dataset with path analysis to test: 1) the validity of a general CBBE model (familiarity, image, quality, brand value, consumer value, and loyalty); 2) the validity of a customer model (+satisfaction) using data for a single destination brand; 3) the cross-brand validity of the general model for five U.S. destination brands; and 4) the cross-market validity of both models for different segments based on nationality, gender, and past visitation. The results revealed that familiarity and image were the two most prominent components explaining loyalty in both models, although both consumer value and brand value also had some mediating effects on loyalty. The model was variant for different destinations, variant for different nationalities, partially variant for different genders, and invariant for visitors and non-visitors of one destination brand.},
   author = {Asli D.A. Tasci},
   doi = {10.1016/j.tourman.2017.09.020},
   issn = {02615177},
   journal = {Tourism Management},
   keywords = {Consumer-based brand equity,Customer-based brand equity,Image,Loyalty,Path analysis,Quality,Satisfaction,Value},
   month = {4},
   pages = {143-159},
   publisher = {Pergamon},
   title = {Testing the cross-brand and cross-market validity of a consumer-based brand equity (CBBE) model for destination brands},
   volume = {65},
   url = {https://linkinghub.elsevier.com/retrieve/pii/S0261517717302108},
   year = {2018}
}
