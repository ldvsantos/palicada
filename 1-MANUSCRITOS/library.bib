   journal = {Sustainability Integration for Effective Project Management},
   note = {cited By 0},
   pages = {360-379},
   publisher = {IGI Global},
   title = {Drivers for sustainable project management behaviours in facilities management: Fluorescent tube business case example},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84944550495&doi=10.4018%2F978-1-4666-4177-8.ch022&partnerID=40&md5=830bf18c6c9126f1f60191ab52ceca68},
   year = {2013}
}
@article{Pimonenko2020,
   abstract = {Implementing Sustainable Development Goals (SDGs) and increasing environmental issues provokes changes in consumers' and stakeholders' behavior. Thus, stakeholders try to invest in green companies and projects; consumers prefer to buy eco-friendly products instead of traditional ones; and consumers and investors refuse to deal with unfair green companies. In this case, the companies should quickly adapt their strategy corresponding to the new trend of transformation from overconsumption to green consumption. This process leads to increasing the frequency of using greenwashing as an unfair marketing instrument to promote the company's green achievements. Such companies' behavior leads to a decrease in trust in the company's green brand from the green investors. Thus, the aim of the study is to check the impact of greenwashing on companies' green brand. For that purpose, the partial least-squares structural equation modeling (PLS-PM), content analysis and Fishbourne methods were used. The dataset for analysis was obtained from the companies' websites and financial and non-financial reports. The objects of analysis were Ukrainian large industrial companies, which work not only in the local market but also in the international one. The findings proved that a one point increase in greenwashing leads to a 0.56 point decline in the company's green brand with a load factor of 0.78. The most significant variable (loading factor 0.34) influencing greenwashing was the information at ocial websites masking the company's real economic goals. Thus, a recommendation for companies is to eliminate greenwashing through the publishing of detailed ocial reports of the companies' green policy and achievements. © 2020 by the authors.},
   author = {T Pimonenko and Y Bilan and J Horák and L Starchenko and W Gajda},
   doi = {10.3390/su12041679},
   issn = {20711050},
   issue = {4},
   journal = {Sustainability (Switzerland)},
   keywords = {Ukraine,alternative energy; consumption behavior; equation},
   note = {cited By 24},
   publisher = {MDPI AG},
   title = {Green brand of companies and greenwashing under sustainable development goals},
   volume = {12},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081657692&doi=10.3390%2Fsu12041679&partnerID=40&md5=b30fc79c1915474f3cb7be7a26c14adb},
   year = {2020}
}
@book{Pan2016109,
   abstract = {This research addresses two critical issues facing the contemporary globalized fashion system, where pervasive trend changes are driven by brand houses/retailers and manifested in the fast fashion, pushed-based supply approach, which is causing unprecedented social-environmental risk. In addition, although the 21st-century online and social media phenomenon has opened up the fashion information and commenting forum beyond the arena of industry trade and consumer press (who traditionally command a mutually dependent relationship with brand houses/retailers and dictate trend editorial and market validation), a calculated increase in trend and merchandising changes, propelled by the brand houses/retailers from two seasons a year in the past to 4, to 8 [1], and now to 24 distinct seasons a year, [2] has not increased or improved meaningful purchasing choice for consumers nor afforded long-term customer satisfaction. A new modularization model of mass customization, researched and developed by this research team, addresses these key issues and introduces structural changes to fashion supply chain workings. Theories of modularization are deployed to generate a customer-centric object and data system-the garment-to enable an interactive relationship that rebalances the collective benefit and sustainability for fashion producers and customers. The principles of this new smart system model as proposed by this research have been piloted and tested by a British small and medium enterprise ethical and sustainable fashion designer/retailer, DEPLOY demi-couture. Our model has proven to both increase and improve customer choice while reducing environmental waste significantly throughout the fashion system supply chain output and consumer lifestyle consumption. © 2016 Elsevier Ltd All rights reserved.},
   author = {B Pan},
   doi = {10.1016/B978-0-08-100571-2.00006-3},
   isbn = {9780081005804; 9780081005712},
   journal = {Information Systems for the Fashion and Apparel Industry},
   keywords = {Commerce; Computer aided manufacturing; Customer s,Customer choice; Customer relationship management,Information management},
   note = {cited By 3},
   pages = {109-120},
   publisher = {Elsevier Inc.},
   title = {Smart systems for improved customer choice in fashion retail outlets},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84979900913&doi=10.1016%2FB978-0-08-100571-2.00006-3&partnerID=40&md5=a75178ec63631297c66037d5fd68d689},
   year = {2016}
}
@article{Scharf2012436,
   abstract = {Purpose: The purpose of this study is to identify and analyze the set of corporate social responsibility actions of a Brazilian bank as support to the strengthening of an organizational brand. The specific scope is to discuss the reflections of sustainable actions adopted for the recognition of the organization's brand. Design/methodology/approach: A case study, based on Yin, and in-depth interviews with those responsible for the sustainability department of the studied organization were adopted. Findings: Literature and the understanding of the organization's executives, when compared to actions adopted by Banco do Brasil, allow the conclusion that the set of corporate social responsibility actions reflects, in its instrumental use, the intention of managing answers to social, economical and environmental demands, and in its conceptual use has helped in strengthening the financial institution's brand. Originality/value: The paper focuses on the set of corporate social responsibility actions adopted by the largest financial institution in Brazil and its relationship with brand strengthening. It is one of the few studies examining the efforts of corporate social responsibility in a bank's brand. © Emerald Group Publishing Limited.},
