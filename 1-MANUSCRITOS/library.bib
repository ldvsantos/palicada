@article{Bahraminia2016,
   abstract = {Um experimento em casa de vegetação foi conduzido para avaliar a eficácia de fungos micorrízicos arbusculares (AM) na fitorremediação de solo contaminado com chumbo (Pb) pelo capim-vetiver. O experimento foi um fatorial disposto em um delineamento inteiramente casualizado. Os fatores incluíram quatro níveis de Pb (50, 200, 400 e 800 mg kg −1 ) como fungos Pb (NO 3 ) 2 , AM em três níveis (controle não micorrízico (NM), intraradícios de Rhizophagus, Glomus versiforme)) Os pesos de parte aérea e de raiz (SDW e RDW) diminuíram com o aumento dos níveis de Pb. A inoculação micorrízica aumentou a SDW e a RDW em comparação ao controle da NM. Com a inoculação micorrízica e os níveis crescentes de Pb, a captação de Pb da parte aérea e da raiz aumentou em comparação com as do controle da NM. A colonização das raízes aumentou com a inoculação micorrízica, mas diminuiu com o aumento dos níveis de Pb. A concentração de fósforo e a absorção na parte aérea das plantas inoculadas com fungos AM foram significativamente maiores que o controle NM nas doses de 200 e 800 mg Pb kg −1 . Concentração de Fe, absorção de Fe e Mn da parte aérea em plantas inoculadas com intraradícios de Rhizophagusem todos os níveis de Pb foram significativamente maiores que o controle NM. A inoculação micorrízica aumentou as eficiências de extração, absorção e translocação de Pb. O fator de translocação do chumbo diminuiu à medida que os níveis de Pb aumentaram; no entanto, a inoculação com fungos AM aumentou a translocação de Pb.},
   author = {Mahboobeh Bahraminia and Mehdi Zarei and Abdolmajid Ronaghi and Reza Ghasemi-Fasaei},
   doi = {10.1080/15226514.2015.1131242},
   issn = {1522-6514},
   issue = {7},
   journal = {International Journal of Phytoremediation},
   month = {5},
   pages = {730-737},
   title = {Effectiveness of arbuscular mycorrhizal fungi in phytoremediation of lead- contaminated soil by vetiver grass},
   volume = {18},
   url = {https://www-tandfonline.ez141.periodicos.capes.gov.br/doi/full/10.1080/15226514.2015.1131242 https://www-tandfonline.ez141.periodicos.capes.gov.br/doi/pdf/10.1080/15226514.2015.1131242},
   year = {2016}
}
