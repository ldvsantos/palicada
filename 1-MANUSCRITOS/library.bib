   year = {2012}
}
@article{NoAuthor201982,
   abstract = {O'Neill is a world leading provider of wetsuits and surf apparel. It was initially established in 1952 in California, USA, by Jack O'Neill-who lays claim to the invention of the neoprene wetsuit. Today, in addition to wetsuits, the company offers a broad range of apparel and accessories which it provides under the categories of accessories, activewear, beachwear, snowwear and streetwear. Its products are sold in several countries worldwide through company operated physical and online retail stores and via third party retail stockists such as department stores and independent speciality stores. The company is part owned by the Netherlands-based brand management company Logo International-although the O'Neill family has retained ownership of some areas of the business, including the O'Neill Wetsuits business, in order to safeguard the authenticity of the O'Neill brand. Wetsuits represent a key part of O'Neill's product portfolio, and the brand is committed to innovation in this product area. As part of this commitment, the O'Neill Wetsuits business maintains a dedicated research and development facility in Santa Cruz, California, USA, which focuses on developing market leading products and manufacturing them using the most innovative materials. The brand's newest and most innovative material is Technobutter 3 neoprene, which was launched in 2017. The material is designed to be extremely lightweight, flexible, warm, durable and comfortable to wear. Also, the company has developed an environmentally sustainable apparel collection, called O'Neill Blue, as well as the world's first denim boardshorts which are suitable for day to day wear and surfing. O'Neill is committed to environmental sustainability and social responsibility, and this is reflected in the number of industry initiatives to which O'Neill has committed-notably those associated with worker rights. Also, O'Neill supports a number of environmental causes, notably those which focus on marine life and the prevention of climate change. © Textiles Intelligence Limited 2019.},
   issn = {14776456},
   issue = {64},
   journal = {Performance Apparel Markets},
   note = {cited By 0},
   pages = {82-94},
   publisher = {Textiles Intelligence Ltd.},
   title = {Profile of O'Neill: A world leading provider of wetsuits, surf apparel, beachwear, snowwear, activewear and streetwear},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85060942035&partnerID=40&md5=c2a27ca309e5eeda2fda526c553c581a},
   year = {2019}
}
@article{Champniss2016317,
   abstract = {Shifting consumers towards sustainable behaviours is difficult, with an attitude–behaviour gap persistently reported. This study proposes a route towards sustainable behaviours that does not depend on individual attitudes or values: social identity forces within novel online brand-convened consumer groups. A field experiment using a fictitious fruit drink brand demonstrates that by assembling an online consumer group and providing it with sustainability objectives, consumers will engage in a sustainability-aligned behaviour, namely donating to social or environmental charities at the request of the firm, irrespective of their individual attitudes. Furthermore, this behaviour is accompanied by an improvement in brand attachment. As these effects are found within a newly-formed online group, practitioners may be able to achieve sustainability objectives through this mechanism even in the absence of well-established brand communities. The study contributes to social identity literature by demonstrating the impact of group identity effects in a consumer context, and by showing a mechanism by which the negative side of group identity – out-group derogation – can be avoided. © 2016},
   author = {G Champniss and H N Wilson and E K Macdonald and R Dimitriu},
   doi = {10.1016/j.techfore.2016.03.002},
   issn = {00401625},
   journal = {Technological Forecasting and Social Change},
   keywords = {Brand attachment; Field experiment; Online consum,Consumer behavior; Innovation; Technological forec,Sustainable development,consumption behavior; identity construction; soci},
   note = {cited By 4},
   pages = {317-326},
   publisher = {Elsevier Inc.},
   title = {No I won't, but yes we will: Driving sustainability-related donations through social identity effects},
   volume = {111},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84964240048&doi=10.1016%2Fj.techfore.2016.03.002&partnerID=40&md5=8ca74aba5109c7505b8fc8eb24057cdd},
   year = {2016}
}
@article{Wells2021697,
   abstract = {Purpose: By responding to scholarly calls, this study examines the environmental reports of LVMH and Kering. The study extends legitimacy theory to ascertain the credibility of the aforementioned luxury conglomerates' commitment to environmental sustainability. Design/methodology/approach: A corpus-assisted discourse analysis centred upon the Global Reporting Initiative (GRI) guidelines is used to examine the environmental disclosures of LVMH and Kering. Findings: The findings show inconsistencies due to the lack of brand-level reporting and reporting quality falls short of comparable sustainability reporting within each conglomerate and with one another. Selective and unbalanced reporting along with symbolic management undermines the legitimacy of sustainability efforts by LVMH and Kering. Originality/value: Despite the increased attention paid to sustainable luxury, few studies critically analyse how luxury brands formally report on sustainability. © 2021, Emerald Publishing Limited.},
   author = {V Wells and N Athwal and E Nervino and M Carrigan},
