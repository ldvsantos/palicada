@book{Kasuma2022,
   abstract = {In recent years, social media have become some of the main channels through which corporations communicate sustainability practices. Social media and sustainability go hand in hand in brand communication strategies to help corporations raise awareness of their efforts, generate interactivity, and foster greater engagement with their audiences. Nonetheless, corporations have yet to find the right content strategy to interweave sustainability initiatives in messages. Most corporations tend to utilise safe and generic messaging in social media campaigns that goes unnoticed and lacks resonance with their audiences. Through an Asian perspective, this chapter discusses the use of sustainability storytelling, message appeal, and AIDA formula in content to drive engagement on this critical issue, besides investigating how these approaches help change the perceptions and behaviours of the consumers on social media.},
   author = {Shaidatul Akma Adi Kasuma and Nur Atikah A Rahman and Mohamad Saifudin Mohamad Saleh},
