   year = {2013}
}
@article{Knackfuss2011,
   abstract = {From June 22 to 24, 2011 the acatech project 'Water as a geo-resource - The challenge of global change', together with the Berlin-Brandenburg Academy of Sciences and Humanities (BBAW) and the Innovation Network of Climate Change Adaptation Brandenburg Berlin (INKA BB), organized a technical symposium on the topic "Water-related adaptation measures in the landscape and climate change in Germany". The program covered lectures by qualified experts, discussions with the professional audience as well as a poster-making competition and an excursion to the Lusatian brown coal mining district. The venue was the IBA Terraces in Grossräschen on the Ilse Lake of the former Lusatian brown coal open pit Meuro.},
