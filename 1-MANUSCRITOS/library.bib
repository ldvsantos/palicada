   title = {Global Entrepreneurship Monitor 2015 to 2016: Special Topic Report on Social Entrepreneurship},
   url = {https://papers.ssrn.com/abstract=2786949 https://papers.ssrn.com/sol3/papers.cfm?abstract_id=2786949},
   year = {2016}
}
