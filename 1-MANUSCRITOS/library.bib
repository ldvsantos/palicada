@article{Suzaki2019,
   abstract = {Nitrogen-fixing rhizobia and arbuscular mycorrhizal fungi (AMF) form symbioses with plant roots and these are established by precise regulation of symbiont accommodation within host plant cells. In model legumes such as Lotus japonicus and Medicago truncatula, rhizobia enter into roots through an intracellular invasion system that depends on the formation of a root-hair infection thread (IT). While IT-mediated intracellular rhizobia invasion is thought to be the most evolutionarily derived invasion system, some studies have indicated that a basal intercellular invasion system can replace it when some nodulation-related factors are genetically modified. In addition, intracellular rhizobia accommodation is suggested to have a similar mechanism as AMF accommodation. Nevertheless, our understanding of the underlying genetic mechanisms is incomplete. Here we identify a L. japonicus nodulation-deficient mutant, with a mutation in the LACK OF SYMBIONT ACCOMMODATION (LAN) gene, in which root-hair IT formation is strongly reduced, but intercellular rhizobial invasion eventually results in functional nodule formation. LjLAN encodes a protein that is homologous to Arabidopsis MEDIATOR 2/29/32 possibly acting as a subunit of a Mediator complex, a multiprotein complex required for gene transcription. We also show that LjLAN acts in parallel with a signaling pathway including LjCYCLOPS. In addition, the lan mutation drastically reduces the colonization levels of AMF. Taken together, our data provide a new factor that has a common role in symbiont accommodation process during root nodule and AM symbiosis. © 2019 Suzaki et al.},
   author = {T Suzaki and N Takeda and H Nishida and M Hoshino and M Ito and F Misawa and Y Handa and K Miura and M Kawaguchi},
   doi = {10.1371/journal.pgen.1007865},
   issn = {15537390 (ISSN)},
   issue = {1},
   journal = {PLoS Genetics},
   keywords = {Arabidopsis,Article,DNA modification,Gene Expression Regulation, Plant,LAN gene,Lotus,Lotus (genus),Lotus japonicus,Medicago truncatula,Mutation,Mycorrhizae,Plant Proteins,Plant Root Nodulation,Plant Roots,Rhizobiales,Rhizobium,Root Nodules, Plant,Symbiosis,arbuscular mycorrhiza,arbuscular mycorrhizal symbiosis,barrel medic,cell invasion,complex formation,controlled study,gene expression regulation,gene isolation,gene mutation,genetic code,genetic identification,genetic transcription,genetics,growth, development and aging,intracellular symbiont accommodation,mediator complex,microbiology,mutation,mutational analysis,mycorrhiza,nodulation,nonhuman,nucleotide sequence,plant gene,plant protein,plant root,plant structures,protein function,protein subunit,risk factor,root hair infection thread,sequence homology,signal transduction,symbiont,symbiosis,transcription regulation},
