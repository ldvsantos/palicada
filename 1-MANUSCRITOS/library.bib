@inbook{Mandran2018,
   abstract = {Summary The study of research methods has highlighted shortfalls and inaccuracies in analytical research methods. It is necessary to specify the overall research process in order for it to be carried out without ambiguity. This chapter proposes the Traceable Human Experiment Design Research (THEDRE) method in response to these problems. THEDRE is a global method that encourages the use of quality management tools, namely the Deming cycle and quality indicators for the research process and data quality. It offers an adaptable form for structuring the research process in various areas of Human-Centered Computer Science Research (HCCSR), or in line with research projects. The chapter describes the assumptions for epistemological positioning within the THEDRE method. It presents the vocabulary used to form a THEDRE research process, which enables researchers to refer to the process while also adapting it to their specialist field. The chapter explores the way in which the user-centered approach is mobilized in testing phases.},
   author = {Nadine Mandran},
   city = {Hoboken, NJ, USA},
   doi = {10.1002/9781119453635.ch4},
   booktitle = {Traceable Human Experiment Design Research},
