   author = {Keren Railka Paiva Menezes and Guilherme Celestino de Souza Santos and Olganeth Moreira de Oliveira and Alex Guimarães Sanches and Carlos Alberto Martins Cordeiro and Antonio Rafael Gomes de Oliveira},
   isbn = {1809-8215},
