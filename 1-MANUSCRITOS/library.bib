@article{Santos2018e,
   abstract = {Este artigo tem por objetivo mostrar o diagnóstico da política de habitação da cidade de Aracaju/SE, apresentando os conceitos pertinentes ao tema em questão, a história da habitação no Brasil, os programas de habitação de acordo com o Ministério das Cidades, analisando seu quadro situacional da política de interesse social e as áreas beneficiadas nos últimos dez anos. A metodologia baseia-se numa pesquisa exploratória e descritiva, por meio de investigação de uma pesquisa bibliográfica e documental. Os resultados elencados demonstram a adoção atual de uma política de habitação de interesse social, não deixando de lado a participação no programa de arrendamento familiar que ao longo da última década vêm beneficiando famílias da capital sergipana, mostrando que o diagnóstico do setor parte do princípio da proposta colocada pelo Ministério das Cidades que baseada no Plano Nacional de Habitação conseguem alcançar o êxito.},
   author = {Carina Angélica dos Santos and Cleriston Silva Santos},
   issn = {2595-394X},
   issue = {1},
   journal = {Ciência na Fama},
   month = {11},
   pages = {41-58},
   title = {Diagnostico da política da habitação em Aracaju},
   volume = {2},
   url = {http://revistafama.faculdadeamadeus.com.br:8282/ojs-2.4.6/index.php/Ciencianafama/article/view/49 http://revistafama.faculdadeamadeus.com.br:8282/ojs-2.4.6/index.php/Ciencianafama/article/download/49/47},
   year = {2018}
}
