   year = {2019}
}
@article{Antoneli2014,
   abstract = {O cultivo do tabaco na região Sudeste do Estado do Paraná é realizado em pequenas propriedades absorvendo grande parte da mão-de-obra familiar. As áreas de cultivo, geralmente indicam restrições ao uso, por apresentarem solos rasos e declividade superior a 20%, o que potencializa a utilização do plantio convencional com a utilização da tração animal para a realização das atividades. De forma insipiente, vem-se adotando o plantio direto nas áreas que permitem o uso de implementos agrícolas. No plantio convencional o solo fica exposto sendo revolvido constantemente desde o plantio do tabaco (setembro) até o início da colheita (dezembro). Já no plantio direto há uma redução das atividades de revolvimento do solo devido à camada morta. A variação das atividades pode promover respostas hidrológicas e geomorfológicas diferentes nas duas formas de cultivo. Para identificar tais variações este trabalho se propôs a avaliar a exposição do solo, compactação, infiltração perda de água e solo nos dois tipos de cultivo ao longo da safra de 2009/2010. Foram identificadas duas áreas em uma mesma vertente com diferentes formas de cultivo. O monitoramento teve inicio no mês de setembro (plantio) a março (término da colheita). Ao término da pesquisa observou-se que a infiltração média de água no solo no plantio direto foi 20,9% superior ao plantio convencional e J a compactação do solo foi 78,4% superior no plantio convencional. Já a perda de água no plantio direto foi 3 vezes inferior e a perda de solo foi 6 vezes maior no plantio convencional.},
   author = {Valdemir Antoneli and Edivaldo Lopes Thomaz},
   doi = {10.20502/rbg.v15i3.534},
   issn = {2236-5664},
   issue = {3},
   journal = {Revista Brasileira de Geomorfologia},
   keywords = {Plantio Convencional,Plantio Direto,erosão,fumicultura},
   month = {5},
   title = {Perda de solo em cultivo de tabaco sob diferentes formas de cultivo na região sudeste do Paraná},
   volume = {15},
   url = {http://www.lsie.unb.br/rbg/index.php/rbg/article/view/534 http://www.lsie.unb.br/rbg/index.php/rbg/article/download/534/405},
   year = {2014}
}
@article{Patino-Ruiz2014,
   abstract = {Symbiotic root micro-organisms such as arbuscular mycorrhizal fungi commonly change morphological, physiological and biochemical traits of their host plants and may thus influence the interaction of aboveground plant parts with herbivores and their natural enemies. While quite a few studies tested the effects of mycorrhiza on life history traits, such as growth, development and reproduction, of aboveground herbivores, information on possible effects of mycorrhiza on host plant choice of herbivores via constitutive and/or induced plant volatiles is lacking. Here we assessed whether symbiosis of the mycorrhizal fungus Glomus mosseae with common bean plants Phaseolus vulgaris influences the response of the two-spotted spider mite Tetranychus urticae to volatiles of plants that were clean or infested with spider mites. Mycorrhiza-naïve and -experienced spider mites, reared on mycorrhizal or non-mycorrhizal bean plants for several days before the experiments, were subjected to Y-tube olfactometer choice tests. Experienced but not naïve spider mites distinguished between constitutive volatiles of clean non-mycorrhizal and mycorrhizal plants, preferring the latter. Neither naïve nor experienced spider mites distinguished between spider mite-induced volatiles of mycorrhizal and non-mycorrhizal plants. Learning the odor of clean mycorrhizal plants, resulting in a subsequent preference for these odors, is adaptive because mycorrhizal plants are more favorable host plants for fitness of the spider mites than are non-mycorrhizal plants. © 2014, Springer International Publishing Switzerland.},
   author = {J D Patiño-Ruiz and P Schausberger},
   doi = {10.1007/s10493-014-9845-4},
   issn = {01688162 (ISSN)},
   issue = {4},
   journal = {Experimental and Applied Acarology},
   keywords = {Animals,Arbuscular mycorrhiza,Choice Behavior,Female,Host plant selection,Learning,Linear Models,Mycorrhizae,Olfactometry,Phaseolus,Plant volatiles,Spider mites,Symbiosis,Tetranychidae,Volatile Organic Compounds,adaptation,animal,arbuscular mycorrhiza,biochemical composition,chemistry,decision making,female,host plant,legume,life history trait,mite,morphology,mycorrhiza,natural enemy,odor,olfactometry,parasitology,physiology,statistical model,symbiosis,volatile organic compound,volatile substance},
   note = {Chemicals/CAS: Volatile Organic Compounds<br/><br/><br/><br/>Cited By :7<br/><br/><br/><br/>CODEN: EAACE<br/><br/><br/><br/>Correspondence Address: Schausberger, P.; Group of Arthropod Ecology and Behavior, Division of Plant Protection, Department of Crop Sciences, University of Natural Resources and Life Sciences, Peter Jordanstrasse 82, Austria<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding text 1: Acknowledgments We thank D. Hoffmann for advice during the experiments and A. Walzer, J. M. Gratzer and T. Pina Desfilis for comments on an earlier version of the manuscript. J. D. Patiño-Ruiz was partially funded by an Erasmus-Mundus stipend.<br/><br/><br/><br/>References: Allen, M.F., The ecology of arbuscular mycorrhizas: a look back into the 20th century and a peek into the 21st (1996) Mycol Res, 100, pp. 769-782; <br/>Bezemer, T.M., van Dam, N.M., Linking aboveground and belowground interactions via induced plant defenses (2005) Trends Ecol Evol, 20, pp. 617-624. , PID: 16701445;<br/>Bolland, H.R., Gutierrez, J., Flechtmann, C.H.W., (1998) World catalogue of the spider mite family (Acari, Tetranychidae), , Brill, Leiden:;<br/>Bruce, T.J.A., Wadhams, L.J., Woodcock, C.M., Insect host location: a volatile situation (2005) Trends Plant Sci, 10, pp. 269-274. , COI: 1:CAS:528:DC%2BD2MXltVaqsbc%3D, PID: 15949760;<br/>Choh, Y., Takabayashi, J., Intact lima bean plants exposed to herbivore-induced plant volatiles attract predatory mites and spider mites at different levels according to plant parts (2006) Appl Entomol Zool, 42, pp. 537-543;<br/>Dicke, M., Volatile spider-mite pheromone and host-plant kairomone, involved in spaced-out gregariousness in the spider mite Tetranychus urticae (1986) Physiol Entomol, 11, pp. 251-262;<br/>Dicke, M., Chemical ecology of host-plant selection by herbivorous arthropods: a multitrophic perspective (2000) Biochem Syst Ecol, 28, pp. 601-617. , COI: 1:CAS:528:DC%2BD3cXks1Oisr0%3D, PID: 10854737;<br/>Dicke, M., van Loon, J.J.A., Multitrophic effects of herbivore-induced plant volatiles in an evolutionary context (2000) Entomol Exp Appl, 97, pp. 237-249. , COI: 1:CAS:528:DC%2BD3MXht1Slsw%3D%3D;<br/>Dukas, R., Evolutionary biology of animal cognition (2004) Annu Rev Ecol Evol Syst, 35, pp. 347-374;<br/>Egas, M., Sabelis, M.W., Adaptive learning of host preference in a herbivorous arthropod (2001) Ecol Lett, 4, pp. 190-195;<br/>Fontana, A., Reichelt, M., Hempel, S., Gershenzon, J., Unsicker, S.B., The effects of arbuscular mycorrhizal fungi on direct and indirect defense metabolites of Plantago lanceolata L (2009) J Chem Ecol, 35, pp. 833-843. , COI: 1:CAS:528:DC%2BD1MXoslejurk%3D, PID: 19568812;<br/>Gange, A.C., Species-specific responses of a root- and shoot-feeding insect to arbuscular mycorrhizal colonization of its host plant (2001) New Phytol, 150, pp. 611-618;<br/>Giovannetti, M., Mosse, B., An evaluation of techniques for measuring vesicular arbuscular infection in roots (1980) New Phytol, 84, pp. 489-500;<br/>Giovannetti, M., Avio, L., Sbrana, C., Citernesi, A., Factors affecting appressorium development in the vesicular-arbuscular mycorrhizal fungus Glomus mosseae (Nicol. &amp; Gerd.) Gerd. &amp; Trappe (1993) New Phytol, 123, pp. 115-122;<br/>Guerrieri, E., Lingua, G., Digilio, M.C., Massa, N., Berta, G., Do interactions between plant roots and the rhizosphere affect parasitoid behavior? (2004) Ecol Entomol, 29, pp. 753-756;<br/>Helle, W., Sabelis, M.W., (1985) Spider mites: their biology, natural enemies and control, , (eds), Elsevier, Amsterdam:;<br/>Hoffmann, D., Schausberger, P., Plant-mediated aboveground-belowground interactions: the spider mite perspective (2012) Acarologia, 52, pp. 17-27;<br/>Hoffmann, D., Vierheilig, H., Riegler, P., Schausberger, P., Arbuscular mycorrhizal symbiosis increases host plant acceptance and population growth rates of the two-spotted spider mite Tetranychus urticae (2009) Oecologia, 158, pp. 663-671. , PID: 18949488;<b