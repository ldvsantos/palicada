@article{Liu2017a,
   abstract = {This study aimed to explore whether nitrogen availability could influence mycorrhizal function and their associations with host plants in Cd-contaminated acidic soils or not. A greenhouse pot experiment was conducted to assess the effects of mycorrhizal inoculation (non-mycorrhizal inoculation (NM), Glomus aggregatum (Ga), G. tortuosum (Gt) and G. versiforme (Gv)) and inorganic N amendment on the growth, nutrient and Cd uptake of Medicago sativa grown in Cd-contaminated acidic soils (10 mg Cd kg−1 soil). AMF inoculations significantly increased the shoot and total biomass and decreased the shoot Cd concentration in comparison to plants uninoculated. N addition increased markedly concentration and content of N and decreased those of P in plants at all inoculation treatments. Shoot K, Na and Mg concentration in plants inoculated with Ga and Gv were decreased by N addition, whereas shoot K, Na, Ca and Mg concentration in plants inoculated with Gt were not negatively affected. It was observed that N addition only increased mycorrhizal colonization, shoot biomass, shoot K, Ca and Mg content of plants inoculated with Gt. Irrespective of N addition, plants with Gt inoculation got the maximum shoot and root P concentration and content, as well as P/Cd concentration molar ratio among all inoculation treatment. Neither AMF nor N fertilizer contributed to the decrease of soil exchangeable Cd and increase of soil pH. These results suggested that N fertilizer only elevated plant performance of alfalfa with Gt inoculation grown in acidic soil, by diluting Cd concentration and alleviating of nutrient deficiency, especially P. © 2016 Elsevier Ltd},
   author = {M Liu and J Sun and Y Li and Y Xiao},
   doi = {10.1016/j.chemosphere.2016.09.145},
   issn = {00456535 (ISSN)},
   journal = {Chemosphere},
   keywords = {AMF,Acids,Alfalfa,Article,Biodegradation, Environmental,Biomass,Cadmium,Cd concentrations,Fertilizers,Glomeromycota,Glomus aggregatum,Glomus tortuosum,Medicago sativa,Molar concentration,Molar ratio,Mycorrhizae,Mycorrhizal colonization,Nitrogen,Nitrogen availability,Nitrogen fertilizers,Nutrient deficiency,Nutrient uptake,Nutrients,Plant Roots,Plant performance,Plants (botany),Soil,Soil Microbiology,Soil Pollutants,Soil pollution,Soils,acid,alfalfa,arbuscular mycorrhiza,biofertilizer,biomass,bioremediation,cadmium,chemistry,colonization,controlled study,fertilizer,fungal colonization,fungus growth,growth rate,growth, development and aging,legume,magnesium ion,metabolism,microbiology,mycorrhiza,mycorrhizal inoculation,nitrogen,nitrogen fertilizer,nonhuman,nutrient uptake,pathogenicity,plant growth,plant root,potassium,shoot,sodium,soil,soil acidity,soil amendment,soil pollutant,soil pollution},
   note = {Chemicals/CAS: cadmium, 22537-48-0, 7440-43-9; magnesium ion, 22537-22-0; potassium, 7440-09-7; sodium, 7440-23-5; nitrogen, 7727-37-9; Acids; Cadmium; Fertilizers; Nitrogen; Soil; Soil Pollutants<br/><br/><br/><br/>Cited By :24<br/><br/><br/><br/>CODEN: CMSHA<br/><br/><br/><br/>Correspondence Address: Xiao, Y.; College of Agro-grassland Science, Nanjing Agricultural UniversityChina; email: xiaoyan@njau.edu.cn<br/><br/><br/><br/>Export Date: 15 October 2020<br/><br/><br/><br/>Funding details: Fundamental Research Funds for the Central Universities, KYZ201554<br/><br/><br/><br/>Funding text 1: This research was supported by the Fundamental Research Funds for the Central Universities ( KYZ201554 ).<br/><br/><br/><br/>References: Aggangan, N.S., Dell, B., Malajczuk, N., Effects of chromium and nickel on growth of the ectomycorrhizal fungus Pisolithus and formation of ectomycorrhizas on Eucalyptus urophylla S.T. Blake (1998) Geoderma, 84, pp. 15-27; <br/>Aghababaei, F., Raiesi, F., Fiosseinpur, A., The influence of earthworm and mycorrhizal co-inoculation on Cd speciation in a contaminated soil (2014) Soil Biol. Biochem., 78, pp. 21-29;<br/>Alloway, B.J., Heavy Metals in Soils (1995), Blackie Academic &amp; Professional London; Andrade, S.A.L., Gratão, P.L., Azevedo, R.A., Silveira, A.P.D., Schiavinato, M.A., Mazzafera, P., Biochemical and physiological changes in jack bean under mycorrhizal symbiosis growing in soil with increasing Cu concentrations (2010) Environ. Exp. Bot., 68, pp. 198-207;<br/>Ashrafi, E., Zahedi, M., Razmjoo, J., Co-inoculations of arbuscular mycorrhizal fungi and rhizobia under salinity in alfalfa (2014) Soil Sci. Plant Nutr., 60, pp. 619-629;<br/>Bauddh, K., Singh, R.P., Effects of organic and inorganic amendments on bio-accumulation and partitioning of Cd in Brassica juncea and Ricinus communis (2015) Ecol. Eng., 74, pp. 93-100;<br/>Bedini, S., Pellegrino, E., Avio, L., Pellegrini, S., Bazzoffi, P., Argese, E., Giovannetti, M., Change