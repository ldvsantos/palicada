@book{Morettin1999,
   abstract = {Tendo por base vasta bibliografia esclarecedora das diversas metodologias abordadas, Pedro Alberto Morettin torna acessível, em língua portuguesa, os avanços mais recentes na análise de séries temporais por meio de alguns sistemas ortonormais, notadamente o de funções de Walsh e o de ondaletas. Para que o leitor tenha a oportunidade de comparar conceitos e técnicas envolvidos, o autor inclui na obra, além de pesquisa recente, material já sedimentado, tal como a análise de Fourier de processos estacionários oferecendo, portanto, um quadro bastante amplo de análises. Dirigido a pesquisadores e a estudantes de pós-graduação na área de séries temporais, 'Ondas e Ondaletas' também serve às áreas nas quais a metodologia estatística tem aplicações, tais como economia, oceanografia, meteorologia, medicina, geofísica, física etc.},
