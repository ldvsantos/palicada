@article{Killean2020,
   abstract = {Este artigo baseia-se na experiência dos autores na introdução de um podcast jurídico conduzido por alunos em sua faculdade de direito em setembro de 2017 para explorar o potencial do podcasting criativo como uma ferramenta de conhecimento jurídico e desenvolvimento de habilidades. Baseando-se nas observações dos autores como coordenadores do podcast, bem como em uma pesquisa realizada entre os alunos participantes, considera o valor do podcasting criativo como um meio de aumentar o conhecimento jurídico, auxiliando no desenvolvimento de habilidades e promovendo um sentimento de colaboração e comunidade . O artigo também reflete sobre os desafios práticos associados à execução de um projeto desse tipo fora do currículo da escola, focalizando particularmente o desafio de encorajar a adesão dos alunos.},
   author = {Rachel Killean and Richard Summerville},
   doi = {10.1080/03069400.2019.1568675},
   issn = {0306-9400},
   issue = {1},
   journal = {The Law Teacher},
   month = {8},
   pages = {31-42},
   title = {Creative podcasting as a tool for legal knowledge and skills development},
   volume = {54},
   url = {https://www-tandfonline.ez20.periodicos.capes.gov.br/doi/full/10.1080/03069400.2019.1568675 https://www-tandfonline.ez20.periodicos.capes.gov.br/doi/pdf/10.1080/03069400.2019.1568675},
   year = {2020}
}
@article{Chikoye2014,
   abstract = {Herbicides applied to combat weeds and increase crop yields may also have undesired effects on beneficial soil microorganisms. Field studies were conducted in 2005 and 2006 in Zaria, Nigeria, to evaluate the response of weeds and soil microorganisms to imazaquin applied at 0.05, 0.10, 0.20 and 0.40kga.i./ha and pendimethalin applied at 1.0, 2.0, 4.0, and 8.0kga.i./ha in cowpea and soybean. Hoe-weeded and unweeded (no herbicide) plots were controls. Both herbicides significantly reduced weed biomass in both crops, when compared to the unweeded control, which had the highest weed biomass at all sampling dates. Treatments with 0.40kga.i./ha of imazaquin, 2.0 and 4.0kga.i./ha of pendimethalin, and the hoe-weeded control, had the highest cowpea grain yield. The unweeded control had the lowest grain yield which was comparable to that in all other herbicide treatments. All treatments except 4.0 and 8.0kga.i./ha of pendimethalin had higher soybean grain yield than the unweeded control. Soybean yield was lowest in the unweeded control, and treatments that received 4.0 and 8.0kga.i./ha of pendimethalin. All rates of imazaquin gave similar soybean grain yields that were 29-41% higher than that from pendimethalin. The hoe-weeded control had the highest yield, which was 79% more than that in the unweeded control. Higher rates of imazaquin and pendimethalin reduced nodulation, nitrogen fixation, and vesicular arbuscular mycorrhizal (VAM) fungi colonisation in both crops. VAM fungi species diversity and species richness in cowpea rhizosphere soil and species diversity in soybean rhizosphere soil were reduced relative to the controls due to application of both herbicides with the rates of 0.10, 0.20, and 0.40kga.i./ha of imazaquin and 8.0kga.i./ha of pendimethalin being significantly effective. © 2014 Elsevier Ltd.},
   author = {D Chikoye and R Abaidoo and L A Fontem},
   doi = {10.1016/j.cropro.2014.07.004},
   issn = {02612194 (ISSN)},
   journal = {Crop Protection},
   keywords = {Fungi,Glycine max,Kaduna [Nigeria],Nigeria,Vesicular arbuscular mycorrhizal fungi,Weed control,Zaria,arbuscular mycorrhiza,chemical control,fungus,herbicide,legume,nodulation,performance assessment,rhizosphere,soil microorganism,species diversity,weed,weed control,yield response},
