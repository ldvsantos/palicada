   year = {2019}
}
@inproceedings{Kealley202179,
   abstract = {Proving provenance of sustainably produced sugar is becoming increasingly important to customers and consumers. By using Smartcane BMP and blockchain technology, CANEGROWERS is seeking to provide provenance for sugar, increase market access and provide greater value to growers and the market. End-users, such as the food and beverage industry, are under increasing pressure to source sugar that meets sustainability criteria. A major driver of this is brand protection (social license to operate), which is influenced by the public consciousness of industry impacts. The result is that some end-users have committed to sourcing 100% of their sugar from sustainably produced sources by 2020. Smartcane BMP is the vehicle for Australian cane growers to demonstrate their environmental stewardship and improve productivity. Smartcane BMP can meet the sustainable sugar criteria required by end-users of sugar. Blockchain's main attribute is that transactions are recorded via blocks of data interlinked to form a chain of data in a centralized database that is visible to everyone. This creates trust and opportunities to share data within a value chain. The Queensland sugar-industry supply chain was mapped and showed how sugar could be digitally represented and traded across the supply chain. Supply-chain participants expressed interest in digitising their supply chain. There is value in developing a trusted, digital traceability platform that can be tokenised to transfer sustainability credentials through the supply chain. Value to industry can be created through: leveraging market access; demonstrating provenance; improved efficiencies through 'smart' contracts and digital records; and leveraging value from natural capital, ecosystem services and improved risk management. There were no impediments to pursuing a digital supply-chain solution such as blockchain for the Australian sugar industry. Industry buy-in, the commercial application of a digital solution and the creation of value back to the industry are undergoing further assessment. © 2021 42nd Australian Society of Sugar Cane Technologists Conference 2021, ASSCT 2021. All rights reserved.},
   author = {M J Kealley and G F Aley},
   booktitle = {42nd Australian Society of Sugar Cane Technologists Conference 2021, ASSCT 2021},
   keywords = {Beverages; Blockchain; Commerce; Copyrights; Data,Centralized data-base; Commercial applications; D,Sugar industry},
   note = {cited By 0; Conference of 42nd Australian Society of Sugar Cane Technologists Conference 2021, ASSCT 2021 ; Conference Date: 20 April 2021 Through 23 April 2021; Conference Code:169732},
   pages = {79-86},
   publisher = {Australian Society of Sugar Cane Technologists},
   title = {Can blockchain technology show provenance and increase value for Australian sugar?},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85109218511&partnerID=40&md5=f29f282d5544feeb2de9df1ad775d4a4},
   year = {2021}
}
@article{Civancik-Uslu2019,
   abstract = {One of the main drivers for companies to perform environmental improvements is economic benefit, either by obtaining a more valuable product or gaining new customers. Circular economy combines environmental improvements with these drivers to achieve higher and quicker benefits. This paper is a case study on packaging eco-design aligned with circular economy strategy along the production chain. Life cycle assessment (LCA) was used to identify the product life cycle stages where the application of eco-design strategies would be more efficient (in this case, raw materials production from virgin petrochemicals). To improve the environmental profile of this packaging, virgin petrochemicals were partially replaced by mineral fillers (calcium carbonate based) or/and post-consumer recycled plastics. Different technically compliant cosmetic tubes were produced by collaboration between a company producing the plastic granulates with mineral fillers and a company producing the cosmetic tubes and cradle-to-gate LCA were performed. The replacement of virgin petrochemicals by mineral fillers helped to reduce the environmental impacts by an average of 12% and the use of post-consumer recycled plastic further decreased emissions up to 29% for 6 out of the 9 evaluated impact categories. The option with better environmental performance was also the one with lower economic costs. According to the involved companies, LCA combined with ecodesign helped to achieve efficient environmental and economic savings. The findings are important for the plastic packaging sector because they tackle with prime concerns, like plastic debris, climate change and resource depletion. They are of main interest for industrial activities where brand positioning is a priority (i.e. cosmetics). © 2019 Elsevier B.V.},
   author = {D Civancik-Uslu and R Puig and S Voigt and D Walter and P Fullana-i-Palmer},
   doi = {10.1016/j.resconrec.2019.104475},
   issn = {09213449},
   journal = {Resources, Conservation and Recycling},
   keywords = {Article; climate change; controlled study; cost c,Calcium carbonate; Climate change; Cosmetics; Ecod,End of lives; Environmental improvements; Environ,Life cycle,calcium carbonate; cosmetic; filler; mineral; pet,environmental economics; life cycle analysis; pac},
   note = {cited By 13},
   publisher = {Elsevier B.V.},
   title = {Improving the production chain with LCA and eco-design: application to cosmetic packaging},
   volume = {151},
   url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85071861240&doi=10.1016%2Fj.resconrec.2019.104475&partnerID=40&md5=05d2ef6a13a1d119f849423b8d879fa2},
   year = {2019}
}
