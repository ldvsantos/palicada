@article{Silva2016b,
   abstract = {Este estudo teve como objetivo geral analisar experiências bem sucedidas do ensino de empreendedorismo na educação superior. A pesquisa utilizou o método qualitativo, classificando-se como descritiva, explicativa e bibliográfica. Dentre os resultados, foram apresentadas as principais etapas para o ensino de empreendedorismo, com ênfase no papel do professor como educador empreendedor para inspirar os alunos. Observou-se que instituições consideradas referência na formação empreendedora realizam atividades práticas e interacionistas (jogos, estudos de casos, seminários, palestras, workshops) envolvendo diferentes atores dentro e fora da universidade.},
   author = {Fabiana Ferreira Silva and Hérique Costa Ribeiro de Lima and Melissa Fernanda Belmiro Firmino Silva},
   issn = {1984-8463},
   issue = {2},
   journal = {Veredas Favip - Revista Eletrônica de Ciências},
   keywords = {Educação Superior. Empreendedorismo. Práticas Peda},
   month = {8},
   pages = {36-50},
   title = {EXPERIÊNCIAS EXITOSAS NO ENSINO UNIVERSITÁRIO DE EMPREENDEDORISMO},
   volume = {8},
   url = {http://www.veredas.favip.edu.br/ojs/index.php/veredas1/article/view/266 http://www.veredas.favip.edu.br/ojs/index.php/veredas1/article/download/266/327},
   year = {2016}
}
@article{Silva2019a,
   abstract = {Plants growing on soils poor in phosphorus (P) develop P-acquisition strategies such as symbiotic associations with arbuscular mycorrhizal fungi (AMF). In very poor soils, cluster roots, a non-symbiotic alternative strategy enables plants to extract P uptake by developing modified roots. The latter strategy is characteristic (if not a derived trait) of the Southern Hemisphere Proteaceae, which are thus non-mycorrhizal. The Proteaceae have been studied mainly in Australia, where they are very diverse, especially on very P-poor soils. We investigated the presence of cluster roots and/or AMF in the Proteaceae Roupala montana Aubl. from three areas of the Brazilian Cerrado. This is, a seasonal neotropical savanna on highly weathered soils characterised by high aluminium content, low pH, and very low available P. We discovered that R. montana forms arbuscular mycorrhiza and no cluster roots were observed. All the plantlets collected were mycorrhizal. We also evaluated the fertility of the soil (especially the P availability). It was found that R. montana grows in soils containing more than 220 mg kg−1 total P. Thus, they are, more fertile than in most of Australian soils and likely have sufficient available P to support plant nutrition by way of mycorrhizae. Further research should investigate whether other Brazilian, and more generally non-Australian, Proteaceae species can establish associations with AMF, and the link with soil P availability. Our findings have implications for the phylogenetic patterns of loss of symbiosis with AMF within the Proteaceae.},
   author = {Kelly Coutinho Detmann da Silva and Tiago de Souza Leite and Ricardo Rodrigues de Oliveira Neto and Marina Neves Delgado and Vitor Paiva Alcoforado Rebello and Aristéa Alves Azevedo and Maria Catarina Megumi Kasuya and Marc-André Selosse and Andréa Miyasaka de Almeida},
   doi = {10.1007/s13199-018-0581-0},
   issn = {1878-7665},
   issue = {2},
   journal = {Symbiosis},
   month = {10},
   pages = {115-122},
   title = {Arbuscular mycorrhizae and absence of cluster roots in the Brazilian Proteaceae Roupala montana Aubl.},
   volume = {77},
