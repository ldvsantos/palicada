@article{Mahawar2014,
   abstract = {An explorative trial was conducted during the rabi season to study the effect of phosphorus levels and biofertilizers on growth and yield attributes of pea (Pisum sativum L.) cv. Azad P-l with phosphorus, PSB and VAM. Results revealed that application of 75% RD of phosphorus and seed inoculation with PSB+VAM showed significant increase in the growth and yield attributes as compared to control and 50% RDP but statistically at par with 100% RDP, whereas green pod yield (kg/plot and q/ha) was found maximum at 100% RDP being statistically at par with 75% RDP. Number of nodules per plant (total and effective), days to flower initiation, number of pods per plant and number of seeds per pod remained at par with PSB inoculation. The combined application of 75% RDP with PSB+VAM as seed inoculation proved to be the most superior treatment combination in order to attain better growth and yield attributes.},
   author = {A K Mahawar and M R Choudhary and P Mahala and T V Yadav and P U Jjainiya and O P G Arhwal},
   issn = {09700153 (ISSN)},
   issue = {4},
   journal = {Annals of Biology},
