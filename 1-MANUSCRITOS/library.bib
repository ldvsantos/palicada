@article{Ding2021,
   abstract = {Recently, insects have aroused the interest of researchers as potential therapeutic resources against malignant diseases such as cancer. In this study, the effects of aqueous extracts from mysore thorn borer (MTB) (Anoplophora chinensis) and mealworm larvae (MWL) (Tenebrio molitor) against cancer cells were investigated. MWL aqueous extract showed higher antiproliferative effects against Caco-2 and HepG2 cells compared to MTB. The IC50 (48 hr) of MWL aqueous extract were 11.44 and 20 mg/ml for Caco-2 and HepG2 respectively. Flow cytometry analysis showed that MWL aqueous extract induced apoptosis in Caco-2 and HepG2 increasing from 2.06% to 74.34% and from 0.04% to 42.14% after 24 hr respectively. Caspase activity assay showed that apoptosis was mediated via death receptor pathway mediated by caspase-8 and -9 followed by the activation of caspase-3; caspase-3 may have induced DNA damage and cell death. These effects may be correlated to its free amino acids. The results of this study demonstrate the potentials of MWL in the development of natural anticancer therapeutics in the future. Practical applications Natural nutraceuticals from insects might be useful for the treatment and prevention of cancers such as colorectal and liver cancer. In recent years, edible insects have caught the attention of researchers, because of their potential as an alternative source of food and nutraceuticals. The results of our study showed that MWL extract might provide important anticancer compounds against colon and liver cancer. FU  - Student's Platform for Innovation and Entrepreneurship Training Program of Jiangsu; National Key R&D Program of China [2016YFD0401401, 2018YFD0401105]; Qinglan Project of Jiangsu Province of China; Jiangsu Key RD Plan [BE2016352, BE2016355]; Taizhou Technology Support Program [TN201912]; Priority Academic Program Development of Jiangsu Higher Education Institutions; Senior Talent Foundation of Jiangsu University [10JDG031]; Zhenjiang 1+1+N New Agricultural Technology Extension Project [ZJNJ(2019)04] FX  - Student's Platform for Innovation and Entrepreneurship Training Program of Jiangsu; National Key R&D Program of China, Grant/Award Number: 2016YFD0401401 and 2018YFD0401105; Qinglan Project of Jiangsu Province of China; Jiangsu Key R&D Plan, Grant/Award Number: BE2016352 and BE2016355; Taizhou Technology Support Program, Grant/Award Number: TN201912; Priority Academic Program Development of Jiangsu Higher Education Institutions; Senior Talent Foundation of Jiangsu University, Grant/Award Number: 10JDG031; Zhenjiang 1+1+N New Agricultural Technology Extension Project, Grant/Award Number: ZJNJ(2019)04 NR  - 31 PU  - WILEY PI  - HOBOKEN PA  - 111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
   author = {Q Z Ding and R A Wu and T T Shi and Y H Yu and Y L Yan and N Z Sun and A R Sheikh and L Luo and R H He and H L Ma},
   doi = {10.1111/jfbc.13778},
   issn = {0145-8884},
   issue = {7},
   journal = {JOURNAL OF FOOD BIOCHEMISTRY},
   keywords = {IDENTIFICATION,Mysore thorn borer,PEPTIDE,PRODUCTS,amino acids,apoptosis,edible insects,mealworm larvae,nutraceuticals},
   title = {Antiproliferative effects of mealworm larvae (Tenebrio molitor) aqueous extract on human colorectal adenocarcinoma (Caco-2) and hepatocellular carcinoma (HepG2) cancer cell lines},
   volume = {45},
   year = {2021}
}
@article{Lekka2020,
   abstract = {This article is part of a research project on the transformations that took place between 1850 and 1940 in the province of Thessaly, an extensive rural region of the Balkan Peninsula. It focuses on the changes in the economic, social and demographic levels, highlighting the interrelation of these changes in rural Thessaly from the promulgation of the Land Law (1858) under the Ottoman Tanzimat reforms to the annexation of Thessaly and the implementation of extensive land reforms in the 1920s by the Greek state. FU  - European Union (European Social Fund) through the Operational Program "Human Resources Development, Education and Lifelong Learning 2014-2020" [MIS 5004163] FX  - This research is co-financed by Greece and the European Union (European Social Fund) through the Operational Program "Human Resources Development, Education and Lifelong Learning 2014-2020" in the context of the project "Land Ownership, Entrepreneurship and Mentalities: Aspects of Thessaly's Transformation, 1850-1940" (MIS 5004163). Scientific supervisor of the research was Professor Emerita Christina Agriantoni. NR  - 42 PU  - NATL HELLENIC RES FOUNDATION PI  - ATHENS PA  - INST NEOHELLENIC RES, VAS CONSTANTINOU 48, ATHENS 116 35, GREECE},
   author = {F Lekka and D Moustani and G Gassias},
   issn = {1790-3572},
   journal = {HISTORICAL REVIEW-LA REVUE HISTORIQUE},
   keywords = {CENSUS,OTTOMAN,POPULATION},
   pages = {305-349},
   title = {SOCIAL AND ECONOMIC TRANSFORMATIONS IN RURAL THESSALY, 1850-1940},
   volume = {17},
   year = {2020}
}
@article{Jordon2020,
   abstract = {The environmental impacts of ruminant livestock farming need to be mitigated to improve the sustainability of food production. These negative impacts have been compounded by the increased spatial and cultural separation of farming and forestry across multiple temperate landscapes and contexts over recent centuries, and could at least in part be alleviated by re-integration of livestock and trees via agroforestry systems. Such integration also has the potential to benefit the productivity and economics of livestock farming. However, the delivery of hoped-for benefits is highly likely to depend on context, which will necessitate the consideration of local synergies and trade-offs. Evaluating the extensive body of research on the synergies and trade-offs between agroforestry and environmental, productivity and economic indicators would provide a resource to support context-specific decision making by land managers. Here, we present a systematic evidence map of academic and grey literature to address the question “What are the impacts of temperate agroforestry systems on sheep and cattle productivity, environmental impacts and farm economic viability?”. We followed good practice guidance from the Collaboration for Environmental Evidence to find and select relevant studies to create an interactive systematic map. We identified 289 relevant studies from 22 countries across temperate regions of North and South America, Australasia and Europe. Our preliminary synthesis indicates that there is an emerging evidence base to demonstrate that temperate agroforestry can deliver environmental and economic benefits compared with pasture without trees. However, to date measures of livestock productivity (particularly weather-related mortality and heat-and cold-stress) have received insufficient attention in many temperate agroforestry systems. The evidence base assembled through this work provides a freely accessible resource applicable across temperate regions to support context-specific decision making. © 2020 by the authors. Licensee MDPI, Basel, Switzerland.},
   author = {M W Jordon and K J Willis and W J Harvey and L Petrokofsky and G Petrokofsky},
   city = {Department of Zoology, University of Oxford, Mansfield Road, Oxford, OX1 3SZ, United Kingdom},
   doi = {10.3390/f11121321},
   issn = {19994907 (ISSN)},
   issue = {12},
   journal = {Forests},
   keywords = {Agriculture,Agroforestry system,Animals,Australasia,Cattle,Commerce,Decision Making,Decision making,Economic and social effects,Economic benefits,Economic indicators,Economic viability,Environmental impact,Europe,Food production,Forestry,Livestock farming,Maps,North America,Productivity,Ruminantia,Ruminants,Sheep,Silvopasture,South America,Sustainable development,Systematic map,Systematic maps,Systems,Temperate agroforestry,Temperate regions,agroforestry,cattle,entrepreneur,environmental impact,livestock farming,mapping method,productivity,regional economy,research work,sheep},
   note = {Export Date: 10 July 2021<br/><br/>Correspondence Address: Jordon, M.W.; Department of Zoology, Mansfield Road, United Kingdom; email: matthew.jordon@zoo.ox.ac.uk<br/><br/>Funding details: Biotechnology and Biological Sciences Research Council, BBSRC, BB/M011224/1<br/><br/>Funding text 1: Funding: This research was funded by Biotechnology and Biological Sciences Research Council (BBSRC), grant number BB/M011224/1.<br/><br/>References: Summary for Policymakers (2019) Climate Change and Land: an IPCC Special Report on Climate Change, Desertification, Land Degradation, Sustainable Land Management, Food Security, and Greenhouse Gas Fluxes in Terrestrial Ecosystems, , IPCC World Meteorological Organization: Geneva, Switzerland; <br/>(2019) Summary for Policymakers of the Global Assessment Report on Biodiversity and Ecosystem Services of the Intergovernmental Science-Policy Platform on Biodiversity and Ecosystem Services, p. 56. , IPBES. IPBES Secretariat: Bonn, Germany;<br/>Springmann, M., Clark, M., Mason-D’Croz, D., Wiebe, K., Bodirsky, B.L., Lassaletta, L., De Vries, W., Carlson, K.M., Options for keeping the food system within environmental limits (2018) Nature, 562, pp. 519-525;<br/>Godfray, H.C.J., Aveyard, P., Garnett, T., Hall, J., Key, T.J., Lorimer, J., Pierrehumbert, R.T., Jebb, S.A., Meat consumption, health, and the environment (2018) Science, 361, p. eaam5324;<br/>Gerber, P.J., Steinfeld, H., Henderson, B., Mottet, A., Opio, C., Dijkman, J., Falcucci, A., Tempio, G., (2013) Tackling Climate Change through Livestock—A Global Assessment of Emissions and Mitigation Opportunities, , Food and Agriculture Organisation of the United Nations (FAO): Rome, Italy;<br/>Tang, Y.S., Braban, C.F., Dragosits, U., Dore, A.J., Simmons, I., Van Dijk, N., Poskitt, J., Conolly, C., Drivers for spatial, temporal and long-term trends in atmospheric ammonia and ammonium in the UK (2018) Atmos. Chem. Phys, 18, pp. 705-733;<br/>Graves, A., Morris, J.G., Deeks, L., Rickson