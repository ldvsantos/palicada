@article{Shang2017,
   abstract = {This study analyzed the contributions of output, technological, and structural factors to industrial water use. Using Tianjin, a National Water-Saving City in China, as a case study, we adopted the refined Laspeyres and Logarithmic Mean Divisia Index models to decompose the driving forces of industrial water use changes. The decomposition results of both models show that output and technology have long-term, stable effects on industrial water use in Tianjin. Output stimulates water use, leading to an average annual growth of 7700 × 104 m3, while technology inhibits water use, with an average annual reduction of 7900 × 104 m3. However, the effects of structure on industrial water use are not stable. During the study period, the stimulation and inhibition of industrial water use alternated; however, stimulation was dominant after 2008, implying increased partiality of the industrial structure toward high water use. The results of the study contrasted the hypothesis that Tianjin's primary goal in restructuring local industries over the past decade has been the achievement of water use efficiency. Reduced water use may have resulted from Tianjin's development with targets other than water-savings. © 2016 Elsevier Inc.},
   author = {Y Shang and S Lu and L Shang and X Li and H Shi and W Li},
   doi = {10.1016/j.techfore.2016.11.010},
   issn = {00401625 (ISSN)},
   journal = {Technological Forecasting and Social Change},
   keywords = {Average annual growth,China,Decomposition method,Decomposition methods,Driving forces,Industrial structures,Industrial water,Industrial water use,Innovation,Technological forecasting,Tianjin,Water - savings,Water conservation,Water use efficiency,Water-saving,Water-saving cities,decomposition analysis,industrial technology,nocv1,water resource,water use efficiency},
