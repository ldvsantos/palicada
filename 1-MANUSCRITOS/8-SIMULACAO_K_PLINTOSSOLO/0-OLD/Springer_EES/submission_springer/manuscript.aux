\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Geotechnical validation of the bank-vulnerability factor ($\gamma $). (a)~Rankine factor of safety (FS) for vertical cuts as a function of normalized feature depth ($H/H_c$, ratio between actual depth and critical collapse height) under different relative pore pressures ($r_u$). (b)~Geotechnical contribution proxy ($\delta _{\mathrm  {geo}}$) and power fit $\gamma = 1 + 6.50 \times (H/H_c)^{4.51}$. Red dots indicate the six real erosion features (F1--F6), all with FS $>$\,1 under current conditions.}}{23}{figure.7}\protected@file@percent }
\newlabel{fig:taludes}{{7}{23}{Geotechnical validation of the bank-vulnerability factor ($\gamma $). (a)~Rankine factor of safety (FS) for vertical cuts as a function of normalized feature depth ($H/H_c$, ratio between actual depth and critical collapse height) under different relative pore pressures ($r_u$). (b)~Geotechnical contribution proxy ($\delta _{\mathrm {geo}}$) and power fit $\gamma = 1 + 6.50 \times (H/H_c)^{4.51}$. Red dots indicate the six real erosion features (F1--F6), all with FS $>$\,1 under current conditions}{figure.7}{}}
