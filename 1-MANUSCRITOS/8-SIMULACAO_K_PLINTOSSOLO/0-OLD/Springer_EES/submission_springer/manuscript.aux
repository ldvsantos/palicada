\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Sobol first-order ($S_1$) and total ($S_T$) sensitivity indices for four representative scenarios. The hydraulic exponent ($n_1$) dominates the amplification factor ($\delta $) variance for the Plinthosol and Acrisol, whereas the toxicity sigmoid transition rate ($k_2$) dominates for the Ferralsol, whose basic infiltration rate exceeds the reference threshold ($\mathrm  {BIR_{ref}} = 6$~cm/h), nullifying the hydraulic factor ($\alpha = 1$) and concentrating variance in the toxicity factor ($\beta $).}}{20}{figure.5}\protected@file@percent }
\newlabel{fig:sobol}{{5}{20}{Sobol first-order ($S_1$) and total ($S_T$) sensitivity indices for four representative scenarios. The hydraulic exponent ($n_1$) dominates the amplification factor ($\delta $) variance for the Plinthosol and Acrisol, whereas the toxicity sigmoid transition rate ($k_2$) dominates for the Ferralsol, whose basic infiltration rate exceeds the reference threshold ($\mathrm {BIR_{ref}} = 6$~cm/h), nullifying the hydraulic factor ($\alpha = 1$) and concentrating variance in the toxicity factor ($\beta $)}{figure.5}{}}
\citation{fredlund_rahardjo_1993}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Sobol second-order interaction matrix ($S_2$) for the intermediate Plinthosol scenario ($\mathrm  {BIR} = 1.53$~cm/h, aluminum saturation $= 84\%$, $H/H_c = 0.33$). Values of $S_2$ exceeding 0.05 indicate parametric interactions that field calibration must resolve simultaneously.}}{21}{figure.6}\protected@file@percent }
\newlabel{fig:interacoes}{{6}{21}{Sobol second-order interaction matrix ($S_2$) for the intermediate Plinthosol scenario ($\mathrm {BIR} = 1.53$~cm/h, aluminum saturation $= 84\%$, $H/H_c = 0.33$). Values of $S_2$ exceeding 0.05 indicate parametric interactions that field calibration must resolve simultaneously}{figure.6}{}}
