\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Median relative bias of estimated parameters as a function of the coefficient of variation (CV) of noise applied to synthetic data. The four-step sequential protocol followed by simultaneous Levenberg--Marquardt optimization recovers the hydraulic exponent ($n_1$), the maximum toxicity amplification ($\beta _{\max }$) and the sigmoid transition rate ($k_2$) with bias below 15\% for CV up to 30\%. The geotechnical parameters ($k_3$ and $n_3$) exhibit equifinality (bias $>$\,50\%) due to low individual sensitivity in the normalized depth interval $H/H_c = 0.12$--0.45.}}{17}{figure.3}\protected@file@percent }
\newlabel{fig:calibracao}{{3}{17}{Median relative bias of estimated parameters as a function of the coefficient of variation (CV) of noise applied to synthetic data. The four-step sequential protocol followed by simultaneous Levenberg--Marquardt optimization recovers the hydraulic exponent ($n_1$), the maximum toxicity amplification ($\beta _{\max }$) and the sigmoid transition rate ($k_2$) with bias below 15\% for CV up to 30\%. The geotechnical parameters ($k_3$ and $n_3$) exhibit equifinality (bias $>$\,50\%) due to low individual sensitivity in the normalized depth interval $H/H_c = 0.12$--0.45}{figure.3}{}}
\citation{cassol_et_al_2023}
\citation{auerswald_et_al_2014}
\citation{ostovari_et_al_2016}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Distribution of estimated parameters across 30 replicates per noise level. Red dashed lines indicate the true values. The hydraulic exponent ($n_1$), maximum toxicity amplification ($\beta _{\max }$) and sigmoid transition rate ($k_2$) remain centered on the true values, whereas the scale ($k_3$) and curvature ($n_3$) of the geotechnical factor show increasing dispersion with equifinality.}}{18}{figure.4}\protected@file@percent }
\newlabel{fig:boxplot}{{4}{18}{Distribution of estimated parameters across 30 replicates per noise level. Red dashed lines indicate the true values. The hydraulic exponent ($n_1$), maximum toxicity amplification ($\beta _{\max }$) and sigmoid transition rate ($k_2$) remain centered on the true values, whereas the scale ($k_3$) and curvature ($n_3$) of the geotechnical factor show increasing dispersion with equifinality}{figure.4}{}}
