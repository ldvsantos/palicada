\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Matriz de interação de Sobol de segunda ordem ($S_2$) para o cenário de Plintossolo intermediário ($\mathrm  {VIB} = 1{,}53$~cm/h, saturação por alumínio $= 84\%$, $H/H_c = 0{,}33$). Valores de $S_2$ superiores a 0,05 indicam interações paramétricas que a calibração em campo deve resolver simultaneamente.}}{15}{figure.6}\protected@file@percent }
