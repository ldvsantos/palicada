\citation{francois_et_al_2024}
\citation{alewell_et_al_2019}
\citation{bagarello_et_al_2012}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Distribuição dos parâmetros estimados ao longo de 30 réplicas por nível de ruído. Linhas tracejadas vermelhas indicam os valores verdadeiros. O expoente hidráulico ($n_1$), a amplificação máxima de toxicidade ($\beta _{\max }$) e a taxa de transição sigmoide ($k_2$) permanecem centrados nos valores verdadeiros, enquanto a escala ($k_3$) e a curvatura ($n_3$) do fator geotécnico apresentam dispersão crescente com equifinalidade.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:boxplot}{{4}{13}{Distribuição dos parâmetros estimados ao longo de 30 réplicas por nível de ruído. Linhas tracejadas vermelhas indicam os valores verdadeiros. O expoente hidráulico ($n_1$), a amplificação máxima de toxicidade ($\beta _{\max }$) e a taxa de transição sigmoide ($k_2$) permanecem centrados nos valores verdadeiros, enquanto a escala ($k_3$) e a curvatura ($n_3$) do fator geotécnico apresentam dispersão crescente com equifinalidade}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Hierarquia de sensibilidade (Teste~2)}{13}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Índices de sensibilidade de Sobol de primeira ordem ($S_1$) e totais ($S_T$) para quatro cenários representativos. O expoente hidráulico ($n_1$) domina a variância do fator de amplificação ($\delta $) para o Plintossolo e o Argissolo, enquanto a taxa de transição da sigmoide de toxicidade ($k_2$) domina para o Latossolo, cuja velocidade de infiltração básica excede o limiar de referência ($\mathrm  {VIB_{ref}} = 6$~cm/h), anulando o fator hidráulico ($\alpha = 1$) e concentrando a variância no fator de toxicidade ($\beta $).}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:sobol}{{5}{14}{Índices de sensibilidade de Sobol de primeira ordem ($S_1$) e totais ($S_T$) para quatro cenários representativos. O expoente hidráulico ($n_1$) domina a variância do fator de amplificação ($\delta $) para o Plintossolo e o Argissolo, enquanto a taxa de transição da sigmoide de toxicidade ($k_2$) domina para o Latossolo, cuja velocidade de infiltração básica excede o limiar de referência ($\mathrm {VIB_{ref}} = 6$~cm/h), anulando o fator hidráulico ($\alpha = 1$) e concentrando a variância no fator de toxicidade ($\beta $)}{figure.5}{}}
