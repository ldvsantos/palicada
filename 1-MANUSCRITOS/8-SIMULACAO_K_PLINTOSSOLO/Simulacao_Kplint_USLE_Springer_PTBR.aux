\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces (a)~Coeficiente de escoamento (CE) em função da intensidade máxima em 30 minutos ($I_{30}$) para os três perfis de solo simulados pelo modelo de infiltração de Green--Ampt (evento de 60 min). (b)~Razão entre o CE de cada solo e o CE do Latossolo comparada com o fator de amplificação hidráulica teórico ($\alpha $) da Eq.~\ref {eq:alpha} para três valores do expoente $n_1$. O Latossolo não gera escoamento superficial em nenhuma intensidade testada, consistente com $\alpha = 1$ para o controle negativo.}}{18}{figure.8}\protected@file@percent }
\newlabel{fig:infiltracao}{{8}{18}{(a)~Coeficiente de escoamento (CE) em função da intensidade máxima em 30 minutos ($I_{30}$) para os três perfis de solo simulados pelo modelo de infiltração de Green--Ampt (evento de 60 min). (b)~Razão entre o CE de cada solo e o CE do Latossolo comparada com o fator de amplificação hidráulica teórico ($\alpha $) da Eq.~\ref {eq:alpha} para três valores do expoente $n_1$. O Latossolo não gera escoamento superficial em nenhuma intensidade testada, consistente com $\alpha = 1$ para o controle negativo}{figure.8}{}}
\citation{horton_1933}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Hidrograma de escoamento superficial sob intensidade máxima em 30 minutos ($I_{30}$) de 60~mm/h para os três perfis de solo. O Plintossolo (condutividade hidráulica saturada efetiva de 0,50~cm/h) atinge regime permanente em menos de 10~minutos, enquanto o Latossolo (8,0~cm/h) não gera escoamento em nenhum momento durante o evento de 60 minutos.}}{19}{figure.9}\protected@file@percent }
\newlabel{fig:hidrograma}{{9}{19}{Hidrograma de escoamento superficial sob intensidade máxima em 30 minutos ($I_{30}$) de 60~mm/h para os três perfis de solo. O Plintossolo (condutividade hidráulica saturada efetiva de 0,50~cm/h) atinge regime permanente em menos de 10~minutos, enquanto o Latossolo (8,0~cm/h) não gera escoamento em nenhum momento durante o evento de 60 minutos}{figure.9}{}}
