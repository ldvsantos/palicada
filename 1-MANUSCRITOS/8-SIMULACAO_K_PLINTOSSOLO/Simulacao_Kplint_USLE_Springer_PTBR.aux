\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Hidrograma de escoamento superficial sob intensidade máxima em 30 minutos ($I_{30}$) de 60~mm/h para os três perfis de solo. O Plintossolo (condutividade hidráulica saturada efetiva de 0,50~cm/h) atinge regime permanente em menos de 10~minutos, enquanto o Latossolo (8,0~cm/h) não gera escoamento em nenhum momento durante o evento de 60 minutos.}}{19}{figure.10}\protected@file@percent }
