\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Viés relativo mediano dos parâmetros estimados em função do coeficiente de variação (CV) do ruído aplicado aos dados sintéticos. O protocolo sequencial em quatro etapas seguido de otimização simultânea por Levenberg--Marquardt recupera o expoente hidráulico ($n_1$), a amplificação máxima de toxicidade ($\beta _{\max }$) e a taxa de transição sigmoide ($k_2$) com viés inferior a 15\% para CV de até 30\%. Os parâmetros geotécnicos ($k_3$ e $n_3$) apresentam equifinalidade (viés $>$\,50\%) devido à baixa sensibilidade individual no intervalo de profundidade normalizada $H/H_c = 0{,}12$--0,45.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:calibracao}{{3}{12}{Viés relativo mediano dos parâmetros estimados em função do coeficiente de variação (CV) do ruído aplicado aos dados sintéticos. O protocolo sequencial em quatro etapas seguido de otimização simultânea por Levenberg--Marquardt recupera o expoente hidráulico ($n_1$), a amplificação máxima de toxicidade ($\beta _{\max }$) e a taxa de transição sigmoide ($k_2$) com viés inferior a 15\% para CV de até 30\%. Os parâmetros geotécnicos ($k_3$ e $n_3$) apresentam equifinalidade (viés $>$\,50\%) devido à baixa sensibilidade individual no intervalo de profundidade normalizada $H/H_c = 0{,}12$--0,45}{figure.3}{}}
\citation{cassol_et_al_2023}
\citation{auerswald_et_al_2014}
\citation{ostovari_et_al_2016}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Distribuição dos parâmetros estimados ao longo de 30 réplicas por nível de ruído. Linhas tracejadas vermelhas indicam os valores verdadeiros. O expoente hidráulico ($n_1$), a amplificação máxima de toxicidade ($\beta _{\max }$) e a taxa de transição sigmoide ($k_2$) permanecem centrados nos valores verdadeiros, enquanto a escala ($k_3$) e a curvatura ($n_3$) do fator geotécnico apresentam dispersão crescente com equifinalidade.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:boxplot}{{4}{13}{Distribuição dos parâmetros estimados ao longo de 30 réplicas por nível de ruído. Linhas tracejadas vermelhas indicam os valores verdadeiros. O expoente hidráulico ($n_1$), a amplificação máxima de toxicidade ($\beta _{\max }$) e a taxa de transição sigmoide ($k_2$) permanecem centrados nos valores verdadeiros, enquanto a escala ($k_3$) e a curvatura ($n_3$) do fator geotécnico apresentam dispersão crescente com equifinalidade}{figure.4}{}}
