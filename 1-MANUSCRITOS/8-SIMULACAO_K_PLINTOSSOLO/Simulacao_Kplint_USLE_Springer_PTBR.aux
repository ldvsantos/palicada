\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Índices de sensibilidade de Sobol de primeira ordem ($S_1$) e totais ($S_T$) para quatro cenários representativos. O expoente hidráulico ($n_1$) domina a variância do fator de amplificação ($\delta $) para o Plintossolo e o Argissolo, enquanto a taxa de transição da sigmoide de toxicidade ($k_2$) domina para o Latossolo, cuja velocidade de infiltração básica excede o limiar de referência ($\mathrm  {VIB_{ref}} = 6$~cm/h), anulando o fator hidráulico ($\alpha = 1$) e concentrando a variância no fator de toxicidade ($\beta $).}}{15}{figure.6}\protected@file@percent }
\newlabel{fig:sobol}{{6}{15}{Índices de sensibilidade de Sobol de primeira ordem ($S_1$) e totais ($S_T$) para quatro cenários representativos. O expoente hidráulico ($n_1$) domina a variância do fator de amplificação ($\delta $) para o Plintossolo e o Argissolo, enquanto a taxa de transição da sigmoide de toxicidade ($k_2$) domina para o Latossolo, cuja velocidade de infiltração básica excede o limiar de referência ($\mathrm {VIB_{ref}} = 6$~cm/h), anulando o fator hidráulico ($\alpha = 1$) e concentrando a variância no fator de toxicidade ($\beta $)}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Matriz de interação de Sobol de segunda ordem ($S_2$) para o cenário de Plintossolo intermediário ($\mathrm  {VIB} = 1{,}53$~cm/h, saturação por alumínio $= 84\%$, $H/H_c = 0{,}33$). Valores de $S_2$ superiores a 0,05 indicam interações paramétricas que a calibração em campo deve resolver simultaneamente.}}{16}{figure.7}\protected@file@percent }
\newlabel{fig:interacoes}{{7}{16}{Matriz de interação de Sobol de segunda ordem ($S_2$) para o cenário de Plintossolo intermediário ($\mathrm {VIB} = 1{,}53$~cm/h, saturação por alumínio $= 84\%$, $H/H_c = 0{,}33$). Valores de $S_2$ superiores a 0,05 indicam interações paramétricas que a calibração em campo deve resolver simultaneamente}{figure.7}{}}
